#!/usr/bin/env python3
"""Lock the session with swaywardlock, falling back to swaylock.

swaywardlock draws everything itself (wallpaper, blur, clock, ring) from
`~/.config/swaywardlock/config.kdl`, so this wrapper only picks the locker:

  1. A locker is already running        -> exit 0 (idempotent: swayidle's
                                           timeout and before-sleep both call us)
  2. `swaywardlock -f` locks             -> exit 0 once the session is locked
  3. swaywardlock missing or nonzero    -> `swaylock -f` with a solid colour
     (config error, missing PAM file,     (the recovery path; locking must
     no ext-session-lock, refused lock)   always succeed)

Always daemonized: `-f` returns 0 only once the session is locked, which is
what `swayidle -w before-sleep` needs to hold back suspend. Anything that
fails after that happens in the forked child; the compositor keeps the
session locked, and running `lock-screen` again replaces the dead lock.

Extra arguments pass through to swaywardlock. `--daemonize`/`-f` are
accepted for old callers and ignored, since -f is always on.
"""

from __future__ import annotations

import argparse
import os
import shlex
import shutil
import subprocess
import sys
from pathlib import Path

PRIMARY = "swaywardlock"
FALLBACK = "swaylock"
# THEME BEGIN: lock-screen-fallback-color
FALLBACK_COLOR = "1e1e2e"  # Catppuccin Mocha base
# THEME END: lock-screen-fallback-color


def parse_args(argv: list[str]) -> argparse.Namespace:
    p = argparse.ArgumentParser(
        prog="lock-screen",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument(
        "--print-command",
        action="store_true",
        help="print the commands that would run, then exit (dry-run)",
    )
    p.add_argument("-f", "--daemonize", action="store_true", help=argparse.SUPPRESS)
    args, passthrough = p.parse_known_args(argv)
    if passthrough and passthrough[0] == "--":
        passthrough = passthrough[1:]
    args.passthrough = passthrough
    return args


def locker_running(proc: Path = Path("/proc")) -> bool:
    """True if a real (not --preview/validate) locker process exists.

    Replaces `pidof swaylock`: a bare name match would count a
    `swaywardlock --preview` window and skip the idle lock.
    """
    me = os.getuid()
    for entry in proc.iterdir():
        if not entry.name.isdigit():
            continue
        try:
            if entry.stat().st_uid != me:
                continue
            argv = (entry / "cmdline").read_bytes().split(b"\0")
        except OSError:
            continue
        name = os.path.basename(argv[0].decode(errors="replace"))
        rest = {a.decode(errors="replace") for a in argv[1:]}
        if name == FALLBACK:
            return True
        if name == PRIMARY and not rest & {"--preview", "validate", "completions"}:
            return True
    return False


def commands(passthrough: list[str]) -> tuple[list[str], list[str]]:
    primary = [PRIMARY, "-f", *passthrough]
    fallback = [FALLBACK, "-f", "--color", FALLBACK_COLOR]
    return primary, fallback


def run(cmd: list[str]) -> int:
    try:
        return subprocess.run(cmd, check=False).returncode
    except OSError as e:
        print(f"lock-screen: failed to run {cmd[0]}: {e}", file=sys.stderr)
        return 1


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    primary, fallback = commands(args.passthrough)
    if args.print_command:
        print(shlex.join(primary))
        print(f"# if that fails or is missing: {shlex.join(fallback)}")
        return 0
    if locker_running():
        return 0

    if shutil.which(PRIMARY) is not None:
        rc = run(primary)
        if rc == 0:
            return 0
        print(f"lock-screen: {PRIMARY} exited {rc}; using {FALLBACK}", file=sys.stderr)
    else:
        print(f"lock-screen: {PRIMARY} not on PATH; using {FALLBACK}", file=sys.stderr)

    if shutil.which(FALLBACK) is None:
        print(f"lock-screen: {FALLBACK} not on PATH either", file=sys.stderr)
        return 127
    return run(fallback)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
