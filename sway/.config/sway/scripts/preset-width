#!/usr/bin/env python3
"""Cycle preset sizes for the focused window.

Tiled:    width through 33 → 50 → 67 ppt.
Floating: center50 → center90 → tallCenter, mirroring hammerspoon's Hyper+R
          on macOS minus full (which tiling already covers).

The cycle index lives in $XDG_STATE_HOME/sway/, tracked separately per layer.
"""

import json
import os
import subprocess
import sys
from pathlib import Path

# ── presets ──────────────────────────────────────────────────────────────────
# Tiled: percentage-point widths (sway ppt).
TILED_PRESETS = [33, 50, 67]

# Floating: (x, y, width, height) as fractions of the workspace rect.
# Mirrors hammerspoon's Hyper+R cycle: full → center90 → tallCenter.
FLOAT_PRESETS = [
    (0.25, 0.2, 0.5, 0.6),  # center50
    (0.05, 0.05, 0.9, 0.9),  # center90
    (0.15, 0.0, 0.7, 1.0),  # tallCenter
]


# ── sway tree ────────────────────────────────────────────────────────────────
# swaymsg + get_tree are copied verbatim in window-back-and-forth, and ported
# from fuzzel's _common.py (``_get_sway_tree``, the hardened original).
# Copied on purpose: 17 stable lines across two scripts in one package is
# under the bar docs/DECISIONS.md sets in "A shared pylib/ helper module", and
# the walks below them differ anyway. Keep the three comparable.
def swaymsg(*args: str) -> str:
    return subprocess.check_output(["swaymsg", *args], text=True)


def get_tree():
    """Run ``swaymsg -t get_tree`` and return the parsed root, or ``None``."""
    try:
        raw = swaymsg("-t", "get_tree")
    except (OSError, subprocess.CalledProcessError):
        return None
    try:
        tree = json.loads(raw)
    except json.JSONDecodeError:
        return None
    return tree if isinstance(tree, dict) else None


def get_focused():
    """Return (output_rect, workspace_rect, focused_container) from the tree."""
    tree = get_tree()
    if tree is None:
        return None

    def walk(node, output=None, workspace=None):
        # Node names can be absent or null (the root has "name": null), so
        # coerce before prefix tests rather than indexing blindly.
        name = node.get("name") or ""
        if node.get("type") == "output" and not name.startswith("__"):
            output = node
        if node.get("type") == "workspace" and not name.startswith("__"):
            workspace = node
        if node.get("focused"):
            return output, workspace, node
        for child in (*node.get("nodes", []), *node.get("floating_nodes", [])):
            if not isinstance(child, dict):
                continue
            result = walk(child, output, workspace)
            if result:
                return result
        return None

    return walk(tree)


def is_floating(container: dict) -> bool:
    # Workspace nodes carry "floating": null, so the dict.get default never
    # fires — coerce to "" explicitly.
    floating = container.get("floating") or ""
    return floating.startswith("user_") or container.get("type") == "floating_con"


def focused_window_and_workspace() -> tuple[dict, dict] | None:
    """Return (workspace, focused window), or None when there's nothing to resize.

    Two guards: an empty workspace (sway marks the *workspace node* focused,
    which is no window) and a missing workspace rect (the window is in the
    scratchpad). None means exit quietly -- a keypress with nothing to act on
    isn't an error.
    """
    result = get_focused()
    if not result:
        return None
    _output, workspace, container = result
    if container.get("type") == "workspace" or not workspace:
        return None
    return workspace, container


# ── state ────────────────────────────────────────────────────────────────────
def state_dir() -> str:
    d = os.path.join(
        os.environ.get("XDG_STATE_HOME") or str(Path.home() / ".local/state"),
        "sway",
    )
    os.makedirs(d, exist_ok=True)
    return d


def read_index(path: str) -> int:
    try:
        return int(open(path).read().strip())
    except (FileNotFoundError, ValueError):
        return 0


def write_index(path: str, idx: int) -> None:
    with open(path, "w") as f:
        f.write(f"{idx}\n")


# ── main ─────────────────────────────────────────────────────────────────────
def main() -> None:
    result = focused_window_and_workspace()
    if not result:
        sys.exit(0)
    workspace, container = result

    if is_floating(container):
        ws = workspace["rect"]
        state_file = os.path.join(state_dir(), "preset-float")
        idx = read_index(state_file)
        next_idx = (idx + 1) % len(FLOAT_PRESETS)
        write_index(state_file, next_idx)

        fx, fy, fw, fh = FLOAT_PRESETS[next_idx]
        x = int(ws["x"] + ws["width"] * fx)
        y = int(ws["y"] + ws["height"] * fy)
        w = int(ws["width"] * fw)
        h = int(ws["height"] * fh)

        swaymsg(f"resize set {w} px {h} px, move absolute position {x} px {y} px")
    else:
        state_file = os.path.join(state_dir(), "preset-width")
        idx = read_index(state_file)
        next_idx = (idx + 1) % len(TILED_PRESETS)
        write_index(state_file, next_idx)

        ppt = TILED_PRESETS[next_idx]
        swaymsg(f"resize set width {ppt} ppt")


if __name__ == "__main__":
    main()
