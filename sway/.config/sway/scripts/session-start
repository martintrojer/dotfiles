#!/usr/bin/env bash
set -euo pipefail

session_env=(
  DISPLAY
  WAYLAND_DISPLAY
  XDG_CURRENT_DESKTOP
  XDG_SESSION_TYPE
  SWAYSOCK
)

systemctl --user import-environment "${session_env[@]}" || true

if command -v dbus-update-activation-environment >/dev/null 2>&1; then
  dbus-update-activation-environment --systemd "${session_env[@]}" >/dev/null 2>&1 || true
fi

systemctl --user start sway-session.target

# Re-apply output profiles. The sway config deliberately declares no `output`
# lines (kanshi owns them), which means `swaymsg reload` resets every output to
# its defaults -- scale 1.0 on the 4K panel. Sway runs this script via
# exec_always, so reloading lands here; ask kanshi to re-assert its profile.
# Without this a reload silently halves the apparent UI size.
if command -v kanshictl >/dev/null 2>&1; then
  kanshictl reload >/dev/null 2>&1 || true
fi
