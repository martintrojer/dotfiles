[Unit]
Description=LM Studio Local Server (Flatpak, headless)
After=sway-session.target
PartOf=sway-session.target
BindsTo=sway-session.target

[Service]
Type=notify
NotifyAccess=main
ExecStart=%h/.local/bin/lmstudio-server
Restart=on-failure
RestartSec=5s
TimeoutStartSec=150s
TimeoutStopSec=15s

[Install]
WantedBy=sway-session.target
