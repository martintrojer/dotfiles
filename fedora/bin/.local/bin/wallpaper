#!/usr/bin/env python3
"""Manage sway wallpapers, display render cache, and fzf previews."""

from __future__ import annotations

import argparse
import base64
import contextlib
import hashlib
import json
import os
import shutil
import string
import subprocess
import sys
import tempfile
from datetime import datetime
from pathlib import Path
from typing import NoReturn
from urllib.parse import urlparse

# ----------------------------------------------------------------------
# Paths (single source of truth; no global-shadowing footguns)
# ----------------------------------------------------------------------

XDG_DATA_HOME = Path(
    os.environ.get("XDG_DATA_HOME") or Path.home() / ".local" / "share"
)
XDG_CACHE_HOME = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache")

TARGET_DIR = XDG_DATA_HOME / "wallpapers"
ARCHIVE_DIR = TARGET_DIR / "archive"
CURRENT_LINK = TARGET_DIR / "current"
CACHE_DIR = XDG_CACHE_HOME / "wallpaper"


# ----------------------------------------------------------------------
# Display render recipe
# ----------------------------------------------------------------------

# Bump only the version for the artifact whose recipe changed.
DISPLAY_RENDER_VERSION = 1
PREVIEW_RENDER_VERSION = 19
DISPLAY_FALLBACK_WIDTH = 2560
DISPLAY_FALLBACK_HEIGHT = 1440
DISPLAY_FALLBACK_COLOR = "#08090c"
DISPLAY_CROP_LIMIT = 0.10
DISPLAY_BLUR_SIGMA = 20
DISPLAY_RENDER_TIMEOUT = 90
# Preview thumbnails are capped at this many pixels on the long edge. The
# terminal scales them into the fzf pane, so one size serves every pane.
PREVIEW_MAX_EDGE = 1280


# ----------------------------------------------------------------------
# Helpers
# ----------------------------------------------------------------------

_STEM_KEEP = set(string.ascii_letters + string.digits + "._-")


def die(msg: str, code: int = 1) -> NoReturn:
    print(f"wallpaper: {msg}", file=sys.stderr)
    raise SystemExit(code)


def sanitize_stem(name: str) -> tuple[str, str]:
    """Split a basename into (sanitized_stem, ext_with_dot).

    Keep ASCII letters, digits, dot, underscore, hyphen; replace everything
    else with '-' and squash repeats; strip leading/trailing '-'; fall back
    to 'wallpaper' if the result is empty. A leading dot makes the whole
    thing a stem with no extension.
    """
    if "." in name and not name.startswith("."):
        stem, _, ext = name.rpartition(".")
        ext = "." + ext
    else:
        stem, ext = name, ""

    out: list[str] = []
    last_dash = False
    for ch in stem:
        if ch in _STEM_KEEP:
            out.append(ch)
            last_dash = False
        elif not last_dash:
            out.append("-")
            last_dash = True
    sanitized = "".join(out).strip("-") or "wallpaper"
    return sanitized, ext


def basename_from_url_or_path(src: str) -> str:
    """Strip URL query string before taking basename, leave file paths alone."""
    parsed = urlparse(src)
    if parsed.scheme in ("http", "https", "ftp", "file"):
        return Path(parsed.path).name or "wallpaper"
    return Path(src).name


def make_archive_path(stem: str, ext: str, timestamp: str | None = None) -> Path:
    """Allocate a unique filename under ARCHIVE_DIR using mkstemp.

    Format: <YYYYMMDD-HHMMSS>-<stem>.<6 random chars><ext>
    Matches the bash mktemp template format. mkstemp guarantees uniqueness
    even under racing callers and creates the file with mode 0600.
    """
    ts = timestamp or datetime.now().strftime("%Y%m%d-%H%M%S")
    fd, path = tempfile.mkstemp(
        prefix=f"{ts}-{stem}.",
        suffix=ext,
        dir=str(ARCHIVE_DIR),
    )
    os.close(fd)
    return Path(path)


def ensure_dirs() -> None:
    ARCHIVE_DIR.mkdir(parents=True, exist_ok=True)


def require_systemctl() -> None:
    if shutil.which("systemctl") is None:
        die("systemctl is unavailable")


def restart_swaybg() -> None:
    require_systemctl()
    if (
        subprocess.run(["systemctl", "--user", "restart", "swaybg.service"]).returncode
        != 0
    ):
        die("failed to restart swaybg.service")


# ----------------------------------------------------------------------
# Cache: display render and preview thumbnail
#
# Files live at $XDG_CACHE_HOME/wallpaper/<sha>.<kind>-vN[-WxH].*.
# The shared key identifies the source; each artifact carries its own recipe
# version so changing one recipe does not invalidate unrelated caches.
# Entries are removed when the source archive entry is deleted; there
# is no time-based pruning, so a wallpaper kept around for years keeps
# its warm cache for years.
#
# swaybg and swaywardlock both show the display render (`wallpaper
# current`); swaywardlock blurs it itself. Preview thumbnails are rendered
# on demand by `wallpaper preview` (used by the fzf picker).
# ----------------------------------------------------------------------


def _cache_key(wallpaper: Path) -> str | None:
    """Stable key derived from canonical path and mtime."""
    try:
        source = wallpaper.resolve(strict=True)
        mtime = source.stat().st_mtime_ns
    except OSError:
        return None
    raw = f"{source}\0{mtime}".encode()
    return hashlib.sha1(raw).hexdigest()[:16]


def _display_cache_path(wallpaper: Path, width: int, height: int) -> Path | None:
    """Cache path for a display-sized wallpaper render."""
    key = _cache_key(wallpaper)
    if key is None:
        return None
    return CACHE_DIR / (f"{key}.display-v{DISPLAY_RENDER_VERSION}-{width}x{height}.png")


def _preview_cache_path(wallpaper: Path) -> Path | None:
    """Cache path for a wallpaper's preview thumbnail.

    Shares the wallpaper's `_cache_key` with other renders so
    `cmd__delete_archive` can glob `<key>.*` and clean every artifact
    derived from one archive entry in a single pass. Returns None if
    the wallpaper's mtime can't be stat'd.
    """
    key = _cache_key(wallpaper)
    if key is None:
        return None
    return CACHE_DIR / f"{key}.preview-v{PREVIEW_RENDER_VERSION}.png"


def _file_identity(path: Path) -> tuple[int, int, int, int] | None:
    """Return the source identity that must remain stable during render.

    Preview renders are intentionally asynchronous under fzf: moving the
    cursor can kill/restart preview commands while ImageMagick is still
    doing work. Cache writes therefore re-check this identity after the
    render and only publish bytes if the path still names the same file
    content we keyed at the start. That prevents a late render from
    populating a stale/wrong `.preview-*` cache path after an archive entry
    is replaced, deleted, or otherwise races with the preview process.
    """
    try:
        st = path.stat()
    except OSError:
        return None
    return (st.st_dev, st.st_ino, st.st_size, st.st_mtime_ns)


def _render_preview(source: Path, path: Path) -> bool:
    """Render a preview thumbnail to `path` via temp + rename, so
    concurrent preview processes never see a torn file. The rename only
    happens if `source` is still the file the render started from.
    """
    identity = _file_identity(source)
    try:
        CACHE_DIR.mkdir(parents=True, exist_ok=True)
        fd, tmp_str = tempfile.mkstemp(
            dir=str(CACHE_DIR), prefix=".preview.", suffix=".png"
        )
        os.close(fd)
    except OSError:
        return False
    tmp_path = Path(tmp_str)
    edge = PREVIEW_MAX_EDGE
    result = subprocess.run(
        ["magick", f"{source}[0]", "-resize", f"{edge}x{edge}>", f"png:{tmp_path}"],
        capture_output=True,
    )
    try:
        if result.returncode != 0 or identity != _file_identity(source):
            raise OSError("stale or failed render")
        os.replace(tmp_path, path)
    except OSError:
        with contextlib.suppress(OSError):
            tmp_path.unlink()
        return False
    return True


def _crop_loss(
    source_width: int, source_height: int, target_width: int, target_height: int
) -> float:
    """Fraction lost from the cropped source dimension when filling a target."""
    source_ratio = source_width / source_height
    target_ratio = target_width / target_height
    if source_ratio > target_ratio:
        return 1 - target_ratio / source_ratio
    return 1 - source_ratio / target_ratio


def _active_output_size() -> tuple[int, int]:
    """Return the focused output's physical mode, or a stable fallback."""
    try:
        result = subprocess.run(
            ["swaymsg", "-t", "get_outputs", "-r"],
            capture_output=True,
            text=True,
            check=False,
        )
        outputs = json.loads(result.stdout) if result.returncode == 0 else []
        active = [output for output in outputs if output.get("active")]
        output = next(
            (candidate for candidate in active if candidate.get("focused")),
            active[0] if active else None,
        )
        mode = output.get("current_mode") if output else None
        width = mode.get("width") if mode else None
        height = mode.get("height") if mode else None
        if (
            isinstance(width, int)
            and width > 0
            and isinstance(height, int)
            and height > 0
        ):
            return width, height
    except (OSError, json.JSONDecodeError, TypeError):
        pass
    return DISPLAY_FALLBACK_WIDTH, DISPLAY_FALLBACK_HEIGHT


def _image_geometry(src: Path) -> tuple[int, int, bool] | None:
    """Return visible size and whether transparent outer padding needs trimming."""
    try:
        result = subprocess.run(
            ["magick", "identify", "-format", "%w %h %[opaque] %@", f"{src}[0]"],
            capture_output=True,
            text=True,
            timeout=DISPLAY_RENDER_TIMEOUT,
            check=False,
        )
        width_text, height_text, opaque, bounds = result.stdout.split()
        trim = opaque == "False"
        if trim:
            width_text, height_text = bounds.split("+", 1)[0].split("x")
        width, height = int(width_text), int(height_text)
        if result.returncode == 0 and width > 0 and height > 0:
            return width, height, trim
    except (OSError, subprocess.SubprocessError, ValueError):
        pass
    return None


def _summarize_stderr(stderr: bytes) -> str:
    text = stderr.decode(errors="ignore").strip()
    if not text:
        return "no error output"
    return " ".join(text.split())[:240]


def _run_image_render(
    command: list[str], dst: Path, timeout: int
) -> tuple[bool, str | None]:
    """Run ImageMagick into an atomic cache file."""
    if not shutil.which("magick"):
        return False, "magick not found on PATH"
    try:
        dst.parent.mkdir(parents=True, exist_ok=True)
        fd, tmp_str = tempfile.mkstemp(
            dir=str(dst.parent), prefix=f".{dst.name}.", suffix=".tmp.png"
        )
        os.close(fd)
    except OSError as exc:
        return False, f"failed to create render file under {dst.parent}: {exc}"
    tmp_path = Path(tmp_str)

    try:
        result = subprocess.run(
            [*command, str(tmp_path)],
            capture_output=True,
            timeout=timeout,
            check=False,
        )
        if result.returncode != 0:
            return (
                False,
                f"ImageMagick exited {result.returncode}: "
                f"{_summarize_stderr(result.stderr)}",
            )
        if not tmp_path.is_file() or tmp_path.stat().st_size <= 0:
            return False, "renderer produced no output file"
        os.replace(tmp_path, dst)
        return True, None
    except subprocess.TimeoutExpired:
        return False, f"timed out rendering image after {timeout}s"
    except (OSError, subprocess.SubprocessError) as exc:
        return False, f"failed to render image: {exc}"
    finally:
        with contextlib.suppress(OSError):
            tmp_path.unlink()


def _build_display_image(
    src: Path, dst: Path, width: int, height: int
) -> tuple[bool, str | None]:
    """Render an adaptive, display-sized wallpaper to dst."""
    geometry = _image_geometry(src)
    if geometry is None:
        return False, "could not read wallpaper dimensions"
    source_width, source_height, trim = geometry
    source = [f"{src}[0]", "-auto-orient"]
    if trim:
        source.extend(["-trim", "+repage"])

    common = ["-strip", "-define", "png:compression-level=1"]
    if _crop_loss(source_width, source_height, width, height) <= DISPLAY_CROP_LIMIT:
        command = [
            "magick",
            *source,
            "-background",
            DISPLAY_FALLBACK_COLOR,
            "-alpha",
            "remove",
            "-resize",
            f"{width}x{height}^",
            "-gravity",
            "center",
            "-extent",
            f"{width}x{height}",
            *common,
        ]
    else:
        command = [
            "magick",
            "(",
            *source,
            "-background",
            DISPLAY_FALLBACK_COLOR,
            "-alpha",
            "remove",
            "-resize",
            f"{width}x{height}^",
            "-gravity",
            "center",
            "-extent",
            f"{width}x{height}",
            "-blur",
            f"0x{DISPLAY_BLUR_SIGMA}",
            "-brightness-contrast",
            "-20x0",
            ")",
            "(",
            *source,
            "-resize",
            f"{width}x{height}",
            ")",
            "-gravity",
            "center",
            "-compose",
            "over",
            "-composite",
            *common,
        ]

    return _run_image_render(command, dst, DISPLAY_RENDER_TIMEOUT)


def build_display_cache(
    wallpaper: Path,
    width: int,
    height: int,
    *,
    force: bool = False,
    verbose: bool = False,
) -> tuple[Path | None, str | None]:
    """Render the display image for wallpaper if missing or forced."""
    image_path = _display_cache_path(wallpaper, width, height)
    if image_path is None:
        return None, "wallpaper path could not be stat'd"
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    cache_hit = not force and image_path.is_file() and image_path.stat().st_size > 0
    if verbose and not cache_hit:
        print("Generating display image... ", end="", flush=True)
    if cache_hit:
        return image_path, None
    ok, error = _build_display_image(wallpaper, image_path, width, height)
    if verbose:
        print("done" if ok else f"failed: {error or 'unknown error'}", flush=True)
    return (image_path, None) if ok else (None, error)


# ----------------------------------------------------------------------
# Activate (shared by `set` and `use`)
# ----------------------------------------------------------------------


def archive_existing_current() -> None:
    """Snapshot the current wallpaper into the archive, unless it already
    lives there.

    If `current` is a symlink, copy the target into the archive (preserving the
    source for whoever else might point at it). If `current` is a plain file,
    move it. If `current` is already inside ARCHIVE_DIR, no-op.
    """
    if not CURRENT_LINK.exists() and not CURRENT_LINK.is_symlink():
        return

    try:
        resolved = CURRENT_LINK.resolve(strict=True)
    except (OSError, RuntimeError):
        return

    if not resolved.is_file():
        return

    try:
        resolved.relative_to(ARCHIVE_DIR.resolve())
        return  # already in archive; nothing to snapshot
    except ValueError:
        pass

    stem, ext = sanitize_stem(resolved.name)
    archived = make_archive_path(stem, ext)
    if CURRENT_LINK.is_symlink():
        shutil.copy2(resolved, archived)
    else:
        shutil.move(str(CURRENT_LINK), archived)


def activate(archive_path: Path) -> None:
    if not archive_path.is_file():
        die(f"archive file not found: {archive_path}")

    archive_existing_current()
    if CURRENT_LINK.exists() or CURRENT_LINK.is_symlink():
        CURRENT_LINK.unlink()
    CURRENT_LINK.symlink_to(archive_path)
    width, height = _active_output_size()
    # Best-effort: a display-render failure falls back to the source.
    build_display_cache(archive_path, width, height, verbose=True)
    restart_swaybg()


# ----------------------------------------------------------------------
# Subcommands
# ----------------------------------------------------------------------


def cmd_set(args: argparse.Namespace) -> int:
    src: str = args.source
    ensure_dirs()

    source_name = basename_from_url_or_path(src)
    stem, ext = sanitize_stem(source_name)

    incoming_fd, incoming_path_str = tempfile.mkstemp(
        prefix=".incoming.", dir=str(ARCHIVE_DIR)
    )
    os.close(incoming_fd)
    incoming_path = Path(incoming_path_str)

    try:
        if Path(src).is_file():
            shutil.copy2(src, incoming_path)
        else:
            if shutil.which("curl") is None:
                die("curl is required for URL downloads")
            result = subprocess.run(["curl", "-fL", src, "-o", str(incoming_path)])
            if result.returncode != 0:
                die(f"download failed (curl exit {result.returncode})")

        install_path = make_archive_path(stem, ext)
        # mkstemp created install_path empty; replace it with the download.
        shutil.move(str(incoming_path), install_path)
        incoming_path = None  # don't try to rm in the finally
    finally:
        if incoming_path is not None and incoming_path.exists():
            with contextlib.suppress(OSError):
                incoming_path.unlink()

    activate(install_path)
    print(f"Set wallpaper to {install_path}")
    return 0


def cmd_use(_args: argparse.Namespace) -> int:
    ensure_dirs()
    archive_path = pick_with_fzf()
    if archive_path is None:
        return 0  # user aborted

    activate(archive_path)
    print(f"Using wallpaper {archive_path}")
    return 0


def cmd_current(_args: argparse.Namespace) -> int:
    path = _resolve_current()
    if path is None:
        return 1
    width, height = _active_output_size()
    display = _display_cache_path(path, width, height)
    print(display if display is not None and display.is_file() else path)
    return 0


def _resolve_current() -> Path | None:
    """Return the active wallpaper's resolved path, or None if not set."""
    if not CURRENT_LINK.is_file():
        return None
    try:
        return CURRENT_LINK.resolve(strict=True)
    except OSError:
        return CURRENT_LINK


def cmd_rebuild_cache(_args: argparse.Namespace) -> int:
    """Force-rebuild the display image for the current wallpaper."""
    path = _resolve_current()
    if path is None:
        die("no current wallpaper to rebuild cache for")
    width, height = _active_output_size()
    display, display_error = build_display_cache(path, width, height, force=True)
    if display is None:
        die(f"display image rebuild failed: {display_error or 'unknown error'}")
    print(
        json.dumps(
            {
                "path": str(path),
                "display_image": str(display),
            }
        )
    )
    return 0


def cmd_restart(_args: argparse.Namespace) -> int:
    restart_swaybg()
    return 0


# Kitty "row/column" diacritics: the Nth entry marks row or column N of an
# image placeholder cell. Rows need one each; 64 covers any fzf pane.
_KITTY_DIACRITICS = (
    "\u0305\u030d\u030e\u0310\u0312\u033d\u033e\u033f\u0346\u034a\u034b\u034c"
    "\u0350\u0351\u0352\u0357\u035b\u0363\u0364\u0365\u0366\u0367\u0368\u0369"
    "\u036a\u036b\u036c\u036d\u036e\u036f\u0483\u0484\u0485\u0486\u0487\u0592"
    "\u0593\u0594\u0595\u0597\u0598\u0599\u059c\u059d\u059e\u059f\u05a0\u05a1"
    "\u05a8\u05a9\u05ab\u05ac\u05af\u05c4\u0610\u0611\u0612\u0613\u0614\u0615"
    "\u0616\u0617\u0657\u0658"
)
_KITTY_PLACEHOLDER = "\U0010eeee"
_KITTY_IMAGE_ID = 1


def _kitty_image(path: Path, cols: int, lines: int) -> bytes:
    """Show the PNG at `path` in a cols x lines cell box, Kitty style.

    Uses Unicode placeholders (U=1): the image is bound to placeholder
    characters printed as ordinary text, so it lands wherever fzf draws
    its preview. A plain placement (a=T without U=1) draws at the real
    cursor instead, which under tmux is fzf's prompt, not the preview.
    Ghostty reads the file itself (t=f), so only the path crosses the pty.
    Inside tmux the graphics command needs the passthrough wrapper.
    """
    lines = min(lines, len(_KITTY_DIACRITICS))
    payload = base64.b64encode(str(path).encode()).decode()
    cmd = (
        f"\033_Ga=T,U=1,t=f,f=100,q=2,i={_KITTY_IMAGE_ID},c={cols},r={lines};"
        f"{payload}\033\\"
    )
    if os.environ.get("TMUX"):
        cmd = "\033Ptmux;" + cmd.replace("\033", "\033\033") + "\033\\"
    # Colour 1 encodes the image id; later cells in a row inherit the row
    # and the next column from the cell before, so only the first is marked.
    row = "\033[38;5;%dm%s%s%s%s\033[39m\n"
    rows = "".join(
        row
        % (
            _KITTY_IMAGE_ID,
            _KITTY_PLACEHOLDER,
            _KITTY_DIACRITICS[r],
            _KITTY_DIACRITICS[0],
            _KITTY_PLACEHOLDER * (cols - 1),
        )
        for r in range(lines)
    )
    return (cmd + rows).encode()


def cmd_preview(args: argparse.Namespace) -> int:
    candidate = Path(args.archive_file)
    if not candidate.is_file():
        candidate = ARCHIVE_DIR / args.archive_file
        if not candidate.is_file():
            return 0

    # Kitty graphics preview, cached per wallpaper as a PNG: the first
    # preview pays the magick decode + resize, later cursor moves over the
    # same entry are a path lookup. Cache entries share <key>.* with the
    # display render and get cleaned together when the archive entry is
    # deleted.
    cache_path = _preview_cache_path(candidate)
    if (
        cache_path is not None
        and shutil.which("magick") is not None
        and (cache_path.is_file() or _render_preview(candidate, cache_path))
    ):
        cols = int(os.environ.get("FZF_PREVIEW_COLUMNS") or 80)
        lines = int(os.environ.get("FZF_PREVIEW_LINES") or 24)
        sys.stdout.buffer.write(_kitty_image(cache_path, cols, lines))
        sys.stdout.buffer.flush()
        return 0

    print(candidate)
    return 0


# ----------------------------------------------------------------------
# fzf picker
# ----------------------------------------------------------------------


def _list_archive_basenames() -> list[str]:
    """Sorted (newest first) basenames of every archive entry."""
    if not ARCHIVE_DIR.is_dir():
        return []
    return sorted(
        (p.name for p in ARCHIVE_DIR.iterdir() if p.is_file()),
        reverse=True,
    )


def pick_with_fzf() -> Path | None:
    if shutil.which("fzf") is None:
        die("fzf is required for interactive selection")

    entries = _list_archive_basenames()
    if not entries:
        return None

    self_path = Path(__file__).resolve()
    fzf = subprocess.run(
        [
            "fzf",
            "--prompt=wallpaper> ",
            "--border-label= wallpapers ",
            "--header=enter: use   ctrl-shift-d: delete   esc: cancel",
            "--no-multi",
            "--preview-window=up:60%",
            "--preview",
            f"{self_path} preview {{}} 2>/dev/null",
            # Ctrl-Shift-D triggers immediate delete via _delete-archive,
            # then reload re-emits the archive listing. The shortcut is
            # deliberate enough that no extra confirmation is needed; the
            # entry under cursor is shown in the picker. _delete-archive
            # refuses to delete the currently-active wallpaper (would
            # leave a dangling `current` symlink) and opportunistically
            # cleans the cache for the deleted entry.
            "--bind",
            (
                f"ctrl-D:execute-silent({self_path} _delete-archive {{}})"
                f"+reload({self_path} _list-archive)"
            ),
        ],
        input="\n".join(entries),
        text=True,
        capture_output=True,
    )
    if fzf.returncode != 0:
        return None
    choice = fzf.stdout.strip()
    if not choice:
        return None
    return ARCHIVE_DIR / choice


# ----------------------------------------------------------------------
# Internal subcommands used by the fzf picker (not part of the public CLI)
# ----------------------------------------------------------------------


def cmd__list_archive(_args: argparse.Namespace) -> int:
    """Print archive entries (basenames, newest first), one per line.

    Used as both the initial input and the reload source for the fzf
    picker. Lives as a subcommand rather than inline shell so the
    picker stays declarative.
    """
    for name in _list_archive_basenames():
        print(name)
    return 0


def cmd__delete_archive(args: argparse.Namespace) -> int:
    """Delete an archive entry + opportunistically nuke its cache.

    Refuses to delete the currently-active wallpaper (would leave a
    dangling `current` symlink). Errors are printed to stderr but the
    return code is intentionally always 0 — fzf's reload path doesn't
    care, and a non-zero exit would surface as a confusing fzf error
    line. The user just sees the entry vanish (or not, if it's the
    active one).
    """
    name = args.basename
    target = ARCHIVE_DIR / name
    if not target.is_file():
        print(f"wallpaper: not in archive: {name}", file=sys.stderr)
        return 0

    active = _resolve_current()
    if active is not None and active.resolve() == target.resolve():
        print(
            f"wallpaper: refusing to delete currently-active wallpaper "
            f"({name}); switch to another first",
            file=sys.stderr,
        )
        return 0

    # Compute the cache key before unlinking — once the file is gone we
    # can't stat its mtime. Then glob <key>.* under CACHE_DIR to scoop
    # up the display render and the preview thumbnail in one pass.
    key = _cache_key(target)

    try:
        target.unlink()
    except OSError as exc:
        print(f"wallpaper: failed to delete {name}: {exc}", file=sys.stderr)
        return 0

    if key is not None:
        for cache_file in CACHE_DIR.glob(f"{key}.*"):
            with contextlib.suppress(OSError):
                cache_file.unlink()
    return 0


# ----------------------------------------------------------------------
# CLI
# ----------------------------------------------------------------------


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="wallpaper",
        description="Manage swaybg wallpapers under ~/.local/share/wallpapers/.",
    )
    sub = parser.add_subparsers(dest="cmd", required=True)

    p_set = sub.add_parser("set", help="download or copy a wallpaper, then activate")
    p_set.add_argument("source", help="URL or local file path")
    p_set.set_defaults(func=cmd_set)

    p_use = sub.add_parser("use", help="pick and activate an archived wallpaper")
    p_use.set_defaults(func=cmd_use)

    p_current = sub.add_parser("current", help="print the active wallpaper path")
    p_current.set_defaults(func=cmd_current)

    p_rebuild = sub.add_parser(
        "rebuild-cache",
        help="force-rebuild the display image for the current wallpaper",
    )
    p_rebuild.set_defaults(func=cmd_rebuild_cache)

    p_restart = sub.add_parser("restart", help="restart swaybg.service")
    p_restart.set_defaults(func=cmd_restart)

    p_preview = sub.add_parser("preview", help="image for the fzf preview pane")
    p_preview.add_argument("archive_file")
    p_preview.set_defaults(func=cmd_preview)

    # Internal subcommands used by the fzf picker via --bind. The
    # leading underscore + the lack of `help=` keeps them out of the
    # per-line descriptions in --help; they still appear in the
    # {a,b,c,...} choice list (argparse limitation), which is fine for
    # signalling "internal but technically callable".
    p_list = sub.add_parser("_list-archive")
    p_list.set_defaults(func=cmd__list_archive)

    p_del = sub.add_parser("_delete-archive")
    p_del.add_argument("basename")
    p_del.set_defaults(func=cmd__delete_archive)

    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
