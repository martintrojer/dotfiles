# SSH configuration

# Global settings
AddKeysToAgent yes
IdentitiesOnly yes

# Reuse one authenticated connection per host: fast reconnects, one auth per
# host, and something for ServerAliveInterval to keep alive. A background tool
# that shells out over ssh can then ride an already-authenticated connection
# instead of prompting for a new one.
# Requires ~/.ssh/control to exist; ssh does not create it.
ControlMaster auto
ControlPath ~/.ssh/control/%r@%h:%p
ControlPersist 8h
ServerAliveInterval 30

Host linuxpc
  SendEnv LANG LC_*
  User martintrojer
  ForwardAgent yes

Host bubba
  SendEnv LANG LC_*
  User martintrojer
  ForwardAgent yes

Host pizero2
  SendEnv LANG LC_*
  User martintrojer
  ForwardAgent yes
