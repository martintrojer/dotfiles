# SSH configuration

# Global settings
AddKeysToAgent yes
IdentitiesOnly yes

# Reuse one authenticated connection per host: fast reconnects, one auth per
# host, and something for ServerAliveInterval to keep alive. A background tool
# that shells out over ssh can then ride an already-authenticated connection
# instead of prompting for a new one.
# ssh does not create the ControlPath directory, and fails the connection when
# it is missing rather than falling back. ssh/.ssh/control/.gitkeep exists only
# so dotfiles-sync materialises the directory (it mkdir -p's each link's
# parent); the sockets themselves are never tracked.
ControlMaster auto
ControlPath ~/.ssh/control/%r@%h:%p
ControlPersist 8h
ServerAliveInterval 30

