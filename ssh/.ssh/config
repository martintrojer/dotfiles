# SSH configuration
#
# ssh takes the FIRST value for each keyword, so add new host blocks ABOVE the
# `Host *` defaults at the bottom. Below them, per-host overrides are ignored.

Host linuxpc
  SendEnv LANG LC_*
  User martintrojer
  ForwardAgent yes

Host bubba
  SendEnv LANG LC_*
  User martintrojer
  ForwardAgent yes

Host pizero2
  SendEnv LANG LC_*
  User martintrojer
  ForwardAgent yes

Host gardenpc
  SendEnv LANG LC_*
  User hadijatrojer
  ForwardAgent yes

Host macmini
  SendEnv LANG LC_*
  User martintrojer
  ForwardAgent yes

Host workmac
  SendEnv LANG LC_*
  User mtrojer
  ForwardAgent yes

# Defaults for every host. Keep this block LAST; see the note at the top.
Host *
  AddKeysToAgent yes
  IdentitiesOnly yes

  # Reuse one authenticated connection per host, so background tools that
  # shell out over ssh ride it instead of re-authenticating.
  # ssh will not create ControlPath's directory and fails the connection when
  # it is missing; ssh/.ssh/control/.gitkeep exists only to make dotfiles-sync
  # materialise it. The sockets are never tracked.
  ControlMaster auto
  ControlPath ~/.ssh/control/%r@%h:%p
  ControlPersist 8h

  # Keepalive; parsed before /etc/ssh/ssh_config, so these beat the Meta
  # defaults. Always set both: an interval alone leaves countmax at 3, tearing
  # the session down after 90s of silence. 30s * 20 = 10min of tolerance,
  # enough to survive a VPN reconnect or a stalled x2ssh tunnel.
  ServerAliveInterval 30
  ServerAliveCountMax 20
  # Fail fast on a dead host instead of hanging the caller ~75s.
  ConnectTimeout 10
