// swayward config — originally generated by contrib/sway-to-kdl, since
// hand-edited. KDL format: https://kdl.dev  ("/-" comments out a node.)
//
// Sections:
//   1. Input        keyboard, pointer, focus behaviour
//   2. Layout       gaps, borders, titlebars, shadows
//   3. Appearance   screenshots, animations, blur, overlay
//   4. Window rules general first, then per-app
//   5. Binds        launchers, media, focus, workspaces, layout, resize
//   6. Not converted — sway directives sway-to-kdl could not translate
//
// "Mod" in binds is Super on a TTY and Alt in a nested winit window. This
// file uses literal "Super+", so binds do NOT work in a nested dev session;
// contrib/dev-run.sh rewrites them to "Mod+" for its throwaway copy.


// ─────────────────────────────────────────────────────────────────────────
// 1. Input
// ─────────────────────────────────────────────────────────────────────────

input {
    focus-follows-mouse
    workspace-auto-back-and-forth false
    mod-key "Super"

    keyboard {
        xkb {
            // rules, model, layout, variant and options; see xkeyboard-config(7).
            // Left empty, swayward fetches xkb settings from org.freedesktop.locale1.
        }

        // swayward equivalent of sway's xkb_numlock enabled.
        numlock
    }

    // libinput settings. Omitting a setting leaves it at its default.
    touchpad {
        // off
        tap
        // dwt
        // dwtp
        // drag false
        // drag-lock
        natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "two-finger"
        // disabled-on-external-mouse
    }

    mouse {
        // off
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "no-scroll"
    }

    trackpoint {
        // off
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "on-button-down"
        // scroll-button 273
        // scroll-button-lock
        // middle-emulation
    }

    // Warp the mouse to the center of newly focused windows.
    // warp-mouse-to-focus
}

gestures {
    hot-corners { off; }
}


// ─────────────────────────────────────────────────────────────────────────
// 2. Layout — geometry and window decoration
// ─────────────────────────────────────────────────────────────────────────

layout {
    // -- Behaviour ---------------------------------------------------------

    focus-wrapping "no"
    hide-edge-borders "none"
    smart-borders "no-gaps"

    // Root split follows the output shape: wide/square splits horizontally,
    // portrait splits vertically. "horizontal"/"vertical" force one direction.
    default-orientation "auto"

    // -- Spacing -----------------------------------------------------------

    gaps 4

    outer-gaps {
        left 0
        right 0
        top 0
        bottom 0
    }

    // Struts shrink the area windows may occupy, like extra outer gaps.
    // Left/right struts keep the next window to the side visible; top/bottom
    // add gaps on top of layer-shell panels and regular gaps.
    struts {
        // left 64
        // right 64
        // top 64
        // bottom 64
    }

    // -- Inherited sizing (niri heritage) ----------------------------------
    // These drive the native preset-size actions. Sway commands do not use
    // them; width changes resize the nearest horizontal tree split.

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        // fixed 1920
    }
    // preset-window-heights { }

    // Accepted for compatibility. The tree allocates the full node.
    default-column-width { proportion 0.5; }

    // -- Focus ring and border ---------------------------------------------
    // Both draw as a solid rectangle *behind* windows, so they show through
    // semitransparent ones. Uncomment prefer-no-csd (section 3) to have them
    // drawn around windows instead.

    focus-ring {
        // The border below marks every container, so keep the focus ring off.
        off

        width 4
        active-color "#cba6f7"
        inactive-color "#585b70"

        // Gradients take precedence over solid colors and render like CSS
        // linear-gradient(angle, from, to).
        // active-gradient from="#80c8ff" to="#c7ff7f" angle=45
        // inactive-gradient from="#505050" to="#808080" angle=45 relative-to="workspace-view"
    }

    // A quiet border around every window; the active color shows focus.
    // Width 2 matches "default_border pixel 2" from the sway config.
    border {
        on

        width 2
        active-color "#cba6f7"
        inactive-color "#585b70"

        // Windows that request attention.
        urgent-color "#f38ba8"

        // active-gradient from="#e5989b" to="#ffb4a2" angle=45 relative-to="workspace-view" in="oklch longer hue"
        // inactive-gradient from="#505050" to="#808080" angle=45 relative-to="workspace-view"
    }

    // -- Titlebars and tab strips ------------------------------------------
    // Catppuccin Mocha. Height is the font height plus twice vertical-padding.

    titlebar {
        font "JetBrains Mono Nerd Font Bold 10"

        // swayward equivalent of sway's titlebar_padding 6 3.
        horizontal-padding 6
        vertical-padding 3

        focused {
            background-color "#585b70"
            text-color "#b4befe"
        }
        focused-inactive {
            background-color "#585b70"
            text-color "#b4befe"
        }
        focused-tab-title {
            background-color "#313244"
            text-color "#b4befe"
        }
        unfocused {
            background-color "#181825"
            text-color "#6c7086"
        }
        urgent {
            background-color "#f38ba8"
            text-color "#cdd6f4"
        }
    }

    // -- Shadow ------------------------------------------------------------

    // Separates windows without obscuring their content.
    shadow {
        on

        // The shadow draws only around its window, not behind it. swayward
        // cannot know a CSD window's corner radius, so it assumes square
        // corners, leaving artifacts inside CSD rounded corners.
        // draw-behind-window fixes those; prefer-no-csd and/or
        // geometry-corner-radius fix them better.
        // draw-behind-window true

        // Logical pixels, matching the CSS box-shadow properties.
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }
}


// ─────────────────────────────────────────────────────────────────────────
// 3. Appearance and session behaviour
// ─────────────────────────────────────────────────────────────────────────

hotkey-overlay {
    // Disable the "Important Hotkeys" pop-up at startup.
    skip-at-startup
}

// Ask clients to omit client-side decorations where possible.
//
// This is load-bearing, not cosmetic: swayward only advertises the
// xdg-decoration globals to a client when this is set
// (src/swayward.rs:2856). Without it, foot logs "no decoration manager
// available - using CSDs unconditionally" and draws its own titlebar with a
// close button, which no swayward setting can remove.
//
// Clients that specifically ask for CSD still get it. Also marks clients
// tiled, removing some client-side rounded corners. Restart apps after
// changing this; it does not fully apply to already-running ones.
prefer-no-csd

// Leading ~ expands to the home directory; formatted with strftime(3).
// Set to null to disable saving screenshots to disk.
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"
// screenshot-path null

animations {
    // off

    // Slow down all animations by this factor; below 1 speeds them up.
    // slowdown 3.0
}

// Global blur settings. This block only TUNES blur; it does not turn any on.
// Blur appears when a window asks for it via ext-background-effect, or when a
// window-rule sets `background-effect { blur true }` (see section 4).
// Values below are the compiled defaults. `off` kills all blur everywhere.
blur {
    // off
    passes 3
    offset 3
    noise 0.02
    saturation 1.5
}

// Startup processes. Running swayward as a session also supports
// xdg-desktop-autostart, which is often more convenient.
// Reuse the Sway systemd user target and its desktop services.
spawn-sh-at-startup "~/.config/sway/scripts/session-start"

// spawn-at-startup "waybar"
// spawn-sh-at-startup "qs -c ~/source/qs/MyAwesomeShell"


// ─────────────────────────────────────────────────────────────────────────
// 4. Window rules — general first, then per-app
// ─────────────────────────────────────────────────────────────────────────

// Round and clip window content so border and shadow share one outline.
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

// Blur behind translucent terminals. Only shows up if the app is actually
// translucent -- foot.ini has alpha=0.9, so it is. An opaque window has
// nothing to see through and blur is wasted GPU work.
//
// xray false selects true see-through blur: everything below the window is
// blurred, not just the wallpaper. The default (xray true) blurs the
// wallpaper once and reuses it, which is much cheaper but ignores windows
// underneath.
//
// Cost of xray false: swayward recomputes the blur whenever the window moves
// or anything beneath it changes. The wiki marks non-xray blur experimental --
// it drops out during window open/close animations and while dragging a tiled
// window. Set xray back to true (or delete the line) if that shows.
window-rule {
    match app-id="^foot(client)?$"

    background-effect {
        blur true
        xray false
    }
}

// Blur behind the fuzzel launcher, which all the Super+<key> pickers use.
// fuzzel is a layer surface, so this needs a layer-rule rather than a
// window-rule. "launcher" is fuzzel's default namespace (man fuzzel,
// -n/--namespace); none of the scripts in ~/.config/fuzzel/scripts override it.
layer-rule {
    match namespace="^launcher$"

    background-effect {
        blur true
        xray false
    }
}

// sway: default_border pixel 2
window-rule {
    sway-border "pixel"
    sway-border-width 2
}

// sway: default_floating_border pixel 2
window-rule {
    sway-floating-border "pixel"
    sway-floating-border-width 2
}

// Work around WezTerm's initial configure bug.
window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

// Firefox picture-in-picture floats. Matches host Firefox ("firefox") and
// Flatpak Firefox ("org.mozilla.firefox").
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// Block password managers out of screen capture.
/-window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#

    block-out-from "screen-capture"

    // Use this instead to keep them visible to third-party screenshot tools.
    // block-out-from "screencast"
}

// -- Converted from sway for_window rules ---------------------------------
// Regenerated with contrib/sway-to-kdl; an older converter had emitted these
// as "needs manual conversion" comments. "move position center" and
// "sticky enable" have no typed equivalent yet and go through the
// sway-for-window-command escape hatch.

// Picture-in-picture: float, keep on top, thin border.
window-rule {
    match title="(?i)^picture[- ]in[- ]picture$"
    open-floating true
    sway-for-window-command "sticky enable"
    sway-border "pixel"
    sway-border-width 2
}

// Floating file manager / image viewer at 50x60 percent, centred.
window-rule {
    match app-id="^thunar$"
    open-floating true
    default-column-width { proportion 0.5; }
    default-window-height { proportion 0.6; }
    sway-for-window-command "move position center"
}

window-rule {
    match app-id="^imv$"
    open-floating true
    default-column-width { proportion 0.5; }
    default-window-height { proportion 0.6; }
    sway-for-window-command "move position center"
}

// Floating utility terminals, matching the Super+Shift binds above.
window-rule {
    match app-id="^wiremix-float$"
    open-floating true
    default-column-width { proportion 0.5; }
    default-window-height { proportion 0.6; }
    sway-for-window-command "move position center"
}

window-rule {
    match app-id="^bluetui-float$"
    open-floating true
    default-column-width { proportion 0.5; }
    default-window-height { proportion 0.6; }
    sway-for-window-command "move position center"
}

window-rule {
    match app-id="^nmtui-float$"
    open-floating true
    default-column-width { proportion 0.5; }
    default-window-height { proportion 0.6; }
    sway-for-window-command "move position center"
}

window-rule {
    match app-id="^yazi-float$"
    open-floating true
    default-column-width { proportion 0.5; }
    default-window-height { proportion 0.6; }
    sway-for-window-command "move position center"
}

window-rule {
    match app-id="^btop-float$"
    open-floating true
    default-column-width { proportion 0.5; }
    default-window-height { proportion 0.6; }
    sway-for-window-command "move position center"
}

// Dialogs that should float centred rather than tile.
window-rule {
    match app-id="^xdg-desktop-portal-gtk$"
    open-floating true
    sway-for-window-command "move position center"
}

window-rule {
    match title="^Authentication Required$"
    open-floating true
    sway-for-window-command "move position center"
}

window-rule {
    match app-id="^google-chrome$" title="^(Sign in|Task Manager)"
    open-floating true
    sway-for-window-command "move position center"
}

// Apps that keep a thin border.
window-rule {
    match app-id="^google-chrome$"
    sway-border "pixel"
    sway-border-width 2
}

window-rule {
    match app-id="^(code|vscode)$"
    sway-border "pixel"
    sway-border-width 2
}

window-rule {
    match app-id="^t3code$"
    sway-border "pixel"
    sway-border-width 2
}

// Cider starts hidden in the scratchpad; Super+m shows it.
window-rule {
    match app-id="^cider$"
    sway-border "pixel"
    sway-border-width 2
    sway-for-window-command "move scratchpad"
}


// ─────────────────────────────────────────────────────────────────────────
// 5. Binds
// ─────────────────────────────────────────────────────────────────────────

binds {
    // -- Launchers and apps ------------------------------------------------

    Super+F1 { command "exec ~/.config/fuzzel/scripts/hotkeys"; }
    Super+Return { command "exec footclient"; }
    Super+space { command "exec fuzzel --prompt 'Run ' --placeholder 'Search apps...'"; }
    Super+b { command "exec ~/.config/sway/scripts/open-browser"; }
    Super+y { command "exec ~/.config/sway/scripts/open-yazi"; }
    Super+Shift+y { command "exec thunar"; }
    Super+m { command "exec ~/.config/sway/scripts/open-cider"; }
    Super+Shift+m { command "exec ~/.config/fuzzel/scripts/cider"; }

    // -- Floating utility terminals ----------------------------------------

    Super+Shift+a { command "exec footclient --app-id=wiremix-float wiremix"; }
    Super+Shift+b { command "exec footclient --app-id=bluetui-float zsh -il -c bluetui"; }
    Super+Shift+w { command "exec footclient --app-id=nmtui-float nmtui"; }

    // -- fuzzel pickers ----------------------------------------------------

    Super+t { command "exec ~/.config/fuzzel/scripts/toolboxes"; }
    Super+s { command "exec ~/.config/fuzzel/scripts/ssh"; }
    Super+v { command "exec ~/.config/fuzzel/scripts/clipboard"; }
    Super+e { command "exec ~/.config/fuzzel/scripts/emoji"; }
    Super+backslash { command "exec ~/.config/fuzzel/scripts/calc"; }

    // -- Session -----------------------------------------------------------
    // These act on the REAL machine even from a nested session.

    Super+Shift+p { command "exec ~/.config/fuzzel/scripts/powermenu"; }
    Super+Shift+BackSpace { command "exec ~/.config/sway/scripts/lock-screen"; }
    Ctrl+Alt+Delete { command "exec ~/.config/sway/scripts/session-quit"; }
    Super+Shift+r { command "reload"; }

    // -- Media and brightness ----------------------------------------------

    XF86AudioRaiseVolume { command "exec wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+"; }
    XF86AudioLowerVolume { command "exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"; }
    XF86AudioMute { command "exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute { command "exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86AudioPlay { command "exec playerctl play-pause"; }
    XF86AudioStop { command "exec playerctl stop"; }
    XF86AudioPrev { command "exec playerctl previous"; }
    XF86AudioNext { command "exec playerctl next"; }
    XF86MonBrightnessUp { command "exec brightnessctl s 10%+"; }
    XF86MonBrightnessDown { command "exec brightnessctl s 10%-"; }

    // -- Screenshots -------------------------------------------------------

    Super+F5 { command "exec ~/.config/sway/scripts/screenshot all"; }
    Super+Ctrl+F5 { command "exec ~/.config/sway/scripts/screenshot output"; }
    Super+Alt+F5 { command "exec ~/.config/sway/scripts/screenshot region"; }

    // -- Focus -------------------------------------------------------------

    Super+Left  { command "focus left"; }
    Super+Down  { command "focus down"; }
    Super+Up    { command "focus up"; }
    Super+Right { command "focus right"; }
    Super+h { command "focus left"; }
    Super+j { command "focus down"; }
    Super+k { command "focus up"; }
    Super+l { command "focus right"; }
    Super+c { command "focus parent"; }
    Super+Ctrl+c { command "focus child"; }

    // -- Move windows ------------------------------------------------------

    Super+Shift+Left  { command "move left"; }
    Super+Shift+Down  { command "move down"; }
    Super+Shift+Up    { command "move up"; }
    Super+Shift+Right { command "move right"; }
    Super+Shift+h { command "move left"; }
    Super+Shift+j { command "move down"; }
    Super+Shift+k { command "move up"; }
    Super+Shift+l { command "move right"; }

    // -- Overview and window switching -------------------------------------

    // Zoomed-out view of all workspaces and windows.
    Super+O repeat=false { toggle-overview; }

    // Super+Tab is deliberately NOT bound here. The built-in recent-windows
    // (MRU) switcher already owns Mod+Tab and Mod+grave by default, and a
    // bind in this block would shadow it -- general binds take precedence
    // over MRU binds (src/input/mod.rs:6011). Hold Super and tap Tab to walk
    // the list; Super+Shift+Tab goes backwards.
    //
    // Tune it with a top-level recent-windows block, for example:
    //   recent-windows {
    //       off
    //       open-delay-ms 150
    //   }

    // -- Window state ------------------------------------------------------

    Super+Shift+q { command "kill"; }
    Super+f { command "fullscreen toggle"; }
    Super+Shift+space { command "floating toggle"; }
    Super+Shift+n { command "move scratchpad"; }
    Super+n { command "scratchpad show"; }

    // -- Splits and layout -------------------------------------------------

    Super+bracketleft { command "split v"; }
    Super+bracketright { command "split h"; }
    Super+period { command "layout toggle tabbed split"; }

    // -- Resize ------------------------------------------------------------

    Super+minus { command "resize shrink width  50 px"; }
    Super+equal { command "resize grow   width  50 px"; }
    Super+Shift+minus { command "resize shrink height 50 px"; }
    Super+Shift+equal { command "resize grow   height 50 px"; }
    Super+r { command "exec ~/.config/sway/scripts/preset-width"; }

    // -- Workspace switching -----------------------------------------------

    Super+1 { command "workspace number 1"; }
    Super+2 { command "workspace number 2"; }
    Super+3 { command "workspace number 3"; }
    Super+4 { command "workspace number 4"; }
    Super+5 { command "workspace number 5"; }
    Super+6 { command "workspace number 6"; }
    Super+Page_Down { command "workspace next"; }
    Super+Page_Up { command "workspace prev"; }
    Super+g { command "workspace back_and_forth"; }
    Super+Shift+g { command "exec ~/.config/sway/scripts/window-back-and-forth"; }

    // -- Move to workspace (and follow) -------------------------------------

    Super+Shift+1 { command "move to workspace number 1; workspace number 1"; }
    Super+Shift+2 { command "move to workspace number 2; workspace number 2"; }
    Super+Shift+3 { command "move to workspace number 3; workspace number 3"; }
    Super+Shift+4 { command "move to workspace number 4; workspace number 4"; }
    Super+Shift+5 { command "move to workspace number 5; workspace number 5"; }
    Super+Shift+6 { command "move to workspace number 6; workspace number 6"; }
    Super+Ctrl+Page_Down { command "move to workspace next; workspace next"; }
    Super+Ctrl+Page_Up { command "move to workspace prev; workspace prev"; }

    // -- Multi-monitor -----------------------------------------------------

    Super+Shift+u { command "move workspace to output left"; }
    Super+Shift+i { command "move workspace to output right"; }
}


// ─────────────────────────────────────────────────────────────────────────
// 6. Not converted by sway-to-kdl
// ─────────────────────────────────────────────────────────────────────────
// Re-derived 2026-09-19 by re-running contrib/sway-to-kdl against
// ~/dotfiles/sway/.config/sway/config. The converter reports 8 directives
// needing attention, down from 27 when this file was first generated; every
// for_window rule now converts and lives in section 4.
//
// Resolved since first generation (kept for provenance):
//   :60  titlebar_padding 6 3   -> layout/titlebar horizontal+vertical-padding
//   :64  smart_gaps off         -> satisfied by swayward defaults
//   all 15 for_window rules     -> section 4
//   xkb_numlock enabled         -> input/keyboard numlock
//
// Still unconverted:
//   :34  input * { ... }        device-specific selectors need manual work
//
// The session-start command is translated in section 3. Swayward runs it only
// at startup; Sway also runs it on reload to reapply the kanshi profile.
//
// Colors with no titlebar equivalent (border/indicator/child_border):
//   :68 client.focused          #585b70 #585b70 #b4befe #585b70 #cba6f7
//   :69 client.focused_inactive #585b70 #585b70 #b4befe #585b70 #313244
//   :70 client.unfocused        #6c7086 #181825 #6c7086 #181825 #6c7086
//   :71 client.urgent           #f38ba8 #f38ba8 #cdd6f4 #f38ba8 #f38ba8
//
// Accepted but ignored by sway ITSELF, so nothing is lost:
//   :72 client.placeholder      #181825 #181825 #cdd6f4 #181825 #181825
//   :73 client.background       #1e1e2e
//
// Not reported by the converter, still absent here:
//   :15  swaybg_command -
//   :227 Mod4+a focus mode_toggle   outside swayward's command subset
