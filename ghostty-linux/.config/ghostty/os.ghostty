# Linux (Sway) half. Binary from ghostty/build-ghostty.py.
font-family = Hack Nerd Font Mono
font-size = 12
# The only renderer knob that thickens Hack on FreeType: ~18% more ink than
# linear-corrected (the default) and foot. font-thicken is macOS-only. See
# "Ghostty on Linux" in docs/DECISIONS.md.
alpha-blending = linear

background-opacity = 0.8
window-padding-x = 8
window-padding-y = 8
window-padding-balance = false
# Sway draws the borders; no GTK headerbar or tab bar. `server`, not `none`:
# none sends KDE decoration mode None, which swayward (like sway) treats as
# CSD, so a floating window drops its border and focus ring.
window-decoration = server
gtk-titlebar = false

# Pin the shape so DECSCUSR changes don't confuse zle.
shell-integration-features = no-cursor
cursor-style-blink = false
mouse-hide-while-typing = true
copy-on-select = clipboard
# Plain launches: no single-instance D-Bus daemon, one process per window.
gtk-single-instance = false
# Always-in-tmux: closing a window detaches, nothing to confirm.
confirm-close-surface = false

# The Rainy75 Cmd layer sends Ctrl+Insert / Shift+Insert. Ctrl+Insert already
# copies by default; Shift+Insert defaults to the primary selection.
keybind = shift+insert=paste_from_clipboard
