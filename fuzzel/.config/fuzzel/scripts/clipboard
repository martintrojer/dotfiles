#!/usr/bin/env python3
"""Clipboard history picker using cliphist + fuzzel."""

from __future__ import annotations

import argparse

from _common import ScriptError, cli_main, require_commands, run, run_bytes


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--prompt", default="Clipboard  ")
    parser.add_argument("--width", type=int, default=80)
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    require_commands(["cliphist", "fuzzel", "wl-copy"])

    history = run(["cliphist", "list"], check=False)
    if history.returncode != 0:
        raise ScriptError("Could not read clipboard history")
    if not history.stdout:
        return 0

    selected = run(
        [
            "fuzzel",
            "--dmenu",
            "--with-nth",
            "2",
            "--prompt",
            args.prompt,
            "--width",
            str(args.width),
        ],
        input_text=history.stdout,
        check=False,
    )
    if selected.returncode != 0 or not selected.stdout:
        return 0

    # Decode/restore as bytes: cliphist entries include images, so wl-copy
    # (not clipf) and no UTF-8 round-trip.
    decoded = run_bytes(
        ["cliphist", "decode"],
        input_bytes=selected.stdout.encode(),
        check=False,
    )
    if decoded.returncode != 0:
        raise ScriptError("Could not decode clipboard entry")
    copied = run_bytes(
        ["wl-copy"],
        input_bytes=decoded.stdout,
        check=False,
        capture_output=False,
    )
    if copied.returncode != 0:
        raise ScriptError("Could not restore clipboard entry")
    return 0


if __name__ == "__main__":
    cli_main("clipboard", main)
