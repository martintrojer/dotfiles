#!/usr/bin/env python3
"""Clipboard history picker using cliphist + fuzzel."""

from __future__ import annotations

import argparse
import subprocess

from _common import ScriptError, cli_main, require_commands


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--prompt", default="Clipboard  ")
    parser.add_argument("--width", type=int, default=80)
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    require_commands(["cliphist", "fuzzel", "wl-copy"])

    history = subprocess.run(["cliphist", "list"], capture_output=True, check=False)
    if history.returncode != 0:
        raise ScriptError("Could not read clipboard history")
    if not history.stdout:
        return 0

    selected = subprocess.run(
        [
            "fuzzel",
            "--dmenu",
            "--with-nth",
            "2",
            "--prompt",
            args.prompt,
            "--width",
            str(args.width),
        ],
        input=history.stdout,
        capture_output=True,
        check=False,
    )
    if selected.returncode != 0 or not selected.stdout:
        return 0

    decoded = subprocess.run(
        ["cliphist", "decode"], input=selected.stdout, capture_output=True, check=False
    )
    if decoded.returncode != 0:
        raise ScriptError("Could not decode clipboard entry")
    copied = subprocess.run(["wl-copy"], input=decoded.stdout, check=False)
    if copied.returncode != 0:
        raise ScriptError("Could not restore clipboard entry")
    return 0


if __name__ == "__main__":
    cli_main("clipboard", main)
