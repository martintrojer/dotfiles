#!/usr/bin/env python3
"""Track AI agent state per tmux window and surface it in tmux UI.

State model:
  working  — agent is running (set by pi extension directly)
  done     — agent finished while unseen (pi extension on agent_end)
  blocked  — agent waiting on user (legacy notify: codex/opencode)
  crashed  — agent died unexpectedly (reaper: pid gone while working)
  cleared  — explicit clear; resets to none

The pi extension is the authoritative writer of @agent_state for
normal transitions.  This script handles:
  - ``notify``: legacy path for non-pi agents (codex/opencode)
  - ``status``: crash reaper + state counting for the status pill
  - ``clear-current`` / ``clear-target``: focus-clear hooks
  - ``menu``: the prefix+a picker
"""

from __future__ import annotations

import argparse
import json
import os
import select
import shlex
import shutil
import sqlite3
import subprocess
import sys
import time
from pathlib import Path
from typing import NamedTuple

from _tmux_common import (
    STATE_GLYPH,
    AgentState,
    AgentStats,
    ProcessSnapshot,
    scan_agent_states,
    tmux_cmd,
)

STATE_DIR = (
    Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local" / "state")
    / "tmux-agent-attention"
)
DB_PATH = STATE_DIR / "events.db"
MAX_EVENTS = 4000
# How many events the picker preview renders for the highlighted window.
PREVIEW_EVENTS = 10
# Per-message cap in the preview; one runaway agent message must not push the
# rest of the history off the pane.
PREVIEW_MSG_MAX = 300
ENABLE_SYSTEM_NOTIFY_ENV = "TMUX_AGENT_ATTENTION_ENABLE_SYSTEM_NOTIFY"
DISABLE_SYSTEM_NOTIFY_ENV = "TMUX_AGENT_ATTENTION_DISABLE_SYSTEM_NOTIFY"


# ---------- tmux helpers ----------


def tmux_exists() -> bool:
    return shutil.which("tmux") is not None


def tmux(args: list[str], check: bool = True) -> str:
    """agent-attention's local convenience wrapper: takes a list,
    returns stripped stdout, and re-raises non-zero exits as
    ``RuntimeError`` with the most useful stream text we have. Built
    on `_tmux_common.tmux_cmd` so the socket-env honoring is shared.
    """
    result = tmux_cmd(*args, check=False)
    if check and result.returncode != 0:
        msg = result.stderr.strip() or result.stdout.strip() or "tmux command failed"
        raise RuntimeError(msg)
    return result.stdout.strip()


def tmux_query(target: str | None, fields: list[str]) -> list[str] | None:
    """Run display-message with a list of #{...} fields, return parts or None."""
    fmt = "\t".join(fields)
    args = ["display-message", "-p"]
    if target:
        args += ["-t", target]
    args.append(fmt)
    out = tmux(args, check=False)
    if not out:
        return None
    parts = out.split("\t")
    return parts if len(parts) == len(fields) else None


def sanitize(value: str) -> str:
    return value.replace("\t", " ").replace("\n", " ").replace("\r", " ").strip()


def scrub_untrusted(value: str, limit: int = 0) -> str:
    """Make agent-authored text safe to print into a terminal UI.

    Event messages are written by agents, so they are attacker-influenced
    text as far as this script is concerned. Two things must not happen
    when the picker preview renders them:

      * ANSI/OSC escapes reaching the terminal. The preview runs with
        ``fzf --ansi`` for our own glyph colours, so an embedded ESC in a
        message could repaint the UI, hide text, or emit OSC sequences.
        Every C0/C1 control character (ESC included) is replaced, not just
        stripped, so "\\x1b[2J" degrades to visible text rather than
        silently splicing its tail onto the surrounding line.
      * Newlines and tabs breaking the row protocol. Picker rows are
        "<target>\\t<label>" one per line, so a message carrying either
        could forge a row (and therefore a switch-client target).

    Note what this deliberately does *not* do: none of this text is ever
    routed into a tmux option, a ``#()`` command line, or anything read
    back through ``#{E:...}``/``#{T:...}``. There is no format
    re-expansion sink here, and adding one would make quoting the only
    thing standing between an agent message and command execution.
    """
    out = []
    for ch in value:
        cp = ord(ch)
        # C0 (incl. ESC/NUL/newline/tab), DEL, and C1 (0x80-0x9f, which
        # some terminals accept as single-byte CSI/OSC introducers).
        out.append("\ufffd" if cp < 0x20 or cp == 0x7F or 0x80 <= cp <= 0x9F else ch)
    text = "".join(out).strip()
    if limit and len(text) > limit:
        text = text[: limit - 1].rstrip() + "…"
    return text


def to_int(value: object, default: int = 0) -> int:
    if isinstance(value, (int, str, bytes, bytearray)):
        try:
            return int(value)
        except (TypeError, ValueError):
            pass
    return default


# ---------- pane resolution ----------


def find_tty() -> str | None:
    """Resolve the controlling TTY for the current process.

    Fast path: ``os.ttyname(fd)`` for stdin/stdout/stderr — zero forks when
    the script is run interactively or from a tmux pane that inherited a
    TTY on at least one standard fd.

    Slow path: walk up the process tree from a single ``ps`` snapshot,
    used for hook subprocesses (systemd, agent harnesses) where none of
    fd0/1/2 is a TTY. We cap the walk at 8 ancestor levels. The previous
    implementation forked ``ps`` twice per level (up to 16 forks); one
    snapshot indexed by pid is one fork total.

    On macOS ``ps -o tty=`` outputs ``??`` for processes with no
    controlling tty (Linux uses ``?``). Treat any all-``?`` value as
    no-tty.
    """
    for fd in (0, 1, 2):
        try:
            return os.ttyname(fd)
        except OSError:
            continue

    try:
        res = subprocess.run(
            ["ps", "-axo", "pid=,ppid=,tty="],
            capture_output=True,
            text=True,
            check=False,
            timeout=5,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    if res.returncode != 0:
        return None
    rows = res.stdout

    by_pid: dict[str, tuple[str, str]] = {}
    for line in rows.splitlines():
        parts = line.split(None, 2)
        if len(parts) == 3:
            by_pid[parts[0]] = (parts[1], parts[2])

    pid = str(os.getpid())
    for _ in range(8):
        info = by_pid.get(pid)
        if info is None:
            return None
        ppid, tty = info
        if tty and tty.strip("?"):
            return f"/dev/{tty}"
        pid = ppid
    return None


def pane_from_tty() -> str | None:
    """Map controlling TTY → tmux pane id (first match wins)."""
    tty = find_tty()
    if not tty:
        return None
    out = tmux(["list-panes", "-a", "-F", "#{pane_tty}\t#{pane_id}"], check=False)
    for row in out.splitlines():
        parts = row.split("\t", 1)
        if len(parts) == 2 and parts[0] == tty:
            return parts[1]
    return None


CONTEXT_FIELDS = [
    "#{session_id}",
    "#{session_name}",
    "#{window_id}",
    "#{window_index}",
    "#{window_name}",
    "#{pane_id}",
    "#{pane_active}",
    "#{window_active}",
    "#{session_attached}",
]
CONTEXT_KEYS = [
    "session_id",
    "session_name",
    "window_id",
    "window_index",
    "window_name",
    "pane_id",
    "pane_active",
    "window_active",
    "session_attached",
]


def current_context(pane: str | None) -> dict[str, str] | None:
    target = pane or os.environ.get("TMUX_PANE") or pane_from_tty()
    if not target:
        return None
    parts = tmux_query(target, CONTEXT_FIELDS)
    return dict(zip(CONTEXT_KEYS, parts, strict=True)) if parts else None


# ---------- event store (SQLite WAL) ----------

_CREATE_SQL = """
CREATE TABLE IF NOT EXISTS events (
    ts       INTEGER NOT NULL,
    session_id   TEXT NOT NULL DEFAULT '',
    session_name TEXT NOT NULL DEFAULT '',
    window_id    TEXT NOT NULL DEFAULT '',
    window_index TEXT NOT NULL DEFAULT '',
    window_name  TEXT NOT NULL DEFAULT '',
    pane_id      TEXT NOT NULL DEFAULT '',
    source       TEXT NOT NULL DEFAULT '',
    state        TEXT NOT NULL DEFAULT '',
    message      TEXT NOT NULL DEFAULT '',
    pid          INTEGER,
    synthetic    INTEGER NOT NULL DEFAULT 0,
    reason       TEXT NOT NULL DEFAULT ''
);
CREATE INDEX IF NOT EXISTS idx_events_window ON events(window_id);
"""


def _db() -> sqlite3.Connection:
    """Open (or create) the events database with WAL mode."""
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    conn = sqlite3.connect(str(DB_PATH), timeout=5)
    conn.execute("PRAGMA journal_mode=WAL")
    conn.executescript(_CREATE_SQL)
    return conn


def insert_event(
    *,
    session_id: str = "",
    session_name: str = "",
    window_id: str = "",
    window_index: str = "",
    window_name: str = "",
    pane_id: str = "",
    source: str = "",
    state: str = "",
    message: str = "",
    pid: int | None = None,
    synthetic: bool = False,
    reason: str = "",
) -> None:
    """Insert a single event row."""
    with _db() as conn:
        conn.execute(
            "INSERT INTO events (ts,session_id,session_name,window_id,window_index,"
            "window_name,pane_id,source,state,message,pid,synthetic,reason) "
            "VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?)",
            (
                int(time.time()),
                session_id,
                session_name,
                window_id,
                window_index,
                window_name,
                pane_id,
                source,
                state,
                message,
                pid,
                int(synthetic),
                reason,
            ),
        )


def prune_stale_events() -> None:
    """Remove events for windows that no longer exist and trim to MAX_EVENTS."""
    targets = set()
    out = tmux(["list-windows", "-a", "-F", "#{window_id}"], check=False)
    for line in out.splitlines():
        wid = line.strip()
        if wid:
            targets.add(wid)
    with _db() as conn:
        if targets:
            placeholders = ",".join("?" for _ in targets)
            conn.execute(
                f"DELETE FROM events WHERE window_id NOT IN ({placeholders})",
                list(targets),
            )
        else:
            conn.execute("DELETE FROM events")
        # Trim old events.
        conn.execute(
            "DELETE FROM events WHERE rowid NOT IN "
            "(SELECT rowid FROM events ORDER BY ts DESC LIMIT ?)",
            (MAX_EVENTS,),
        )


def clear_events_for_window(window_id: str) -> None:
    """Delete all events for a window."""
    with _db() as conn:
        conn.execute("DELETE FROM events WHERE window_id = ?", (window_id,))


def agent_pane_for_window(window_id: str) -> str:
    """The pane the agent most recently wrote from, empty when unrecorded.

    ``@agent_state`` is a *window* option, but "has the user seen it" is a
    question about a *pane*: in the documented split layout the agent owns
    one pane and the user sits in its sibling. The event rows are the only
    place that finer identity is kept, so the newest row carrying a
    ``pane_id`` is what the focus-clear consults.

    Newest-wins is what makes a restart self-heal: an agent that comes back
    up in a different pane writes a fresh event, and that row's pane
    immediately becomes the one focus has to match.
    """
    conn = _db()
    row = conn.execute(
        "SELECT pane_id FROM events WHERE window_id = ? AND pane_id != '' "
        "ORDER BY ts DESC, rowid DESC LIMIT 1",
        (window_id,),
    ).fetchone()
    return row[0] if row else ""


def recent_events(window_id: str, limit: int = PREVIEW_EVENTS) -> list[sqlite3.Row]:
    """The newest ``limit`` events for a window, oldest first."""
    conn = _db()
    conn.row_factory = sqlite3.Row
    rows = conn.execute(
        "SELECT ts, source, state, message, synthetic, reason FROM events "
        "WHERE window_id = ? ORDER BY ts DESC, rowid DESC LIMIT ?",
        (window_id, limit),
    ).fetchall()
    return list(reversed(rows))


def event_summary_by_window() -> dict[str, dict[str, object]]:
    """Latest timestamp, source, and message per window."""
    conn = _db()
    conn.row_factory = sqlite3.Row
    rows = conn.execute(
        "SELECT window_id, MAX(ts) as last_ts, source, message "
        "FROM events GROUP BY window_id"
    ).fetchall()
    return {
        row["window_id"]: {
            "last_ts": row["last_ts"],
            "src": row["source"] or "",
            "msg": row["message"] or "",
        }
        for row in rows
    }


# ---------- notifications ----------


def send_osc777(title: str, message: str) -> None:
    """Emit OSC 777 to the controlling TTY, wrapping in DCS passthrough inside tmux."""
    tty = find_tty()
    if not tty:
        return
    osc = f"\x1b]777;notify;{title};{message}\x07"
    if os.environ.get("TMUX"):
        osc = f"\x1bPtmux;\x1b{osc}\x1b\\"
    try:
        with open(tty, "w") as f:
            f.write(osc)
    except OSError:
        pass


def system_notifications_enabled() -> bool:
    # Desktop notifications are opt-in. Keep honoring the old disable flag as
    # an explicit off switch in case an environment enables them globally.
    if os.environ.get(DISABLE_SYSTEM_NOTIFY_ENV, "").strip().lower() in {
        "1",
        "true",
        "yes",
        "on",
    }:
        return False
    return os.environ.get(ENABLE_SYSTEM_NOTIFY_ENV, "").strip().lower() in {
        "1",
        "true",
        "yes",
        "on",
    }


def send_system_notification(fields: dict[str, object]) -> None:
    if not system_notifications_enabled():
        return

    title = str(fields.get("title") or "Agent notification")
    message = str(fields.get("message", ""))
    source = str(fields.get("source", ""))
    event_type = str(fields.get("type", ""))
    if source or event_type:
        prefix = f"[{source}/{event_type}]".strip("/")
        message = f"{prefix} {message}".strip()
    icon_title = f"🤖 {title}"

    osascript = shutil.which("osascript")
    notify_send = shutil.which("notify-send")
    try:
        if osascript:
            qt = json.dumps(icon_title)
            qm = json.dumps(message)
            subprocess.run(
                [osascript, "-e", f"display notification {qm} with title {qt}"],
                check=False,
                capture_output=True,
                text=True,
            )
        elif notify_send:
            subprocess.run(
                [notify_send, icon_title, message],
                check=False,
                capture_output=True,
                text=True,
            )
    except OSError:
        pass


# ---------- attention state on tmux side ----------


def set_state(window_id: str, state: AgentState | None) -> None:
    """Set @agent_state (and @pane_agent) on a tmux window.

    @pane_agent is sticky — once set it persists until the pane dies,
    so idle detection works even across container boundaries where
    process-tree scanning can't see the agent.
    """
    if state and state.visible:
        tmux(
            ["set-window-option", "-q", "-t", window_id, "@agent_state", state.name],
            check=False,
        )
        # Mark window as hosting an agent (sticky: survives state clears).
        tmux(
            ["set-window-option", "-q", "-t", window_id, "@pane_agent", "1"],
            check=False,
        )
    else:
        tmux(
            ["set-window-option", "-qu", "-t", window_id, "@agent_state"],
            check=False,
        )
        # @pane_agent intentionally NOT cleared — it's sticky.


def pane_exists(pane_id: str) -> bool:
    """True when *pane_id* still names a live pane on this server."""
    if not pane_id:
        return False
    return bool(
        tmux(["display-message", "-p", "-t", pane_id, "#{pane_id}"], check=False)
    )


def focus_counts_as_seen(window_id: str, focused_pane: str) -> bool:
    """Did focusing *focused_pane* mean the user looked at the agent?

    Only the agent's own pane counts. A sibling pane in the same window
    does not, and neither does a popup dismissal that hands focus back to
    the pane the user never left -- both used to clear the badge for a
    window the user had not so much as glanced at.

    Two inputs have no honest answer, and both fall back to clearing,
    which is the pre-fix behaviour:

      * **No recorded pane.** Nothing in the event store names the agent's
        pane -- a trimmed history, or a writer that never supplied one.
        Refusing to clear would strand a badge with no way to dismiss it,
        which is worse than clearing one early.
      * **The recorded pane is gone.** The agent's pane was closed, so
        there is nothing left to focus and the badge would be permanent.
        (A merely *stale* pane -- agent restarted elsewhere while the old
        pane lives on -- is not this case; it resolves itself on the
        restarted agent's first event.)
    """
    agent_pane = agent_pane_for_window(window_id)
    if not agent_pane:
        return True
    if agent_pane == focused_pane:
        return True
    return not pane_exists(agent_pane)


def clear_target(window_id: str, focused_pane: str = "") -> None:
    """Clear attention state for a window.

    Clears ``done``, ``blocked`` and ``crashed`` — these are "look at
    me" states the user acknowledges by focusing, and focusing is
    exactly the seen-signal ``done`` waits for.  ``working`` means the
    agent is still active; focusing doesn't change that.

    ``focused_pane`` is the pane a focus hook just landed on, and gates
    the clear through :func:`focus_counts_as_seen`. Callers that pass
    nothing are asking for an *explicit* clear -- the picker, or a
    hand-run ``clear-target`` -- where the user named the window rather
    than merely arriving near it, so no pane check applies.
    """
    cur = AgentState.parse(
        tmux(
            ["display-message", "-p", "-t", window_id, "#{@agent_state}"],
            check=False,
        )
    )
    if cur is AgentState.working:
        return
    if focused_pane and not focus_counts_as_seen(window_id, focused_pane):
        return
    set_state(window_id, None)
    clear_events_for_window(window_id)
    tmux(["refresh-client", "-S"], check=False)


def resolve_target(target: str) -> tuple[str | None, str] | None:
    target = target.strip()
    if not target:
        return None
    if ":" in target:
        sid, wid = target.split(":", 1)
        return (sid, wid) if sid and wid else None
    if target.startswith("@"):
        return None, target
    return None


# ---------- subcommands ----------


def read_stdin_payload() -> dict[str, object]:
    """Parse a JSON object piped on stdin, or return ``{}``.

    The opencode plugin (``opencode/.config/opencode/plugin/notify.ts``)
    invokes ``notify`` with no flags and pipes
    ``{source,type,title,message}`` on stdin, so without this the whole
    payload is discarded and every opencode event lands in the DB as
    ``source='agent' message='attention'``.

    Never blocks: an interactive stdin is skipped outright, a pipe with
    nothing ready is treated as absent (codex's hook inherits an idle
    stdin that may never close), and anything that isn't a JSON object is
    ignored so a stray pipe can't turn a notification into a traceback.
    """
    try:
        if sys.stdin is None or sys.stdin.isatty():
            return {}
        if not select.select([sys.stdin], [], [], 0.2)[0]:
            return {}
        raw = sys.stdin.read()
    except (OSError, ValueError):
        return {}
    if not raw.strip():
        return {}
    try:
        payload = json.loads(raw)
    except ValueError:
        return {}
    return payload if isinstance(payload, dict) else {}


def cmd_notify(args: argparse.Namespace) -> int:
    """Legacy notify path for non-pi agents (e.g. codex/opencode).

    Sets @agent_state=blocked and inserts a DB event.  Pi agents
    bypass this entirely and write tmux options + DB rows directly
    from the extension via the ``event`` subcommand.

    ``--title`` / ``--event-type`` come from the documented codex hook
    line (see tmux/README.md § Hook Setup); they name the harness and
    the reason it wants attention, so they feed the stored message and
    the (opt-in) desktop notification rather than being dropped.

    The same four fields may instead arrive as a JSON object on stdin,
    which is opencode's plugin form. Flags win over the payload, so the
    codex hook line behaves identically either way.
    """
    if not tmux_exists():
        return 0
    ctx = current_context(args.pane)
    if ctx is None:
        return 0

    payload = read_stdin_payload()

    def field(key: str, flag: str | None) -> str:
        """Flag, else the same-named stdin field, else empty."""
        if flag:
            return sanitize(flag)
        value = payload.get(key)
        return sanitize(value) if isinstance(value, str) else ""

    source = field("source", args.source) or "agent"
    title = field("title", args.title)
    # The payload spells the event type "type"; the flag is --event-type.
    event_type = field("type", args.event_type)
    message = field("message", args.message) or title or event_type or "attention"

    insert_event(
        session_id=ctx["session_id"],
        session_name=ctx["session_name"],
        window_id=ctx["window_id"],
        window_index=ctx["window_index"],
        window_name=ctx["window_name"],
        pane_id=ctx["pane_id"],
        source=source,
        state=AgentState.blocked.name,
        message=message,
    )
    set_state(ctx["window_id"], AgentState.blocked)
    send_system_notification(
        {
            "source": source,
            "type": event_type,
            "title": title or source,
            "message": message,
        }
    )
    tmux(["refresh-client", "-S"], check=False)
    return 0


def event_pane_id(pane: str | None, window_id: str) -> str:
    """The pane an ``event`` came from, for the focus-clear pane check.

    ``event`` is the pi path and takes a *window*, so unlike ``notify`` it
    never resolved a pane -- every row it wrote left ``pane_id`` empty,
    and a window whose only rows come from pi has no agent pane on record
    at all. Filling it in is what gives :func:`focus_counts_as_seen`
    something to compare against on the path most agents actually use.

    Order: the explicit flag, then ``TMUX_PANE`` (set in the agent's own
    pane, which is where the extension runs), then the window's active
    pane. The last is a guess and only right when the agent is the active
    pane at write time -- but ``working`` is written as the agent starts a
    turn, which is exactly when that tends to hold. An unresolvable pane
    yields "", which is the documented clear-anyway case.
    """
    candidate = pane or os.environ.get("TMUX_PANE")
    if candidate:
        parts = tmux_query(candidate, ["#{pane_id}"])
        if parts:
            return parts[0]
    parts = tmux_query(window_id, ["#{pane_id}"])
    return parts[0] if parts else ""


def cmd_event(args: argparse.Namespace) -> int:
    """Record an event and set @agent_state.  Called by the pi extension.

    Unlike ``notify``, this takes explicit --window and --state flags
    and does not resolve pane context.  Handles
    working/done/blocked/cleared transitions and sets @pane_agent as a
    sticky marker.
    """
    if not tmux_exists():
        return 0
    window_id = args.window
    state = args.state
    # Resolve session context from window_id.
    ctx_raw = tmux_query(
        window_id,
        [
            "#{session_id}",
            "#{session_name}",
            "#{window_index}",
            "#{window_name}",
        ],
    )
    if not ctx_raw:
        return 0
    sid, sname, widx, wname = ctx_raw

    insert_event(
        session_id=sid,
        session_name=sname,
        window_id=window_id,
        window_index=widx,
        window_name=wname,
        pane_id=event_pane_id(args.pane, window_id),
        source="pi",
        state=state,
        message=state,
        pid=args.pid,
    )
    if state == "cleared":
        set_state(window_id, None)
    elif state == "done":
        set_state(window_id, AgentState.done)
    elif state == "blocked":
        set_state(window_id, AgentState.blocked)
    elif state == "working":
        set_state(window_id, AgentState.working)
    tmux(["refresh-client", "-S"], check=False)
    return 0


# ---------- reaper and reconciler ----------


def pid_alive(pid: int) -> bool:
    """Check whether a process is still running (zero-fork, one syscall)."""
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        # Different uid but pid exists — treat as alive to be safe.
        return True
    except (OSError, TypeError, ValueError):
        return False


class WindowState(NamedTuple):
    state: AgentState | None
    event: sqlite3.Row | None


def compute_window_state(events: list[sqlite3.Row]) -> WindowState:
    """Determine the current state for a window from its events.

    Scans newest-first.  Rules:
      - blocked: terminal, wins immediately.
      - done: terminal, wins immediately (finished but not yet seen).
      - cleared: resets to none.
      - crashed (synthesized): sticky, wins.
      - working: only if pid is still alive; otherwise synthesize crashed.

    ``done`` is handled here even though the pi extension writes it
    straight to the tmux option: any source (an older or newer
    extension, the legacy notify path, a manual ``event --state done``)
    can land one in the DB, and an unrecognized state must not wedge
    the scan.
    """
    for event in reversed(events):
        state = AgentState.parse(event["state"], AgentState.blocked)
        if state is AgentState.blocked:
            return WindowState(AgentState.blocked, event)
        if state is AgentState.done:
            return WindowState(AgentState.done, event)
        if state is AgentState.cleared:
            return WindowState(None, None)
        if state is AgentState.crashed:
            return WindowState(AgentState.crashed, event)
        if state is AgentState.working:
            pid = to_int(event["pid"] or 0, 0)
            if pid > 0 and pid_alive(pid):
                return WindowState(AgentState.working, event)
            return WindowState(AgentState.crashed, event)
    return WindowState(None, None)


def synthesize_crash(source_event: sqlite3.Row, *, reason: str = "pid_gone") -> None:
    """Insert a synthetic crashed event from a stale working event."""
    insert_event(
        session_id=source_event["session_id"],
        session_name=source_event["session_name"],
        window_id=source_event["window_id"],
        window_index=source_event["window_index"],
        window_name=source_event["window_name"],
        pane_id=source_event["pane_id"],
        source=source_event["source"] or "reaper",
        state=AgentState.crashed.name,
        message=f"crashed ({reason})",
        pid=source_event["pid"],
        synthetic=True,
        reason=reason,
    )


def reconcile_window_states() -> AgentStats:
    """Detect crashes and count window states for the status segment.

    The extension is the authoritative writer of @agent_state for
    normal transitions (working/blocked/cleared).  The reconciler
    only writes @agent_state when it detects a crash (pid gone while
    working).  For all other states it reads the tmux option without
    overwriting it.

    Returns {state: count} for the status pill.
    """
    prune_stale_events()

    # --- crash detection from DB ---
    conn = _db()
    conn.row_factory = sqlite3.Row
    window_ids = [
        row[0]
        for row in conn.execute("SELECT DISTINCT window_id FROM events").fetchall()
    ]
    for wid in window_ids:
        win_events = conn.execute(
            "SELECT * FROM events WHERE window_id = ? ORDER BY ts ASC",
            (wid,),
        ).fetchall()
        ws = compute_window_state(win_events)
        if ws.state is AgentState.crashed and ws.event and not ws.event["synthetic"]:
            set_state(wid, AgentState.crashed)
            synthesize_crash(ws.event)
            send_system_notification(
                {
                    "source": ws.event["source"] or "reaper",
                    "type": "crashed",
                    "title": "Pi",
                    "message": f"crashed (pid {ws.event['pid']} gone)",
                }
            )
            send_osc777("Pi", f"crashed (pid {ws.event['pid']} gone)")

    # --- count states from tmux options (authoritative) ---
    return scan_agent_states()


def cmd_status(_: argparse.Namespace) -> int:
    if not tmux_exists():
        return 0
    stats = reconcile_window_states()
    # One line per non-zero state, most urgent first. Empty output keeps its
    # meaning: no agents at all, so the status segment hides itself.
    # STATE_GLYPH's keys are exactly the displayable states; AgentState's int
    # value is the urgency order.
    lines = [
        f"{state.name}\t{getattr(stats, state.name, 0)}"
        for state in sorted(STATE_GLYPH, reverse=True)
        if getattr(stats, state.name, 0)
    ]
    print("\n".join(lines), end="")
    return 0


def cmd_clear_current(args: argparse.Namespace) -> int:
    if not tmux_exists():
        return 0
    # Tmux hooks run as a server subprocess, so TMUX_PANE is not set and
    # find_tty() can't resolve the focused pane. The hooks pass the
    # target pane explicitly via --pane #{pane_id}.
    ctx = current_context(args.pane)
    if ctx is None:
        return 0
    clear_target(ctx["window_id"], ctx["pane_id"])
    return 0


def cmd_clear_target(args: argparse.Namespace) -> int:
    if not tmux_exists():
        return 0
    resolved = resolve_target(args.target)
    if resolved is None:
        return 1
    clear_target(resolved[1])
    return 0


# ---------- menu ----------


def format_relative(ts: int) -> str:
    if ts <= 0:
        return ""
    age = max(0, int(time.time()) - ts)
    if age < 60:
        return f"{age}s"
    if age < 3600:
        return f"{age // 60}m"
    if age < 86400:
        return f"{age // 3600}h"
    return f"{age // 86400}d"


# Dim/accent colours for the preview body, matching the picker's palette use.
_PREVIEW_DIM = "\033[2m"
_PREVIEW_RESET = "\033[0m"


def _state_transition(prev: str, cur: str) -> str:
    """Render "prev → cur", or just the state on the first/unchanged event."""
    cur = sanitize(cur)
    prev = sanitize(prev)
    if not cur:
        return ""
    if prev and prev != cur:
        return f"{prev} → {cur}"
    return cur


def render_preview(window_id: str) -> list[str]:
    """Lines of recent event history for one window, for the fzf preview pane.

    Every field that originates outside this script (source, state,
    message, reason) goes through ``scrub_untrusted`` before it is
    printed: agents author these strings, and the preview writes straight
    to a terminal. Only our own colour codes survive.
    """
    rows = recent_events(window_id)
    if not rows:
        return [f"{_PREVIEW_DIM}no recorded events for this window{_PREVIEW_RESET}"]

    entries: list[tuple[str, str, str, str]] = []
    prev_state = ""
    for row in rows:
        age = format_relative(to_int(row["ts"])) or "?"
        source = scrub_untrusted(row["source"] or "", 12) or "-"
        transition = scrub_untrusted(_state_transition(prev_state, row["state"] or ""))
        message = scrub_untrusted(row["message"] or "", PREVIEW_MSG_MAX)
        if to_int(row["synthetic"]):
            reason = scrub_untrusted(row["reason"] or "", 40)
            marker = f"(synthetic{': ' + reason if reason else ''})"
            message = f"{message} {marker}".strip()
        entries.append((age, source, transition, message))
        if row["state"]:
            prev_state = row["state"]

    age_w = max(len(e[0]) for e in entries)
    src_w = max(len(e[1]) for e in entries)
    trans_w = max(len(e[2]) for e in entries)
    lines: list[str] = []
    for age, source, transition, message in entries:
        head = f"{age:>{age_w}}  {source:<{src_w}}  {transition:<{trans_w}}"
        lines.append(f"{_PREVIEW_DIM}{head}{_PREVIEW_RESET}  {message}".rstrip())
    return lines


def cmd_preview(args: argparse.Namespace) -> int:
    """Print the event history for one picker row (fzf --preview target)."""
    resolved = resolve_target(args.target)
    if resolved is None:
        return 0
    for line in render_preview(resolved[1]):
        print(line)
    return 0


def attention_windows() -> list[dict[str, str]]:
    out = tmux(
        [
            "list-windows",
            "-a",
            "-F",
            "#{session_id}\t#{session_name}\t#{window_id}\t#{window_index}\t#{window_name}\t#{@agent_state}",
        ],
        check=False,
    )
    windows: list[dict[str, str]] = []
    for row in out.splitlines():
        parts = row.split("\t")
        if len(parts) == 6:
            ws = AgentState.parse(parts[5])
            if ws and ws.visible:
                windows.append(
                    {
                        "session_id": parts[0],
                        "session_name": parts[1],
                        "window_id": parts[2],
                        "window_index": parts[3],
                        "window_name": parts[4],
                        "state": parts[5],
                    }
                )
    return windows


# ANSI-colored glyphs for fzf --ansi display.
STATE_GLYPH_ANSI: dict[AgentState, str] = {
    AgentState.crashed: f"\033[1;31m{STATE_GLYPH[AgentState.crashed]}\033[0m",
    AgentState.blocked: f"\033[33m{STATE_GLYPH[AgentState.blocked]}\033[0m",
    # teal, matching the done glyph colour in .tmux.conf's @agent_glyphs.
    AgentState.done: f"\033[36m{STATE_GLYPH[AgentState.done]}\033[0m",
    AgentState.working: STATE_GLYPH[AgentState.working],
    AgentState.idle: f"\033[2m{STATE_GLYPH[AgentState.idle]}\033[0m",
}


class PickerRow(NamedTuple):
    """Structured data for one row in the prefix+a picker."""

    target: str  # sid:wid for tmux switch-client
    state: AgentState  # state this row represents (idle for the ps-scan rows)
    glyph: str  # ANSI-colored state glyph
    location: str  # session:window_index
    name: str  # window name
    age: str  # relative timestamp
    sort_key: tuple[int, int, int]  # (-urgency, is_mu, -last_ts)


def build_menu_rows() -> list[PickerRow]:
    """Active-state rows for the picker, sorted by urgency then recency."""
    prune_stale_events()
    summary = event_summary_by_window()

    rows: list[PickerRow] = []
    for window in attention_windows():
        sid, wid = window["session_id"], window["window_id"]
        sname = window["session_name"]
        ws = AgentState.parse(window.get("state"), AgentState.blocked)
        urgency = int(ws) if ws else 0
        is_mu = 1 if sname.startswith("mu-") else 0
        details = summary.get(wid, {})
        last_ts = to_int(details.get("last_ts", 0))
        glyph = STATE_GLYPH_ANSI.get(ws, "?") if ws else "?"
        rows.append(
            PickerRow(
                target=f"{sid}:{wid}",
                state=ws or AgentState.blocked,
                glyph=glyph,
                location=f"{sname}:{window['window_index']}",
                name=window["window_name"],
                age=format_relative(last_ts) if last_ts else "",
                sort_key=(-urgency, is_mu, -last_ts),
            )
        )
    rows.sort(key=lambda r: r.sort_key)
    return rows


def idle_agent_rows(exclude_windows: set[str]) -> list[PickerRow]:
    """Idle agent rows for the picker.

    Two detection paths:
      1. Process-tree scan (``ps`` snapshot) — works for native panes.
      2. ``@pane_agent`` tmux option — set by the push path, survives
         container boundaries where the process tree is invisible.
    """
    out = tmux(
        [
            "list-panes",
            "-a",
            "-F",
            "#{session_id}\t#{session_name}\t#{window_id}\t#{window_index}"
            "\t#{window_name}\t#{pane_pid}\t#{pane_id}\t#{@pane_agent}",
        ],
        check=False,
    )
    if not out:
        return []

    ps = ProcessSnapshot()
    rows: list[PickerRow] = []
    seen_windows: set[str] = set()
    for line in out.splitlines():
        parts = line.split("\t")
        if len(parts) != 8:
            continue
        sid, sname, wid, widx, wname, pane_pid, _pane_id, pane_agent = parts
        if wid in exclude_windows or wid in seen_windows:
            continue
        agent = ps.detect_agent(pane_pid)
        if not agent and pane_agent == "1":
            agent = wname or "agent"
        if agent:
            seen_windows.add(wid)
            is_mu = 1 if sname.startswith("mu-") else 0
            rows.append(
                PickerRow(
                    target=f"{sid}:{wid}",
                    state=AgentState.idle,
                    glyph=STATE_GLYPH_ANSI.get(
                        AgentState.idle, STATE_GLYPH[AgentState.idle]
                    ),
                    location=f"{sname}:{widx}",
                    name=wname,
                    age="",
                    sort_key=(0, is_mu, 0),
                )
            )
    rows.sort(key=lambda r: r.sort_key)
    return rows


# Row gutter glyph for the window the client is currently on, so you can
# see where you are in the list (herdr renders the same diamond). Always
# one column wide, and always one of these two literals: the gutter is
# script-generated and must never carry agent-authored text.
CURRENT_MARKER = "\u25c6"  # ◆


def current_window_id() -> str:
    """Window id the invoking client is on, "" when it cannot be resolved.

    ``TMUX_PANE`` first: the picker (and every fzf reload it spawns)
    inherits it from the pane it was launched in, which is the pane whose
    window the marker is about. Without it, display-message falls back to
    tmux's own idea of the current client, which is right for an
    interactive run and harmlessly empty otherwise.
    """
    parts = tmux_query(os.environ.get("TMUX_PANE"), ["#{window_id}"])
    return sanitize(parts[0]) if parts else ""


def format_picker_rows(
    rows: list[PickerRow], current: str = ""
) -> list[tuple[str, str]]:
    """Format rows with aligned columns for fzf display.

    ``current`` is a window id (``@N``); its row gets the gutter marker.
    """
    if not rows:
        return []
    # Window and session names are user/agent-settable, so they are scrubbed
    # for the same reason the preview scrubs messages: a tab would forge a
    # row boundary and an ESC could repaint the picker. Widths are measured
    # on the scrubbed strings; the gutter is a fixed one-column field, so it
    # shifts every row equally and leaves that alignment intact.
    cells = [(r, scrub_untrusted(r.location), scrub_untrusted(r.name)) for r in rows]
    loc_w = max(len(loc) for _, loc, _ in cells)
    name_w = max(len(name) for _, _, name in cells)
    result: list[tuple[str, str]] = []
    for r, loc, name in cells:
        age_part = f"  {r.age:>3}" if r.age else "     "
        gutter = CURRENT_MARKER if current and r.target.endswith(f":{current}") else " "
        label = f"{gutter} {r.glyph} {loc:<{loc_w}}  {name:<{name_w}}{age_part}"
        result.append((r.target, label))
    return result


def picker_rows(state_filter: AgentState | None = None) -> list[PickerRow]:
    """Every row the picker can show, active first then idle.

    One server scan feeds both halves: ``PickerRow.target`` is
    "<session_id>:<window_id>", and those window ids are exactly the ones
    ``attention_windows()`` just returned, so they are reused to exclude
    active windows from the idle pass instead of scanning again. A second
    scan also opened a TOCTOU gap where a state change between calls could
    list the same window as both active and idle.

    ``state_filter`` narrows the result *after* that single scan, so the
    invariant holds no matter which filter the caller asks for.
    """
    active = build_menu_rows()
    active_wids = {r.target.split(":", 1)[1] for r in active}
    rows = active + idle_agent_rows(active_wids)
    if state_filter is not None:
        rows = [r for r in rows if r.state is state_filter]
    return rows


def cmd_menu_rows(args: argparse.Namespace) -> int:
    """Print the picker rows fzf consumes on stdin: "<target>\\t<label>".

    Split out of cmd_menu so the rows have a source fzf reload binds can
    call, and so the formatting is testable without driving a terminal UI.
    """
    if not tmux_exists():
        return 0
    state_filter = AgentState.parse(getattr(args, "filter", None))
    current = current_window_id()
    for target, label in format_picker_rows(picker_rows(state_filter), current):
        print(f"{target}\t{label}")
    return 0


def menu_rows_command(state_filter: AgentState | None = None) -> list[str]:
    """Argv that re-invokes this script's ``menu-rows`` subcommand."""
    argv = [sys.executable, str(Path(__file__).resolve()), "menu-rows"]
    if state_filter is not None:
        argv += ["--filter", state_filter.name]
    return argv


# State filter keys, an axis separate from the text query: pressing ctrl-b
# shows blocked agents, it does not search for the word "blocked" (which
# would also match a window merely *named* "blocked"). None means "all".
#
# Every one of these except ctrl-x shadows an fzf default (ctrl-a
# beginning-of-line, ctrl-b backward-char, ctrl-w unix-word-rubout, ctrl-d
# delete-char/eof). That is deliberate and cheap here: the picker's query is
# a word or two, home/left/bspace still do those jobs, and shadowing ctrl-d
# removes fzf's eof behaviour where a ctrl-d on an empty query closes the
# picker. ctrl-a for "all" also matches tms's picker.
FILTER_KEYS: dict[str, AgentState | None] = {
    "ctrl-a": None,
    "ctrl-b": AgentState.blocked,
    "ctrl-w": AgentState.working,
    "ctrl-d": AgentState.done,
    "ctrl-x": AgentState.crashed,
}


def picker_prompt(state_filter: AgentState | None, counts: str) -> str:
    """Prompt for one filter axis position.

    Unfiltered shows the server-wide state tally; a filter shows its chip
    (glyph + label) instead, so the active axis is readable at a glance
    without hunting for which rows disappeared.
    """
    if state_filter is not None:
        return f"{STATE_GLYPH.get(state_filter, '?')} {state_filter.name} > "
    return f"Agent state ({counts}) > " if counts else "Agent state > "


def filter_binds(counts: str) -> list[str]:
    """``--bind`` argv pairs wiring FILTER_KEYS to prompt swap + reload.

    change-prompt uses ``|`` delimiters because the unfiltered prompt
    carries parentheses around the counts, which fzf's ``(...)`` form would
    have to balance.
    """
    args: list[str] = []
    for key, state in FILTER_KEYS.items():
        reload = " ".join(shlex.quote(p) for p in menu_rows_command(state))
        args += [
            "--bind",
            f"{key}:change-prompt|{picker_prompt(state, counts)}|+reload|{reload}|",
        ]
    return args


def preview_command() -> str:
    """Shell command string fzf runs for ``--preview``.

    fzf runs this through ``sh -c``, so the fixed parts are quoted here and
    the only interpolation is fzf's own ``{1}`` field, which fzf quotes for
    us. ``{1}`` is the target column, which this script generates
    ("<session_id>:<window_id>") — never agent-authored text.
    """
    argv = [
        shlex.quote(part) for part in (sys.executable, str(Path(__file__).resolve()))
    ]
    return f"{' '.join(argv)} preview {{1}}"


def cmd_menu(_: argparse.Namespace) -> int:
    if not tmux_exists():
        return 0

    chooser_input = subprocess.run(
        menu_rows_command(),
        text=True,
        stdout=subprocess.PIPE,
    ).stdout.rstrip("\n")

    if not chooser_input:
        print("No agent windows found.")
        return 0

    fzf = shutil.which("fzf")
    if fzf is None:
        for line in chooser_input.splitlines():
            print(line.split("\t", 1)[1] if "\t" in line else line)
        return 0

    # Build prompt with state counts. This scan is not redundant with the
    # rows above: it counts every window on the server, including ones the
    # picker does not list.
    stats = scan_agent_states()
    prompt_parts: list[str] = []
    for state in (
        AgentState.crashed,
        AgentState.blocked,
        AgentState.done,
        AgentState.working,
        AgentState.idle,
    ):
        n = getattr(stats, state.name, 0)
        if n:
            prompt_parts.append(f"{STATE_GLYPH.get(state, '?')}{n}")
    counts = " ".join(prompt_parts)
    prompt = picker_prompt(None, counts)

    env = {k: v for k, v in os.environ.items() if not k.startswith("FZF_DEFAULT_OPTS")}
    selection = subprocess.run(
        [
            fzf,
            "--delimiter",
            "\t",
            "--with-nth",
            "2..",
            "--prompt",
            prompt,
            "--border",
            "--no-sort",
            "--layout",
            "reverse",
            "--ansi",
            "--bind",
            "enter:accept",
            *filter_binds(counts),
            "--no-select-1",
            "--no-exit-0",
            "--preview-window",
            "right:55%,border-left",
            "--preview",
            preview_command(),
        ],
        input=chooser_input,
        text=True,
        stdout=subprocess.PIPE,
        env=env,
    )
    if selection.returncode != 0 or not selection.stdout.strip():
        return 0

    target = selection.stdout.strip().split("\t", 1)[0].strip()
    resolved = resolve_target(target)
    if resolved is None:
        return 0
    sid, wid = resolved
    tmux(["switch-client", "-t", f"{sid}:{wid}"], check=False)
    clear_target(wid)
    return 0


# ---------- argparse ----------


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)

    notify = sub.add_parser(
        "notify", help="Record a new attention event for the current tmux window"
    )
    notify.add_argument(
        "--pane", help="Explicit tmux pane target (defaults to TMUX_PANE)"
    )
    notify.add_argument("--source", help="Event source, e.g. codex/opencode/pi")
    notify.add_argument("--event-type", help="Event type")
    notify.add_argument("--title", help="Event title")
    notify.add_argument("--message", help="Event message")
    notify.set_defaults(func=cmd_notify)

    event = sub.add_parser(
        "event", help="Record a state event (called by pi extension)"
    )
    event.add_argument("--window", required=True, help="tmux window id")
    event.add_argument(
        "--pane",
        help=(
            "Pane the agent occupies (defaults to TMUX_PANE, else the "
            "window's active pane). Recorded so the focus-clear can tell "
            "the agent's pane from its siblings."
        ),
    )
    event.add_argument(
        "--state",
        required=True,
        choices=["working", "done", "blocked", "cleared"],
        help="Agent state",
    )
    event.add_argument("--pid", type=int, default=None, help="Agent process pid")
    event.set_defaults(func=cmd_event)

    sub.add_parser("status", help="Render status-right segment").set_defaults(
        func=cmd_status
    )

    sub.add_parser(
        "menu", help="Open chooser for attention windows and jump"
    ).set_defaults(func=cmd_menu)

    preview = sub.add_parser(
        "preview", help="Print recent event history for one window (fzf preview)"
    )
    preview.add_argument(
        "target", help="Target in the form <session_id>:<window_id> or <window_id>"
    )
    preview.set_defaults(func=cmd_preview)

    menu_rows = sub.add_parser(
        "menu-rows", help="Print the picker rows (tab-delimited target + label)"
    )
    menu_rows.add_argument(
        "--filter",
        choices=[s.name for s in STATE_GLYPH],
        help="Only print rows in this agent state",
    )
    menu_rows.set_defaults(func=cmd_menu_rows)

    clear_current = sub.add_parser(
        "clear-current", help="Clear attention for current window"
    )
    clear_current.add_argument(
        "--pane",
        help=(
            "Explicit tmux pane target (defaults to TMUX_PANE or controlling "
            "TTY). Tmux hooks should pass --pane #{pane_id} so the script can "
            "resolve the focused pane without env inheritance."
        ),
    )
    clear_current.set_defaults(func=cmd_clear_current)

    clear_t = sub.add_parser("clear-target", help="Clear attention for explicit target")
    clear_t.add_argument(
        "target", help="Target in the form <session_id>:<window_id> or <window_id>"
    )
    clear_t.set_defaults(func=cmd_clear_target)

    return parser


def main() -> int:
    args = build_parser().parse_args()
    return int(args.func(args))


if __name__ == "__main__":
    raise SystemExit(main())
