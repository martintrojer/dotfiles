#!/usr/bin/env python3
"""Render a smarter tmux window label from active-pane metadata.

Called per visible window from window-status-format, with the window
id as the only argument. Every other field is fetched by asking tmux
directly.

Usage:
    status-window-label <window_id>

Why the window id and nothing else -- SECURITY. This script is invoked
from a ``#(...)`` inside a format string. tmux expands ``#{...}``
fields into that command line and hands the finished string to
``sh -c``: there is no argv array, so there is nothing quoting can
protect. Any field an in-pane program can write (``pane_title`` via a
bare OSC 2 escape, ``pane_current_path`` via a hostile directory name,
``window_name``) is therefore arbitrary shell, executed as the tmux
server user on every status redraw. ``window_id`` is minted by tmux
itself and matches ``@[0-9]+``, so it is the one value safe to
interpolate. Everything else arrives over a ``display-message`` pipe,
where it is data and never a command line.

Customise the agent/editor/shell lists by exporting the matching env
vars before tmux starts (space-separated):

    export TMUX_LABEL_AGENTS="codex pi opencode aider"

Why a Python rewrite of a former /bin/sh script: the bash version
embedded an awk BFS over ps output to find an agent in a pane's
descendant process tree. ps-pipeline + awk is the classic shell smell
flagged in AGENTS.md; the Python version keeps the same algorithm
with explicit data structures and shares the status-bar error
plumbing (`EXPECTED_ERRORS`, `log_error`) with the rest of the tmux
status scripts.
"""

from __future__ import annotations

import os
import sys

from _status_common import EXPECTED_ERRORS, log_error
from _tmux_common import AGENT_COMMANDS, AGENT_WRAPPERS, ProcessSnapshot, tmux_cmd

# ---------------------------------------------------------------------
# Configurable word lists. Defaults match the bash version; env-var
# overrides preserve the previous customisation contract.
# ---------------------------------------------------------------------


def _env_list(name: str, default: str) -> tuple[str, ...]:
    return tuple(os.environ.get(name, default).split())


SHELLS = _env_list("TMUX_LABEL_SHELLS", "zsh bash sh fish nu")
EDITORS = _env_list("TMUX_LABEL_EDITORS", "nvim vim vi hx helix kak emacs nano")
AGENTS = AGENT_COMMANDS
_AGENT_WRAPPERS = AGENT_WRAPPERS
# Helpers an agent may exec into (man/less/etc); same descendant-walk
# trigger so the label keeps tracking the agent through helper drilldowns.
AGENT_HELPERS = _env_list("TMUX_LABEL_AGENT_HELPERS", "less more man")


# ---------------------------------------------------------------------
# Predicates
# ---------------------------------------------------------------------


def has_meaningful_title(pane_title: str, host_name: str) -> bool:
    """`pane_title` is meaningful when it's non-empty, isn't the host
    name, and doesn't look like a path-ish leftover (``:/foo``, ``/foo``,
    ``~/foo``).
    """
    if not pane_title or pane_title == host_name:
        return False
    return not pane_title.startswith((":", "/", "~"))


def detect_agent_in_tree(root_pid: str, agents: tuple[str, ...]) -> str | None:
    """Walk the descendant process tree of ``root_pid``; return the
    first descendant command matching ``agents`` (basename match), or
    ``None``.

    Delegates to ``ProcessSnapshot`` from ``_tmux_common``. Each call
    within the same process reuses the cached snapshot.
    """
    return _ps_snapshot.detect_agent(root_pid, agents)


_ps_snapshot = ProcessSnapshot()


# ---------------------------------------------------------------------
# Field fetch (see the module docstring for why this is not argv)
# ---------------------------------------------------------------------

# SOH as the field separator. tmux refuses to store control characters
# in a pane title or a window name, so the only field that could smuggle
# one in is pane_current_path -- which is last, and absorbs any surplus
# via the split's maxsplit.
_FIELD_SEP = "\x01"
_FIELDS = (
    "window_name",
    "pane_current_command",
    "host",
    "pane_pid",
    "pane_title",
    "pane_current_path",
)


def fetch_fields(window_id: str) -> dict[str, str]:
    """Ask tmux for the active-pane fields of ``window_id``.

    Returns empty strings for every field when the window is gone or
    tmux cannot be reached, so the caller still renders *something*.
    """
    blank = dict.fromkeys(_FIELDS, "")
    if not window_id:
        return blank
    fmt = _FIELD_SEP.join(f"#{{{name}}}" for name in _FIELDS)
    result = tmux_cmd("display-message", "-p", "-t", window_id, fmt, check=False)
    if result.returncode != 0:
        return blank
    # display-message adds exactly one trailing newline; a path may
    # legitimately end in one, so strip a single character, not a run.
    raw = result.stdout
    if raw.endswith("\n"):
        raw = raw[:-1]
    parts = raw.split(_FIELD_SEP, len(_FIELDS) - 1)
    if len(parts) != len(_FIELDS):
        return blank
    return dict(zip(_FIELDS, parts, strict=True))


# ---------------------------------------------------------------------
# Main label dispatch (mirrors the bash precedence chain)
# ---------------------------------------------------------------------


def render(
    *,
    window_name: str,
    pane_current_command: str,
    pane_title: str,
    pane_current_path: str,
    host_name: str,
    pane_pid: str,
) -> str:
    path_base = pane_current_path.rsplit("/", 1)[-1] if pane_current_path else ""
    meaningful = has_meaningful_title(pane_title, host_name)

    # Editors: always show their own command (nvim/vim/etc.).
    if pane_current_command in EDITORS:
        return pane_current_command

    # Shells: prefer the user-set title, fall back to cwd basename,
    # then window name, then the shell command itself.
    if pane_current_command in SHELLS:
        if meaningful:
            return pane_title
        if path_base:
            return path_base
        if window_name:
            return window_name
        return pane_current_command

    # Agent-likely: window name or active command suggests an agent
    # (or its wrapper / helper). Walk the descendant tree first;
    # pane_title / window_name can be stale here.
    if (
        window_name in AGENTS
        or pane_current_command in _AGENT_WRAPPERS
        or pane_current_command in AGENT_HELPERS
    ):
        detected = detect_agent_in_tree(pane_pid, AGENTS)
        if detected:
            return detected
        if meaningful:
            return pane_title
        if (
            pane_current_command in _AGENT_WRAPPERS
            or pane_current_command in AGENT_HELPERS
        ):
            return window_name
        if pane_current_command:
            return pane_current_command
        return window_name

    # Default fallback chain for everything else.
    if meaningful:
        return pane_title
    if pane_current_command:
        return pane_current_command
    if path_base:
        return path_base
    return window_name


def main(argv: list[str]) -> int:
    window_id = argv[0] if argv else ""
    fields = fetch_fields(window_id)
    try:
        label = render(
            window_name=fields["window_name"],
            pane_current_command=fields["pane_current_command"],
            pane_title=fields["pane_title"],
            pane_current_path=fields["pane_current_path"],
            host_name=fields["host"],
            pane_pid=fields["pane_pid"],
        )
    except EXPECTED_ERRORS as exc:
        log_error("status-window-label", f"render failed: {exc!r}")
        # Best-effort fallback: print whatever window_name we got.
        label = fields["window_name"]

    # Set @pane_agent on the window so tmux format conditionals can
    # show an idle marker when no @agent_state is active.
    #
    # Set-only, never unset: @pane_agent is sticky by contract (see
    # set_state in agent-attention). This renderer runs on every status
    # redraw and often can't see the agent -- it runs in a container, the
    # pane has a meaningful title, or the shell branch returns a cwd
    # basename -- so clearing here would wipe the marker the push path
    # set and drop idle agents from the prefix+a picker and status pill.
    if window_id and label in AGENTS:
        tmux_cmd(
            "set-window-option",
            "-q",
            "-t",
            window_id,
            "@pane_agent",
            "1",
            check=False,
        )

    sys.stdout.write(label)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
