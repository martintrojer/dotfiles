#!/bin/sh
# Slim tmux status-right watchdog for the agent-state segment.
#
# WHY THIS IS sh, NOT PYTHON
# --------------------------
# This segment used to call `murmur status` on every render. murmur is
# a Node CLI, and a Node process start loads a couple of hundred shared
# libraries before it runs a line of murmur's own code. That makes the
# per-render cost a PROCESS cost, not a milliseconds-of-work cost --
# which matters because anything auditing process starts (and plenty
# does) multiplies it again. Measured here: this one segment accounted
# for most of a core, nearly all of which went away when the murmur
# call was stubbed out.
#
# The interpreter was never the lever. A Python cold-start is real but
# small beside the Node exec underneath it, so no choice of interpreter
# -- and no faster rewrite of murmur -- reaches this. Only not running
# murmur per-tick does.
#
# The tick is also not what status-interval suggests. tmux re-renders
# status-right on pane and window events too: a 14-window session was
# measured running this script 36 times in 30s (1.2/s) against the 6
# the 5s interval implies. Decoupling the murmur exec rate from the
# render rate is the whole fix.
#
# CONTRACT WITH THE POLLER
# ------------------------
# There is no render file to cat: this segment publishes through the
# @ai_status tmux option (.tmux.conf reads #{E:@ai_status}), and
# status-ai-poller writes that option directly. So the hot path here is
# *nothing* -- the bar is already painted from the option before this
# script runs. All this does is the liveness probe that keeps the
# poller alive.
#
# Steady state is therefore one `read` builtin and one `kill -0`
# syscall: no fork, no exec, no Python, no Node.

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/tmux-ai"
PID_FILE="$STATE_DIR/poller.pid"
POLLER="${0%/*}/status-ai-poller"

# Watchdog: respawn only when the poller is actually dead. kill -0 is a
# pure syscall; the rate-limited Python --ensure path runs at most once
# per crash, never per tick.
# read is a shell builtin (no fork); a missing pid file just leaves
# $pid empty and the redirection error is swallowed. The 2>/dev/null
# precedes the input redirect on purpose: redirections are applied
# left to right, so a trailing one is not yet in effect when the
# failing open is reported and the error reaches the terminal.
pid=''
read -r pid 2>/dev/null <"$PID_FILE" || true
if ! { [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; }; then
	[ -x "$POLLER" ] && "$POLLER" --ensure >/dev/null 2>&1 &
fi

exit 0
