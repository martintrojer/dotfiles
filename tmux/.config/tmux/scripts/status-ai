#!/usr/bin/env python3
"""Render the tmux AI agent-state status segment.

Reads the reconciled output from ``agent-attention status``, which emits one
``<state>\t<count>`` line per non-zero state, most urgent first (crashed /
blocked / done / working / idle).  No output at all means no agents.

Sets two tmux user options so ``.tmux.conf`` can render the segment with
palette colors via conditionals:

  @ai_status       — content text like "AI ✗ 2" (empty when no agents)
  @ai_status_state — state name for color selection (empty when no agents)

No colors here — ``.tmux.conf`` owns the palette.
"""

from __future__ import annotations

import subprocess
from pathlib import Path

from _status_common import EXPECTED_ERRORS, log_error
from _tmux_common import STATE_GLYPH, AgentState, tmux_cmd

SCRIPT = Path(__file__).with_name("agent-attention")


def render(raw: str) -> tuple[str, str]:
    """Build the segment from a closed vocabulary: glyphs, digits, spaces.

    ``.tmux.conf`` reads @ai_status through ``#{E:...}``, which re-expands the
    full tmux format language -- ``#(...)`` in the value is executed as a shell
    command on every status refresh. So nothing from the upstream string may be
    echoed through: an unparseable state or a non-numeric count becomes "?".

    Input is multi-line (one state per line); every line is validated and any
    line that does not parse is dropped rather than echoed.
    """
    counts: dict[AgentState, str] = {}
    for line in raw.splitlines():
        state_str, tab, count_str = line.partition("\t")
        if not tab:
            continue
        state = AgentState.parse(state_str)
        if state is None or state not in STATE_GLYPH:
            continue
        if not count_str.isdigit():
            continue
        counts[state] = count_str
    if not counts:
        # Distinguish "nothing at all" (hide the segment) from "upstream said
        # something, but none of it parsed" (show a loud, inert marker).
        if not raw.strip():
            return "", ""
        return " AI ? ? ", ""
    worst = max(counts)
    return f" AI {STATE_GLYPH[worst]} {counts[worst]} ", worst.name


def main() -> None:
    try:
        raw = subprocess.check_output(
            [str(SCRIPT), "status"], text=True, stderr=subprocess.DEVNULL
        ).strip()
    except EXPECTED_ERRORS as exc:
        log_error("status-ai", f"agent-attention status failed: {exc}")
        raw = ""

    content, state_name = render(raw)

    tmux_cmd("set-option", "-gq", "@ai_status", content, check=False)
    tmux_cmd("set-option", "-gq", "@ai_status_state", state_name, check=False)


if __name__ == "__main__":
    main()
