#!/usr/bin/env python3
"""Smoke tests for the tmux status helpers (agent-attention, status-window-label).

Runs against an isolated tmux server and a throwaway XDG_STATE_HOME so it
never touches the user's real tmux session, sockets, or pending events.

Usage:
    tmux/.config/tmux/scripts/test-status-tools
    tmux/.config/tmux/scripts/test-status-tools --keep   # keep server+tmpdir
    tmux/.config/tmux/scripts/test-status-tools -v       # verbose subprocess output

Exits non-zero on the first failed assertion. Pass `--keep` to inspect the
isolated tmux server with `tmux -L test-status-tools attach`.
"""

from __future__ import annotations

import argparse
import contextlib
import os
import re
import shlex
import shutil
import sqlite3
import subprocess
import sys
import tempfile
import time
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
AGENT_ATTENTION = SCRIPT_DIR / "agent-attention"
STATUS_WINDOW_LABEL = SCRIPT_DIR / "status-window-label"
CHEATSHEET = SCRIPT_DIR / "cheatsheet"
STATUS_AI = SCRIPT_DIR / "status-ai"
TMS = SCRIPT_DIR / "tms"
# scripts/ -> tmux/ -> .config/ -> <package root>, where the stowed dotfile lives.
TMUX_CONF = SCRIPT_DIR.parents[2] / ".tmux.conf"
# <repo>/tmux/.config/tmux/scripts -> <repo>
REPO_ROOT = SCRIPT_DIR.parents[3]

sys.path.insert(0, str(SCRIPT_DIR))
from _tmux_common import STATE_GLYPH, AgentState  # noqa: E402

# Per-process socket: two concurrent runs (e.g. `make check-all` here and in an
# agent workspace on the same box) would otherwise share one tmux server and
# kill-server each other's session mid-assertion.
SOCKET = f"test-status-tools-{os.getpid()}"


# ---------- assertion helpers ----------


class TestFailure(SystemExit):
    pass


class TestResults:
    def __init__(self) -> None:
        self.passed: list[str] = []
        self.failed: list[tuple[str, str]] = []

    def expect(self, name: str, got: object, want: object) -> None:
        if got == want:
            self.passed.append(name)
            print(f"  ok  {name}")
        else:
            self.failed.append((name, f"want={want!r} got={got!r}"))
            print(f"  FAIL {name}\n    want={want!r}\n    got ={got!r}")

    def expect_truthy(self, name: str, got: object) -> None:
        if got:
            self.passed.append(name)
            print(f"  ok  {name}")
        else:
            self.failed.append((name, f"expected truthy, got={got!r}"))
            print(f"  FAIL {name}\n    expected truthy, got={got!r}")

    def report(self) -> int:
        print(f"\nresult: {len(self.passed)} passed, {len(self.failed)} failed")
        for name, detail in self.failed:
            print(f"  - {name}: {detail}")
        return 0 if not self.failed else 1


# Backwards-compat module-level proxies so the existing assertion call
# sites read `expect(...)` without threading the runner through every
# helper. There is exactly one runner per process; the TestResults class
# exists so tests are introspectable rather than because we need
# parallel runners.
RESULTS = TestResults()


def expect(name: str, got: object, want: object) -> None:
    RESULTS.expect(name, got, want)


def expect_truthy(name: str, got: object) -> None:
    RESULTS.expect_truthy(name, got)


# ---------- isolated tmux + state ----------


def tmux(env: dict[str, str], args: list[str], check: bool = True) -> str:
    cmd = ["tmux", "-L", SOCKET, *args]
    result = subprocess.run(cmd, capture_output=True, text=True, env=env)
    if check and result.returncode != 0:
        raise TestFailure(
            f"tmux {' '.join(args)} failed:\n  stdout={result.stdout}\n  stderr={result.stderr}"
        )
    return result.stdout.strip()


def attention(env: dict[str, str], args: list[str], pane: str | None = None) -> str:
    """Run agent-attention with TMUX_PANE inherited the way real hooks would."""
    sub_env = env.copy()
    if pane is not None:
        sub_env["TMUX_PANE"] = pane
    elif "TMUX_PANE" in sub_env:
        del sub_env["TMUX_PANE"]
    result = subprocess.run(
        ["python3", str(AGENT_ATTENTION), *args],
        capture_output=True,
        text=True,
        env=sub_env,
    )
    if result.returncode != 0:
        raise TestFailure(
            f"agent-attention {' '.join(args)} failed:\n  stdout={result.stdout}\n  stderr={result.stderr}"
        )
    return result.stdout.strip()


def last_event_message(env: dict[str, str]) -> str:
    """Read the most recent event message straight out of the events DB."""
    import sqlite3

    db = Path(env["XDG_STATE_HOME"]) / "tmux-agent-attention" / "events.db"
    with sqlite3.connect(str(db)) as conn:
        row = conn.execute(
            "SELECT message FROM events ORDER BY rowid DESC LIMIT 1"
        ).fetchone()
    return row[0] if row else ""


def label(
    window_name: str,
    cmd: str,
    title: str,
    path: str,
    host: str,
    pid: str,
) -> str:
    """Render a label from explicit fields.

    The script itself takes only a window id and fetches the fields from
    tmux (see its module docstring: anything a pane can write must not
    reach a ``#(...)`` command line). The precedence chain it applies to
    those fields is still worth pinning field-by-field, so these cases
    drive ``render()`` directly; ``label_for_window`` below covers the
    fetch-and-dispatch path end to end.
    """
    swl = _import_script(STATUS_WINDOW_LABEL, "status_window_label_mod")
    return swl.render(
        window_name=window_name,
        pane_current_command=cmd,
        pane_title=title,
        pane_current_path=path,
        host_name=host,
        pane_pid=pid,
    )


def label_for_window(env: dict[str, str], window_id: str) -> str:
    """Run the real script the way ``@win_label`` does: one window id."""
    result = subprocess.run(
        [str(STATUS_WINDOW_LABEL), window_id],
        env=env,
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        raise TestFailure(
            f"status-window-label failed:\n  stdout={result.stdout}\n  stderr={result.stderr}"
        )
    return result.stdout.strip()


def _wait_for(env, target: str, fmt: str, pred, timeout: float = 3.0) -> str:
    """Poll ``display-message`` until *pred* accepts the value."""
    deadline = time.monotonic() + timeout
    value = ""
    while time.monotonic() < deadline:
        value = tmux(env, ["display-message", "-p", "-t", target, fmt], check=False)
        if pred(value):
            return value
        time.sleep(0.05)
    return value


def _start_session(env: dict[str, str]) -> None:
    """Create the first session, tolerating a server still shutting down.

    ``kill-server`` returns as soon as the server is told to exit, not once it
    has released the socket. Starting the next server immediately then fails
    with "server exited unexpectedly" (or "duplicate session" if the old one is
    still answering), which made the suite flake roughly every other run.
    """
    last = ""
    for attempt in range(20):
        result = subprocess.run(
            ["tmux", "-L", SOCKET, "new-session", "-d", "-s", "s1", "-n", "w1"],
            env=env,
            capture_output=True,
            text=True,
        )
        if result.returncode == 0:
            return
        last = result.stderr.strip()
        # A lingering server from a previous run still owns the socket.
        if "duplicate session" in last:
            tmux(env, ["kill-server"], check=False)
        time.sleep(0.05 * (attempt + 1))
    raise TestFailure(f"could not start isolated tmux server: {last}")


def latest_event(env: dict[str, str], *columns: str) -> tuple[object, ...]:
    """Read named columns off the newest row of the isolated events DB.

    Some of agent-attention's behavior (which source/message a payload
    resolved to) is only observable in the DB; the tmux options carry the
    state alone.
    """
    db = Path(env["XDG_STATE_HOME"]) / "tmux-agent-attention" / "events.db"
    if not db.is_file():
        raise TestFailure(f"events DB not created at {db}")
    with sqlite3.connect(db) as conn:
        row = conn.execute(
            f"SELECT {','.join(columns)} FROM events ORDER BY rowid DESC LIMIT 1"
        ).fetchone()
    if row is None:
        raise TestFailure("events DB has no rows")
    return tuple(row)


def setup_server(env: dict[str, str]) -> dict[str, str]:
    """Start an isolated tmux server with one detached session, two windows."""
    tmux(env, ["kill-server"], check=False)  # ignore if not running
    _start_session(env)
    tmux(env, ["new-window", "-t", "s1:", "-n", "w2"])
    tmux(env, ["select-window", "-t", "s1:1"])  # focus w1
    tmux(env, ["split-window", "-h", "-t", "s1:1"])  # pane in w1
    tmux(env, ["select-pane", "-t", "s1:1.1"])  # focus first pane

    panes = {}
    for window in ("s1:1", "s1:2"):
        for line in tmux(
            env,
            [
                "list-panes",
                "-t",
                window,
                "-F",
                "#{window_index} #{pane_index} #{pane_id}",
            ],
        ).splitlines():
            wi, pi, pid = line.split()
            panes[f"w{wi}p{pi}"] = pid
    return panes


def _unlink_socket(name: str) -> None:
    """kill-server leaves the socket file behind; with per-pid socket names
    that would accumulate stale entries in the socket dir, one set per run.
    """
    socket_dir = os.environ.get("TMUX_TMPDIR") or f"/tmp/tmux-{os.getuid()}"
    with contextlib.suppress(OSError):
        os.unlink(os.path.join(socket_dir, name))


def teardown_server(env: dict[str, str]) -> None:
    tmux(env, ["kill-server"], check=False)
    _unlink_socket(SOCKET)


# ---------- the actual tests ----------


def set_agent_state(
    env: dict[str, str], target: str, state: str, pid: str = ""
) -> None:
    """Simulate what the pi extension does: call agent-attention event."""
    args = [
        "python3",
        str(AGENT_ATTENTION),
        "event",
        "--window",
        tmux(env, ["display-message", "-p", "-t", target, "#{window_id}"]),
        "--state",
        state,
    ]
    if pid:
        args += ["--pid", pid]
    subprocess.run(args, capture_output=True, text=True, env=env, check=True)


def clear_agent_state(env: dict[str, str], target: str) -> None:
    """Simulate what the pi extension does on cleared."""
    wid = tmux(env, ["display-message", "-p", "-t", target, "#{window_id}"])
    subprocess.run(
        [
            "python3",
            str(AGENT_ATTENTION),
            "event",
            "--window",
            wid,
            "--state",
            "cleared",
        ],
        capture_output=True,
        text=True,
        env=env,
        check=True,
    )


def run_tests(env: dict[str, str], panes: dict[str, str]) -> None:
    print("\n[agent-attention: legacy notify (non-pi path)]")

    expect("status starts empty", attention(env, ["status"]), "")

    # Legacy notify defaults to blocked.
    attention(
        env,
        ["notify", "--source", "test", "--event-type", "detached"],
        pane=panes["w1p1"],
    )
    expect(
        "notify defaults to blocked state",
        attention(env, ["status"]),
        "blocked\t1",
    )
    expect(
        "@agent_state set to blocked",
        tmux(env, ["display-message", "-p", "-t", "s1:1", "#{@agent_state}"]),
        "blocked",
    )

    attention(env, ["clear-current", "--pane", panes["w1p1"]])
    expect(
        "clear-current clears blocked (idle remains)",
        attention(env, ["status"]),
        "idle\t1",
    )
    expect(
        "@agent_state is unset after clear",
        tmux(env, ["display-message", "-p", "-t", "s1:1", "#{@agent_state}"]),
        "",
    )

    # --- working state (pi extension path) ---

    print("\n[agent-attention: pi extension path]")

    set_agent_state(env, "s1:1", "working", str(os.getpid()))
    expect(
        "working state recorded",
        attention(env, ["status"]),
        "working\t1",
    )
    expect(
        "@agent_state set to working",
        tmux(env, ["display-message", "-p", "-t", "s1:1", "#{@agent_state}"]),
        "working",
    )

    # Focus should NOT clear working state.
    attention(env, ["clear-current", "--pane", panes["w1p1"]])
    expect(
        "focus does not clear working",
        tmux(env, ["display-message", "-p", "-t", "s1:1", "#{@agent_state}"]),
        "working",
    )

    # cleared drops working.
    clear_agent_state(env, "s1:1")
    expect(
        "cleared drops working state",
        tmux(env, ["display-message", "-p", "-t", "s1:1", "#{@agent_state}"]),
        "",
    )
    expect("status idle after cleared", attention(env, ["status"]), "idle\t1")

    # --- crash detection via pid reaper ---

    print("\n[agent-attention: crash reaper]")
    set_agent_state(env, "s1:2", "working", "9999999")
    # The reconciler (called by status) should detect the dead pid.
    status_out = attention(env, ["status"])
    expect(
        "dead pid detected as crashed (and idle is no longer discarded)",
        status_out,
        "crashed\t1\nidle\t1",
    )
    expect(
        "@agent_state set to crashed",
        tmux(env, ["display-message", "-p", "-t", "s1:2", "#{@agent_state}"]),
        "crashed",
    )
    # Focus-clear should clear crashed.
    attention(env, ["clear-current", "--pane", panes["w2p1"]])
    expect(
        "crashed clears on focus",
        tmux(env, ["display-message", "-p", "-t", "s1:2", "#{@agent_state}"]),
        "",
    )

    # --- clear-target by window id ---

    w2_id = tmux(env, ["display-message", "-p", "-t", "s1:2", "#{window_id}"])
    attention(
        env, ["notify", "--source", "test", "--event-type", "w2"], pane=panes["w2p1"]
    )
    expect(
        "notify queues on second window",
        attention(env, ["status"]),
        "blocked\t1\nidle\t1",
    )
    attention(env, ["clear-target", w2_id])
    expect(
        "clear-target clears blocked (idle remains)",
        attention(env, ["status"]),
        "idle\t2",
    )

    # --- notify --title / --event-type are wired, not discarded ---

    attention(
        env,
        ["notify", "--source", "codex", "--event-type", "notify", "--title", "Codex"],
        pane=panes["w2p1"],
    )
    expect(
        "notify --title lands in the stored message",
        last_event_message(env),
        "Codex",
    )
    attention(env, ["clear-target", w2_id])

    # --- JSON payload via stdin (legacy non-pi path) ---

    print("\n[agent-attention: JSON stdin]")
    # opencode/.config/opencode/plugin/notify.ts pipes this exact shape with no
    # flags. Asserting only exit code + "blocked" would pass even if the payload
    # were discarded, because a flagless notify already blocks; the DB row is
    # the only place the parse is observable.
    json_proc = subprocess.run(
        ["python3", str(AGENT_ATTENTION), "notify"],
        input='{"source":"opencode","type":"session.idle","title":"OpenCode","message":"done"}',
        capture_output=True,
        text=True,
        env={**env, "TMUX_PANE": panes["w1p2"]},
    )
    expect("stdin JSON notify exits 0", json_proc.returncode, 0)
    expect(
        "stdin JSON sets blocked",
        attention(env, ["status"]),
        "blocked\t1\nidle\t1",
    )
    expect(
        "stdin JSON payload reaches the DB",
        latest_event(env, "source", "message"),
        ("opencode", "done"),
    )
    attention(env, ["clear-current", "--pane", panes["w1p2"]])
    expect("status idle after clear", attention(env, ["status"]), "idle\t2")

    # Flags still win over stdin, and a garbage pipe must not crash the hook.
    garbage = subprocess.run(
        ["python3", str(AGENT_ATTENTION), "notify", "--source", "codex"],
        input="not json at all",
        capture_output=True,
        text=True,
        env={**env, "TMUX_PANE": panes["w1p2"]},
    )
    expect("unparseable stdin does not fail notify", garbage.returncode, 0)
    expect(
        "unparseable stdin falls back to flags",
        latest_event(env, "source", "message"),
        ("codex", "attention"),
    )
    attention(env, ["clear-current", "--pane", panes["w1p2"]])

    run_agent_state_contract_tests(env, panes["w1p1"])
    run_writer_vocabulary_tests()
    run_done_lifecycle_tests(env)
    run_split_pane_focus_tests(env)
    run_popup_focus_tests(env)

    print("\n[status-window-label]")

    # Pick a pid that is virtually guaranteed not to exist (and therefore
    # has no descendant agent processes). 9_999_999 is well above the
    # default ulimit on macOS/Linux.
    fake_pid = "9999999"
    host = "test-host"

    expect(
        "shell with cwd basename",
        label("zsh", "zsh", host, "/tmp/projectx", host, fake_pid),
        "projectx",
    )
    expect(
        "active editor wins over title",
        label("zsh", "nvim", "host-only-title", "/tmp/projectx", host, fake_pid),
        "nvim",
    )
    expect(
        "meaningful title beats path basename for shells",
        label("zsh", "zsh", "★ Side Project", "/tmp/projectx", host, fake_pid),
        "★ Side Project",
    )
    expect(
        "rejects host-equal title",
        label("zsh", "zsh", host, "/tmp/aaa", host, fake_pid),
        "aaa",
    )
    expect(
        "rejects path-shaped title",
        label("zsh", "zsh", ":/foo/bar", "/tmp/aaa", host, fake_pid),
        "aaa",
    )
    expect(
        "agent window with no detected child falls back to title",
        label("codex", "Python", "✳ Codex", "/tmp/x", host, fake_pid),
        "✳ Codex",
    )
    expect(
        "agent window with wrapper but no title falls back to window name",
        label("codex", "Python", "", "/tmp/x", host, fake_pid),
        "codex",
    )
    expect(
        "non-agent generic command fallback",
        label("daemons", "improve-writing", "", "/tmp/x", host, fake_pid),
        "improve-writing",
    )

    # The script fetches its own fields, so the end-to-end path (window id
    # in, label out) needs a real window.
    w1_id = tmux(env, ["display-message", "-p", "-t", "s1:1", "#{window_id}"])
    tmux(env, ["select-pane", "-t", "s1:1.1", "-T", "★ Fetched Title"])
    expect(
        "window id alone is enough to render a label",
        label_for_window(env, w1_id),
        "★ Fetched Title",
    )
    tmux(env, ["select-pane", "-t", "s1:1.1", "-T", ""])
    expect(
        "a dead window id degrades to an empty label, not a crash",
        label_for_window(env, "@99999"),
        "",
    )

    # @pane_agent is sticky: the push path owns it, and a redraw that can't
    # see the agent (container, custom title, plain shell) must not clear it.
    tmux(env, ["set-window-option", "-t", w1_id, "@pane_agent", "1"])
    label_for_window(env, w1_id)
    expect(
        "non-agent label leaves sticky @pane_agent alone",
        tmux(env, ["display-message", "-p", "-t", w1_id, "#{@pane_agent}"]),
        "1",
    )
    tmux(env, ["set-window-option", "-u", "-t", w1_id, "@pane_agent"])

    # An agent window: name in AGENTS, active command a wrapper, no
    # detectable agent child -- the branch that falls back to the window
    # name and so marks the window as hosting an agent.
    tmux(
        env,
        [
            "new-window",
            "-d",
            "-t",
            "s1:",
            "-n",
            "codex",
            "python3 -c 'import time; time.sleep(300)'",
        ],
    )
    agent_id = tmux(env, ["display-message", "-p", "-t", "s1:codex", "#{window_id}"])
    _wait_for(
        env,
        agent_id,
        "#{pane_current_command}",
        lambda v: v.startswith("python"),
    )
    expect(
        "agent window renders the agent name", label_for_window(env, agent_id), "codex"
    )
    expect(
        "agent label sets @pane_agent",
        tmux(env, ["display-message", "-p", "-t", agent_id, "#{@pane_agent}"]),
        "1",
    )
    tmux(env, ["kill-window", "-t", agent_id])

    run_format_injection_tests()

    print("\n[agent-attention: menu-rows]")
    run_menu_rows_tests(env)

    print("\n[agent-attention: picker state filters]")
    run_filter_bind_tests(env)

    print("\n[agent-attention: picker filter hints]")
    run_filter_hint_tests()

    print("\n[agent-attention: picker preview]")
    run_preview_tests(env)

    print("\n[cheatsheet]")
    run_cheatsheet_tests()

    print("\n[tms]")
    run_tms_tests()

    print("\n[status-ai: format injection]")
    run_status_ai_injection_tests()


# Drives the real extension: registers its handlers against a stub pi API,
# fires one event, and waits for the handler's queued work to settle.
_PI_DRIVER = """
const [,, ext, event] = process.argv;
const mod = await import(ext);
const handlers = {};
mod.default({ on: (ev, fn) => { handlers[ev] = fn; } });
if (!handlers[event]) { console.error("no handler for " + event); process.exit(3); }
console.log(Object.keys(handlers).sort().join(","));
await handlers[event]();
await new Promise((r) => setTimeout(r, 1500));
"""


def run_agent_state_contract_tests(env: dict[str, str], pane: str) -> None:
    """Run the *real* pi extension and assert the tmux state it writes.

    Five packages agree on an untyped string protocol: the TS extension
    writes @agent_state/@pane_agent, ``_tmux_common.AgentState`` parses them,
    ``.tmux.conf`` switches glyphs on them, and the picker rolls them up.
    The old coverage re-implemented the TS side in Python ("Simulate what the
    pi extension does"), so renaming a state on either side passed every gate.

    Running the genuine article is possible because node >= 22.6 strips TypeScript
    types on import, so the .ts file loads with no build step. Two seams have
    to be closed for it to be hermetic:

      * the extension shells plain ``tmux``, with no socket flag, so a shim
        earlier on PATH pins it to this run's isolated server;
      * it resolves the helper script through ``$HOME``, so HOME points at a
        tree whose .config/tmux/scripts is a symlink to the repo copy.

    Skipped rather than failed when node is missing: this suite has to keep
    working on a box with no JS toolchain.
    """
    print("\n[agent-state contract: real pi extension]")

    if shutil.which("node") is None:
        print("  skip  node not installed")
        return

    ext = REPO_ROOT / "pi" / ".pi" / "agent" / "extensions" / "agent-attention.ts"
    if not ext.is_file():
        raise TestFailure(f"pi extension not found at {ext}")

    sandbox = Path(env["XDG_STATE_HOME"]) / "pi-ext"
    bindir = sandbox / "bin"
    fake_home = sandbox / "home"
    bindir.mkdir(parents=True, exist_ok=True)
    (fake_home / ".config" / "tmux").mkdir(parents=True, exist_ok=True)
    link = fake_home / ".config" / "tmux" / "scripts"
    if not link.exists():
        link.symlink_to(SCRIPT_DIR)

    real_tmux = shutil.which("tmux", path=env.get("PATH"))
    shim = bindir / "tmux"
    shim.write_text(f'#!/bin/sh\nexec {real_tmux} -L {SOCKET} "$@"\n', encoding="utf-8")
    shim.chmod(0o755)

    driver = sandbox / "drive.mjs"
    driver.write_text(_PI_DRIVER, encoding="utf-8")

    wid = tmux(env, ["display-message", "-p", "-t", pane, "#{window_id}"])

    def fire(event: str, **extra: str) -> subprocess.CompletedProcess[str]:
        sub = {
            **env,
            **extra,
            "PATH": f"{bindir}:{env['PATH']}",
            "HOME": str(fake_home),
            "TMUX_PANE": pane,
        }
        return subprocess.run(
            ["node", str(driver), str(ext), event],
            capture_output=True,
            text=True,
            env=sub,
            timeout=60,
        )

    def state() -> str:
        return tmux(env, ["display-message", "-p", "-t", wid, "#{@agent_state}"])

    started = fire("agent_start")
    expect("the real extension loads under node", started.returncode, 0)
    # The event names are half the contract: pi fires these exact strings.
    expect(
        "extension registers the documented pi events",
        started.stdout.strip().splitlines()[0] if started.stdout.strip() else "",
        "agent_end,agent_start,session_shutdown",
    )
    expect("agent_start writes @agent_state=working", state(), "working")
    expect(
        "agent_start sets the sticky @pane_agent marker",
        tmux(env, ["display-message", "-p", "-t", wid, "#{@pane_agent}"]),
        "1",
    )
    # The value the TS writes must be a name the Python enum knows.
    expect(
        "the written state parses as an AgentState",
        AgentState.parse(state()),
        AgentState.working,
    )
    # ...and it must reach the reader the status bar actually uses. Note
    # `status` also runs the reaper, and the pid the extension recorded is
    # the driver node process, which has already exited -- so the honest
    # expectation here is `crashed`, which is itself the contract working:
    # the TS wrote a pid, the Python reaped it. Read the raw option for the
    # unreaped value and let the reaper have its say separately.
    expect(
        "scan_agent_states sees the extension's write",
        AgentState.parse(state()),
        AgentState.working,
    )
    expect(
        "the reaper acts on the pid the extension recorded",
        attention(env, ["status"]).split("\t")[0],
        "crashed",
    )
    # Reset: that reap left the window crashed.
    tmux(env, ["set-window-option", "-qu", "-t", wid, "@agent_state"])

    # agent_end on an unfocused pane parks the window as done: it finished
    # without being seen. `blocked` means "waiting on you", which is a
    # different thing and pi has no event for it.
    tmux(env, ["select-window", "-t", "s1:2"])
    fire("agent_end")
    expect("agent_end on an unfocused pane writes done", state(), "done")
    expect(
        "the done value parses as an AgentState",
        AgentState.parse(state()),
        AgentState.done,
    )

    # ...and the Python half of the lifecycle closes over the real write:
    # focusing the window is the seen-signal `done` is waiting for. Both
    # writers are the genuine article here (TS sets it, agent-attention
    # clears it), which is the only place the whole loop is exercised
    # without a Python stand-in for the extension.
    attention(env, ["clear-current", "--pane", pane])
    expect("focusing a window the extension marked done clears it", state(), "")
    expect(
        "clearing done leaves the sticky agent marker, so the window goes idle",
        tmux(env, ["display-message", "-p", "-t", wid, "#{@pane_agent}"]),
        "1",
    )

    # MU_MANAGED short-circuits to a plain clear.
    fire("agent_start")
    expect("agent_start again writes working", state(), "working")
    fire("agent_end", MU_MANAGED_AGENT="1")
    expect("agent_end under MU_MANAGED clears the state", state(), "")

    # session_shutdown is the terminal event; it must clear, not leave a
    # working pid behind for the reaper to report as a crash.
    fire("agent_start")
    fire("session_shutdown")
    expect("session_shutdown clears @agent_state", state(), "")
    expect(
        "session_shutdown leaves no crashed window behind",
        "crashed" in attention(env, ["status"]),
        False,
    )

    # Sticky marker outlives the states, so the window keeps its idle dot.
    expect(
        "@pane_agent survives the session",
        tmux(env, ["display-message", "-p", "-t", wid, "#{@pane_agent}"]),
        "1",
    )

    tmux(env, ["set-window-option", "-qu", "-t", wid, "@pane_agent"])
    tmux(env, ["select-window", "-t", "s1:1"])


def run_menu_rows_tests(env: dict[str, str]) -> None:
    """The picker's row source must render every visible state, done included.

    ``done`` was in ``_VISIBLE_STATES`` (so ``attention_windows()`` lists it)
    but missing from ``STATE_GLYPH_ANSI``, so a finished agent rendered as a
    literal "?" in the picker.
    """
    aa = _import_script(AGENT_ATTENTION, "agent_attention_mod")
    missing = [s.name for s in STATE_GLYPH if s not in aa.STATE_GLYPH_ANSI]
    expect("STATE_GLYPH_ANSI covers every STATE_GLYPH state", missing, [])

    wid = tmux(env, ["display-message", "-p", "-t", "s1:2", "#{window_id}"])
    tmux(env, ["set-window-option", "-t", wid, "@agent_state", "done"])
    try:
        sid = tmux(env, ["display-message", "-p", "-t", "s1:2", "#{session_id}"])
        rows = attention(env, ["menu-rows"]).splitlines()
        done_rows = [r for r in rows if r.startswith(f"{sid}:{wid}\t")]
        expect("done window reaches the picker rows", len(done_rows), 1)
        expect_truthy(
            "done row carries the done glyph, not '?'",
            done_rows and STATE_GLYPH[AgentState.done] in done_rows[0],
        )
        expect(
            "--filter done keeps only the done row",
            attention(env, ["menu-rows", "--filter", "done"]).splitlines(),
            done_rows,
        )
        expect(
            "--filter crashed drops the done row",
            attention(env, ["menu-rows", "--filter", "crashed"]),
            "",
        )
        run_current_marker_tests(env, aa, wid)
    finally:
        tmux(env, ["set-window-option", "-qu", "-t", wid, "@agent_state"])


def run_current_marker_tests(env: dict[str, str], aa, wid: str) -> None:
    """The row for the window the client is on carries the gutter marker.

    The gutter is a fixed one-column field so it must not disturb the
    column alignment the other picker tests rely on, and it must stay
    script-generated: only the two literals "◆" and " " can appear there,
    never anything derived from a window name.
    """
    pane = tmux(env, ["display-message", "-p", "-t", wid, "#{pane_id}"])
    rows = attention(env, ["menu-rows"], pane=pane).splitlines()
    marked = [r for r in rows if r.split("\t", 1)[1].startswith(aa.CURRENT_MARKER)]
    expect("exactly one row is marked as current", len(marked), 1)
    expect_truthy(
        "the marked row is the window the client is on",
        marked
        and marked[0].startswith(
            f"{tmux(env, ['display-message', '-p', '-t', wid, '#{session_id}'])}:{wid}\t"
        ),
    )
    expect_truthy(
        "unmarked rows keep the gutter as a blank column",
        all(
            r.split("\t", 1)[1].startswith(" ")
            for r in rows
            if not r.split("\t", 1)[1].startswith(aa.CURRENT_MARKER)
        ),
    )

    # Alignment: the gutter shifts every label by the same fixed prefix,
    # so the columns after it still line up.
    built = [
        aa.PickerRow(
            target="$0:@1",
            state=AgentState.blocked,
            glyph="!",
            location="s:1",
            name="short",
            age="1m",
            sort_key=(0, 0, 0),
        ),
        aa.PickerRow(
            target="$0:@2",
            state=AgentState.blocked,
            glyph="!",
            location="session:12",
            name="a much longer name",
            age="",
            sort_key=(0, 0, 0),
        ),
    ]
    labels = [label for _, label in aa.format_picker_rows(built, "@2")]
    expect("every formatted label has the same width", len({len(x) for x in labels}), 1)
    expect("the current row's gutter holds the marker", labels[1][0], aa.CURRENT_MARKER)
    expect("a non-current row's gutter holds a space", labels[0][0], " ")

    # A hostile window name must not be able to fake the marker column.
    hostile = aa.format_picker_rows(
        [
            aa.PickerRow(
                target="$0:@3",
                state=AgentState.blocked,
                glyph="!",
                location=f"{aa.CURRENT_MARKER} s:1",
                name="x",
                age="",
                sort_key=(0, 0, 0),
            )
        ],
        "@4",
    )
    expect(
        "a window name cannot forge the gutter marker",
        hostile[0][1].startswith(aa.CURRENT_MARKER),
        False,
    )


def run_filter_bind_tests(env: dict[str, str]) -> None:
    """The state filter must be an axis separate from the text query.

    The binds are constructed data (prompt chip + reload argv), so they are
    asserted as data and as executables: fzf must accept the bind syntax,
    and each reload command must really produce that state's rows — not
    rows whose *name* happens to contain the state word.
    """
    aa = _import_script(AGENT_ATTENTION, "agent_attention_mod")

    expect(
        "every displayable state has a filter key",
        sorted(s.name for s in aa.FILTER_KEYS.values() if s is not None),
        sorted(s.name for s in STATE_GLYPH if s is not AgentState.idle),
    )
    expect("one key clears the filter", list(aa.FILTER_KEYS.values()).count(None), 1)

    # Collision check against the picker's own binds. Only enter:accept is
    # bound outside FILTER_KEYS (the preview pane uses --preview, not a key),
    # so a filter key stealing enter would silently break selection.
    src = AGENT_ATTENTION.read_text(encoding="utf-8")
    other_keys = set(re.findall(r'"([a-z-]+):(?:accept|abort|toggle[a-z-]*)"', src))
    expect("picker binds only enter outside the filter keys", other_keys, {"enter"})
    expect(
        "no filter key collides with an existing picker bind",
        other_keys & set(aa.FILTER_KEYS),
        set(),
    )

    binds = aa.filter_binds("!1")
    expect("one --bind pair per filter key", len(binds), 2 * len(aa.FILTER_KEYS))
    # fzf parses --bind at startup, so --filter (non-interactive) still
    # rejects a malformed binding: this is a real parse assertion.
    parsed = subprocess.run(
        ["fzf", "--filter", "a", *binds], input="a\n", text=True, capture_output=True
    )
    expect("fzf accepts the filter binds", parsed.returncode, 0)

    specs = dict(
        bind.split(":", 1) for bind in binds[1::2]
    )  # key -> change-prompt|...|+reload|...|
    for key, state in aa.FILTER_KEYS.items():
        chip, _, reload_part = specs[key].partition("|+reload|")
        prompt = chip[len("change-prompt|") :]
        if state is None:
            expect(
                f"{key} restores the unfiltered prompt", prompt, "Agent state (!1) > "
            )
        else:
            expect_truthy(
                f"{key} prompt shows the {state.name} chip",
                prompt.startswith(f"{STATE_GLYPH[state]} {state.name} "),
            )

        # Run the reload command fzf would run and compare it to the
        # subcommand it is supposed to be an alias for.
        got = subprocess.run(
            ["sh", "-c", reload_part.rstrip("|")],
            capture_output=True,
            text=True,
            env=env,
        ).stdout
        want = attention(
            env, ["menu-rows"] + ([] if state is None else ["--filter", state.name])
        )
        expect(
            f"{key} reloads exactly the {state.name if state else 'all'} rows",
            got.strip(),
            want.strip(),
        )


def run_filter_hint_tests() -> None:
    """The picker header must name every filter key.

    The five filter keys shipped with no header at all, so they worked and
    nobody could find them. The assertion that earns its keep is coverage:
    it goes red when a sixth filter is added and the hint is forgotten —
    exactly the drift that produced the missing header.
    """
    aa = _import_script(AGENT_ATTENTION, "agent_attention_mod")
    header = aa.filter_hints()
    plain = re.sub(r"\x1b\[[0-9;]*m", "", header)

    missing = [
        key for key in aa.FILTER_KEYS if f"^{key.removeprefix('ctrl-')} " not in plain
    ]
    expect("the header names every filter key", missing, [])
    labels = [s.name if s else "all" for s in aa.FILTER_KEYS.values()]
    expect(
        "the header names every filter's state",
        [label for label in labels if label not in plain],
        [],
    )

    # Urgency-descending, matching the row sort and the status pill — not
    # FILTER_KEYS' declaration order (a/b/w/d/x).
    states = [s for s in aa.FILTER_KEYS.values() if s is not None]
    expect(
        "hints read urgency-descending",
        # A name the header omits sorts last instead of raising, so the
        # coverage assertion above stays the one that reports it.
        sorted(states, key=lambda s: (plain.find(s.name) + 1) or len(plain)),
        sorted(states, key=lambda s: -int(s)),
    )

    expect_truthy(
        "each state hint carries its own state colour",
        all(
            aa.state_ansi(s, f"^{k.removeprefix('ctrl-')} {s.name}") in header
            for k, s in aa.FILTER_KEYS.items()
            if s is not None
        ),
    )

    # The popup is 80% of the client width (.tmux.conf), so an 80-column
    # client leaves 64 columns; wrapping would push the header onto the rows.
    expect_truthy(
        f"header fits an 80-column client (len {len(plain)})", len(plain) <= 64
    )

    # The builder is only discoverability if cmd_menu actually hands it to fzf.
    expect_truthy(
        "cmd_menu passes the hints as fzf --header",
        re.search(
            r'"--header",\s*\n\s*filter_hints\(\),',
            AGENT_ATTENTION.read_text(encoding="utf-8"),
        ),
    )


def run_preview_tests(env: dict[str, str]) -> None:
    """The preview renders agent-authored text; it must not be able to lie.

    Event messages come from agents, so the preview is an untrusted-text
    sink pointed straight at a terminal. Three properties are asserted:
    the history is actually rendered, control characters (ESC, newline,
    tab) cannot escape their cell, and the fzf wiring interpolates only
    fzf's own target field — no event text reaches a command line or a
    tmux option.
    """
    aa = _import_script(AGENT_ATTENTION, "agent_attention_mod")

    wid = tmux(env, ["display-message", "-p", "-t", "s1:2", "#{window_id}"])
    sid = tmux(env, ["display-message", "-p", "-t", "s1:2", "#{session_id}"])
    db = Path(env["XDG_STATE_HOME"]) / "tmux-agent-attention" / "events.db"
    hostile = "pwn\x1b[2J\x1b]0;title\x07 line1\nline2\tcol2\r\x9bK"
    with sqlite3.connect(db) as conn:
        conn.execute(
            "INSERT INTO events (ts,window_id,source,state,message) VALUES (?,?,?,?,?)",
            (int(time.time()) - 120, wid, "pi", "working", "picked up the task"),
        )
        conn.execute(
            "INSERT INTO events (ts,window_id,source,state,message) VALUES (?,?,?,?,?)",
            (int(time.time()), wid, "pi", "blocked", hostile),
        )
    try:
        out = attention(env, ["preview", f"{sid}:{wid}"])
        lines = out.splitlines()
        expect("preview renders one line per event", len(lines), 2)
        expect_truthy(
            "preview shows the earlier message and its relative age",
            "picked up the task" in lines[0] and "2m" in lines[0],
        )
        expect_truthy(
            "preview shows the state transition", "working → blocked" in lines[1]
        )

        # The message's control bytes must not survive into the output.
        body = out.split("\x1b[0m")[-1]
        expect("no ESC from the message reaches the pane", "\x1b[2J" in out, False)
        expect("no OSC introducer reaches the pane", "\x1b]0;" in out, False)
        expect("no C1 CSI byte reaches the pane", "\x9b" in out, False)
        expect("the hostile message cannot forge a new line", "line2" in body, True)
        expect("the hostile message stays on one line", len(lines), 2)
        expect("the hostile message cannot inject a tab", "\t" in lines[1], False)

        # An unknown window must not error out; fzf would render the traceback.
        expect_truthy(
            "preview of a window with no events says so",
            "no recorded events" in attention(env, ["preview", "@99999"]),
        )

        # Row protocol: menu-rows output is "<target>\t<label>", so a window
        # name carrying a tab or newline must not be able to forge a row.
        rows = aa.format_picker_rows(
            [
                aa.PickerRow(
                    target="$0:@1",
                    state=AgentState.blocked,
                    glyph="!",
                    location="s\t1:1",
                    name="evil\n$0:@2\tfake",
                    age="1m",
                    sort_key=(0, 0, 0),
                )
            ]
        )
        expect("a hostile window name yields exactly one row", len(rows), 1)
        expect("no tab survives into the row label", "\t" in rows[0][1], False)
        expect("no newline survives into the row label", "\n" in rows[0][1], False)

        # The fzf wiring itself: only fzf's {1} placeholder is interpolated,
        # and nothing from the event store is in the command line at all.
        cmd = aa.preview_command()
        expect("preview command interpolates only fzf's target field", "{1}" in cmd, 1)
        expect(
            "preview command has no other fzf placeholder",
            re.findall(r"\{\d+\}", cmd),
            ["{1}"],
        )

        # No untrusted text may reach a tmux option (that is the format
        # re-expansion sink); the preview writes to stdout only.
        src = AGENT_ATTENTION.read_text(encoding="utf-8")
        preview_src = src[
            src.index("def render_preview") : src.index("def attention_windows")
        ]
        for sink in ("set-option", "set-window-option", "#{E:", "#{T:", "#("):
            expect(f"preview never routes text into {sink}", sink in preview_src, False)
    finally:
        with sqlite3.connect(db) as conn:
            conn.execute("DELETE FROM events WHERE window_id = ?", (wid,))


def run_done_lifecycle_tests(env: dict[str, str]) -> None:
    """``done`` is sticky, and only a side effect clears it.

    Every other state announces itself: ``working`` is written when a turn
    starts, ``crashed`` when the reaper notices a dead pid, ``blocked`` when
    an agent asks for something. ``done`` is the opposite shape -- it is set
    once and then *waits*, and the thing that ends it is not an event at all
    but the user focusing the window. That is the shape that rots silently:
    if a regression makes done stop being written, or makes a routine status
    tick eat it, nothing errors and nothing is logged. The badge merely stops
    appearing, and a thing that quietly does not happen is a thing nobody
    reports. So the whole lifecycle is pinned here rather than left to the
    incidental coverage the feature work happened to leave behind.

    Scoped to a throwaway window so the global ``status`` counts the rest of
    the suite asserts on are untouched.
    """
    print("\n[agent-attention: done lifecycle]")

    tmux(env, ["new-window", "-d", "-t", "s1:", "-n", "donelc"])
    target = "s1:donelc"
    wid = tmux(env, ["display-message", "-p", "-t", target, "#{window_id}"])

    def state() -> str:
        return tmux(env, ["display-message", "-p", "-t", wid, "#{@agent_state}"])

    def status_rows() -> dict[str, int]:
        out = attention(env, ["status"])
        rows = (line.split("\t") for line in out.splitlines() if line)
        return {name: int(count) for name, count in rows}

    pane = tmux(env, ["display-message", "-p", "-t", target, "#{pane_id}"])

    try:
        # 1. The transition itself. `done` replaced an unconditional clear on
        #    agent_end, so the failure mode of a revert is an *empty* option,
        #    not a wrong one -- assert the value, never merely "changed".
        set_agent_state(env, target, "working", str(os.getpid()))
        expect("a turn in flight is working", state(), "working")
        set_agent_state(env, target, "done")
        expect("working -> done writes done, not an empty option", state(), "done")

        # 2. Sticky across a reconcile pass. `status` runs the reaper and the
        #    rescan on every 5s status tick, so a done badge lives or dies by
        #    surviving this call repeatedly, not once.
        for tick in (1, 2, 3):
            rows = status_rows()
            expect(f"done survives status tick {tick}", state(), "done")
            expect(f"status tick {tick} counts the done window", rows.get("done"), 1)

        # 3. The side effect that ends it. Focus is the seen-signal: the user
        #    looked, so the report is delivered and the badge retires. The
        #    window does not vanish from the roll-up though -- @pane_agent is
        #    sticky, so it falls back to idle rather than disappearing.
        attention(env, ["clear-current", "--pane", pane])
        expect("focus clears done", state(), "")
        expect(
            "a cleared done window falls back to idle, it does not vanish",
            status_rows().get("idle", 0) >= 1,
            True,
        )
        expect("no done window is left behind", "done" in status_rows(), False)

        # 4. crashed still outranks done. The extension writes done straight
        #    to the tmux option and skips the DB (agent_end has no pid to
        #    record), so the newest DB row stays the `working` one. If that
        #    pid is gone the agent did not finish, it died mid-report, and
        #    the reaper must say so -- an alarm may never be masked by an
        #    informational badge.
        set_agent_state(env, target, "working", "9999999")
        tmux(env, ["set-window-option", "-q", "-t", wid, "@agent_state", "done"])
        expect("the option starts out done", state(), "done")
        status_rows()
        expect("a dead pid overrides done with crashed", state(), "crashed")
    finally:
        tmux(env, ["kill-window", "-t", wid], check=False)
        db = Path(env["XDG_STATE_HOME"]) / "tmux-agent-attention" / "events.db"
        with sqlite3.connect(db) as conn:
            conn.execute("DELETE FROM events WHERE window_id = ?", (wid,))


def split_pane_fixture(env: dict[str, str], name: str) -> tuple[str, str, str]:
    """A window laid out the way the README documents: agent + sibling shell.

    Returns ``(window_id, agent_pane, user_pane)``.

    Every other agent-state test in this file gives the agent a window to
    itself, and that is precisely why the pane-granularity bug shipped: in
    a one-pane window the focused pane *is* the agent pane, so a
    window-scoped clear and a pane-scoped clear are indistinguishable and
    both pass. Only a window with a second pane in it can tell them apart,
    so the layout is the fixture.

    The agent pane is deliberately *not* the active one: the user sitting
    in the sibling is the whole scenario.
    """
    tmux(env, ["new-window", "-d", "-t", "s1:", "-n", name])
    tmux(env, ["split-window", "-h", "-d", "-t", f"s1:{name}"])
    wid = tmux(env, ["display-message", "-p", "-t", f"s1:{name}", "#{window_id}"])
    panes = tmux(
        env, ["list-panes", "-t", f"s1:{name}", "-F", "#{pane_id}"]
    ).splitlines()
    if len(panes) != 2:
        raise TestFailure(f"split-pane fixture wanted 2 panes, got {panes}")
    return wid, panes[0], panes[1]


def run_split_pane_focus_tests(env: dict[str, str]) -> None:
    """A focus event near an agent is not the user looking at the agent.

    Reported from normal use: "I am in a non-agent pane, I see a ! in the
    pill, something takes focus, the ! is gone." ``@agent_state`` is a
    *window* option, so any ``pane-focus-in`` in the window -- including
    one on the sibling pane the user never left -- used to satisfy the
    seen-check and clear the badge. The notification was destroyed by the
    user's proximity to it rather than their attention to it.

    The clear now requires the focused pane to be the agent's own, which
    is recorded on the event rows. What must not regress in either
    direction is pinned here: the badge survives a sibling focus, and it
    still dies when the user actually focuses the agent.
    """
    print("\n[agent-attention: split-pane focus granularity]")

    wid, agent_pane, user_pane = split_pane_fixture(env, "splitfx")
    db = Path(env["XDG_STATE_HOME"]) / "tmux-agent-attention" / "events.db"

    def state() -> str:
        return tmux(env, ["display-message", "-p", "-t", wid, "#{@agent_state}"])

    def event_count() -> int:
        with sqlite3.connect(db) as conn:
            return conn.execute(
                "SELECT COUNT(*) FROM events WHERE window_id = ?", (wid,)
            ).fetchone()[0]

    def arm(agent_state: str) -> None:
        """Put the window in *agent_state*, attributed to the agent pane."""
        subprocess.run(
            [
                "python3",
                str(AGENT_ATTENTION),
                "event",
                "--window",
                wid,
                "--pane",
                agent_pane,
                "--state",
                agent_state,
            ],
            capture_output=True,
            text=True,
            env=env,
            check=True,
        )

    try:
        # 1. The reported bug. Focus lands on the sibling pane; the user
        #    never looked at the agent, so the badge stays. Asserted for
        #    every "look at me" state, because they share the code path
        #    and the report covered blocked and done both.
        for agent_state in ("blocked", "done"):
            arm(agent_state)
            expect(f"{agent_state} is armed on the agent pane", state(), agent_state)
            attention(env, ["clear-current", "--pane", user_pane])
            expect(
                f"focusing the sibling pane does not clear {agent_state}",
                state(),
                agent_state,
            )

        # 2. Second defect, same cause: the spurious clear also dropped
        #    the window's event rows -- the exact history the picker
        #    preview exists to render. Arriving near an agent destroyed
        #    the evidence of why it wanted you.
        expect_truthy("the armed events are on record", event_count() > 0)
        attention(env, ["clear-current", "--pane", user_pane])
        expect_truthy(
            "a sibling focus does not delete the window's event history",
            event_count() > 0,
        )

        # 3. The feature itself, undiminished: focusing the agent's own
        #    pane is the seen-signal, and still retires every visible
        #    "look at me" state.
        for agent_state in ("blocked", "done"):
            arm(agent_state)
            attention(env, ["clear-current", "--pane", agent_pane])
            expect(f"focusing the agent pane still clears {agent_state}", state(), "")

        # crashed reaches the option through the reaper rather than a
        # state flag, so it is armed the way the reaper arms it.
        arm("working")
        tmux(env, ["set-window-option", "-q", "-t", wid, "@agent_state", "crashed"])
        attention(env, ["clear-current", "--pane", user_pane])
        expect("a sibling focus does not clear crashed", state(), "crashed")
        attention(env, ["clear-current", "--pane", agent_pane])
        expect("focusing the agent pane still clears crashed", state(), "")

        # 4. working is not a "look at me" state at all: the agent is
        #    still going, and looking at it does not change that. True
        #    from either pane.
        arm("working")
        attention(env, ["clear-current", "--pane", user_pane])
        expect("a sibling focus does not clear working", state(), "working")
        attention(env, ["clear-current", "--pane", agent_pane])
        expect("focusing the agent pane does not clear working", state(), "working")
        tmux(env, ["set-window-option", "-qu", "-t", wid, "@agent_state"])

        # 5. The awkward inputs, where "which pane is the agent" has no
        #    honest answer. Both resolve to clearing -- the pre-fix
        #    behaviour -- because the alternative is a badge the user has
        #    no way to dismiss.
        #
        #    (a) No pane on record. The legacy notify path records one via
        #        current_context, and the pi path now passes --pane, but a
        #        trimmed history can still leave a state with no rows.
        with sqlite3.connect(db) as conn:
            conn.execute("DELETE FROM events WHERE window_id = ?", (wid,))
        tmux(env, ["set-window-option", "-q", "-t", wid, "@agent_state", "blocked"])
        attention(env, ["clear-current", "--pane", user_pane])
        expect(
            "with no pane on record the clear still happens",
            state(),
            "",
        )

        #    (b) The agent's pane is gone. Nothing is left to focus, so
        #        refusing to clear would strand the badge forever.
        dead_pane = "%99999"
        with sqlite3.connect(db) as conn:
            conn.execute(
                "INSERT INTO events (ts,window_id,pane_id,source,state,message) "
                "VALUES (?,?,?,?,?,?)",
                (int(time.time()), wid, dead_pane, "pi", "blocked", "blocked"),
            )
        tmux(env, ["set-window-option", "-q", "-t", wid, "@agent_state", "blocked"])
        attention(env, ["clear-current", "--pane", user_pane])
        expect("a clear is not stranded by a dead agent pane", state(), "")

        #    (c) A stale-but-live pane is NOT that case: the agent moved,
        #        the old pane still exists, and the newest row is what
        #        counts. Re-arming from the sibling pane makes *it* the
        #        agent pane, so focus there now clears and the original
        #        pane no longer does.
        subprocess.run(
            [
                "python3",
                str(AGENT_ATTENTION),
                "event",
                "--window",
                wid,
                "--pane",
                user_pane,
                "--state",
                "blocked",
            ],
            capture_output=True,
            text=True,
            env=env,
            check=True,
        )
        attention(env, ["clear-current", "--pane", agent_pane])
        expect(
            "a restarted agent's old pane stops counting as the agent",
            state(),
            "blocked",
        )
        attention(env, ["clear-current", "--pane", user_pane])
        expect("the restarted agent's new pane is the one that clears", state(), "")
    finally:
        tmux(env, ["kill-window", "-t", wid], check=False)
        with sqlite3.connect(db) as conn:
            conn.execute("DELETE FROM events WHERE window_id = ?", (wid,))


def run_popup_focus_tests(env: dict[str, str]) -> None:
    """An inert popup must not count as looking at the agent.

    This is the user's literal report -- open something over the session,
    dismiss it, the badge is gone -- and it is the case the unit-level
    fixture above cannot reach, because it is the *real hook wiring* that
    is on trial, not the script's argument handling. Dismissing a popup
    fires a genuine ``pane-focus-in`` on the pane the user never left, and
    only a real server with the real ``set-hook`` lines and a real
    attached client produces that event.

    The popup runs ``sleep``: nothing about the picker is involved. The
    picker was the user's guess at the cause and it was wrong, so tying
    the regression test to it would pin the wrong mechanism.

    Inner server holds the config under test; outer server exists only to
    give it an attached client, since a detached server has no focus to
    move. Same shape as the format-injection render test.
    """
    print("\n[agent-attention: popup dismissal]")

    inner = f"{SOCKET}-popup-in"
    outer = f"{SOCKET}-popup-out"
    tmpdir = Path(tempfile.mkdtemp(prefix="tmux-popup-test-"))
    fake_home = tmpdir / "home"
    (fake_home / ".config" / "tmux").mkdir(parents=True, exist_ok=True)
    (fake_home / ".config" / "tmux" / "scripts").symlink_to(SCRIPT_DIR)

    # The hook lines under test are the real ones, lifted from .tmux.conf
    # rather than restated here: a fix that only holds against a
    # paraphrase of the wiring is not a fix.
    conf_lines = TMUX_CONF.read_text(encoding="utf-8").splitlines()
    hook_lines = [
        ln
        for ln in conf_lines
        if ln.startswith(("%hidden ATTN_CLEAR=", "set-hook -g "))
    ]
    expect_truthy(".tmux.conf still defines the attention hooks", hook_lines)

    conf = tmpdir / "inner.conf"
    conf.write_text(
        "set -g focus-events on\nset -g status off\n" + "\n".join(hook_lines) + "\n",
        encoding="utf-8",
    )

    sub_env = {
        **env,
        "HOME": str(fake_home),
        "XDG_STATE_HOME": str(tmpdir / "state"),
        "TMUX_SOCKET_NAME": inner,
    }

    def raw(socket: str, *args: str) -> str:
        return subprocess.run(
            ["tmux", "-L", socket, *args],
            capture_output=True,
            text=True,
            env=sub_env,
        ).stdout.strip()

    try:
        raw(inner, "kill-server")
        raw(outer, "kill-server")
        time.sleep(0.2)
        raw(
            inner,
            "-f",
            str(conf),
            "new-session",
            "-d",
            "-s",
            "i",
            "-n",
            "w1",
            "sleep 300",
        )
        raw(inner, "split-window", "-h", "-t", "i:w1", "sleep 300")
        panes = raw(inner, "list-panes", "-t", "i:w1", "-F", "#{pane_id}").splitlines()
        if len(panes) != 2:
            raise TestFailure(f"popup fixture wanted 2 panes, got {panes}")
        agent_pane, user_pane = panes
        wid = raw(inner, "display-message", "-p", "-t", "i:w1", "#{window_id}")

        raw(inner, "select-pane", "-t", user_pane)
        raw(
            outer,
            "-f",
            "/dev/null",
            "new-session",
            "-d",
            "-s",
            "o",
            "-x",
            "120",
            "-y",
            "30",
            f"tmux -L {inner} attach -t i",
        )
        time.sleep(1.0)

        subprocess.run(
            [
                "python3",
                str(AGENT_ATTENTION),
                "event",
                "--window",
                wid,
                "--pane",
                agent_pane,
                "--state",
                "blocked",
            ],
            capture_output=True,
            text=True,
            env=sub_env,
            check=True,
        )

        def state() -> str:
            return raw(inner, "display-message", "-p", "-t", wid, "#{@agent_state}")

        expect("the agent is blocked before the popup", state(), "blocked")
        expect(
            "the user is sitting in the sibling pane",
            raw(inner, "display-message", "-p", "-t", "i:w1", "#{pane_id}"),
            user_pane,
        )

        # An inert popup: it displays nothing and touches no agent state.
        # Closing it hands focus back to the pane that already had it.
        raw(inner, "display-popup", "-w", "60%", "-h", "40%", "-E", "sleep 0.4")
        time.sleep(1.5)

        expect("dismissing an inert popup does not clear blocked", state(), "blocked")

        # And the hook is genuinely live on this server -- otherwise the
        # assertion above would pass for the boring reason.
        raw(inner, "select-pane", "-t", agent_pane)
        time.sleep(1.0)
        expect(
            "the hook is wired: really focusing the agent pane clears it",
            state(),
            "",
        )
    finally:
        raw(outer, "kill-server")
        raw(inner, "kill-server")
        _unlink_socket(outer)
        _unlink_socket(inner)
        shutil.rmtree(tmpdir, ignore_errors=True)


def run_writer_vocabulary_tests() -> None:
    """Every state name written by a non-Python writer must exist in AgentState.

    The extension test above proves the pi path end to end, but the opencode
    plugin reaches tmux through ``notify`` and ``.tmux.conf`` only reads the
    values. This is the cheap half of the contract: a static check that no
    writer or reader names a state the enum does not define. It catches a
    rename in a file the runtime test never loads.
    """
    print("\n[agent-state contract: shared vocabulary]")

    known = {s.name for s in AgentState}

    ts = (
        REPO_ROOT / "pi" / ".pi" / "agent" / "extensions" / "agent-attention.ts"
    ).read_text(encoding="utf-8")
    written = set(re.findall(r'"@agent_state",\s*"([a-z]+)"', ts))
    expect_truthy("the pi extension writes at least one state", written)

    # The focus-clear can only tell the agent's pane from its siblings if
    # the pane reaches the event row, and the pi path is where most agents
    # write from. Dropping --pane here would silently restore the
    # window-granularity bug for every pi agent while every state name
    # still checked out.
    #
    # Matched on the argument *list* rather than a one-line call shape:
    # prettier reflows these across lines as they grow, and a regex
    # anchored to the single-line form quietly matches fewer call sites
    # than exist -- which is a coverage hole that looks like a pass.
    event_calls = re.findall(r'script\(\[\s*"event"(.*?)\]\)', ts, re.S)
    expect(
        "both pi event call sites are found",
        len(event_calls),
        ts.count('"event",') + ts.count('"event"\n'),
    )
    expect_truthy("the pi extension has event call sites to check", event_calls)
    for call in event_calls:
        state_arg = re.search(r'"--state",\s*"([a-z]+)"', call)
        label = state_arg.group(1) if state_arg else "?"
        expect(
            f"the pi extension records its pane on the {label!r} event",
            "--pane" in call,
            True,
        )
    for name in sorted(written):
        expect(f"pi extension state {name!r} exists in AgentState", name in known, True)

    conf = TMUX_CONF.read_text(encoding="utf-8")
    compared = set(re.findall(r"==:#\{@agent_state\},([a-z]+)\}", conf))
    expect_truthy(".tmux.conf compares against at least one state", compared)
    for name in sorted(compared):
        expect(f".tmux.conf state {name!r} exists in AgentState", name in known, True)

    # The glyph table must cover everything the config can switch on.
    for name in sorted(compared):
        expect(
            f"state {name!r} switched on in .tmux.conf has a glyph",
            any(s.name == name for s in STATE_GLYPH),
            True,
        )

    # The opencode plugin must keep calling the script the contract lives in.
    plugin = (
        REPO_ROOT / "opencode" / ".config" / "opencode" / "plugin" / "notify.ts"
    ).read_text(encoding="utf-8")
    expect(
        "the opencode plugin still targets agent-attention",
        "tmux/scripts/agent-attention" in plugin,
        True,
    )
    expect(
        "the opencode plugin still uses the notify subcommand",
        "notify" in plugin,
        True,
    )


# Format fields an in-pane program can write, and so must never be
# interpolated into a string tmux hands to `sh -c`:
#   pane_title           -- any program, via a bare OSC 2 escape
#   window_name          -- OSC 0/2 under automatic-rename, or rename-window
#   pane_current_path    -- mkdir a hostile directory name and cd into it
#   pane_current_command -- an argv[0] of the attacker's choosing
TAINTED_FIELDS = (
    "pane_title",
    "window_name",
    "pane_current_path",
    "pane_current_command",
)


def run_format_injection_tests() -> None:
    """tmux format expansion into a shell command line is code execution.

    Regression: ``@win_label`` interpolated ``#{pane_title}`` into a
    ``#(...)`` command. tmux builds ONE string from that and runs it with
    ``sh -c``, so a pane title of ``x"; touch /tmp/pwned; echo "y`` --
    which any program in the pane can set with a bare OSC 2 escape --
    executed as the tmux server user on every status redraw. There is no
    argv to protect, so quoting is not a fix; the only fix is keeping
    pane-writable values off the command line entirely.

    Two halves: a static audit of every shell-bound line in .tmux.conf,
    and one live render that really would create a file if the audit ever
    missed a spot.
    """
    print("\n[format injection]")

    conf = TMUX_CONF.read_text(encoding="utf-8")
    # Lines whose content reaches `sh -c`: a #(...) inside a format, or a
    # run-shell / if-shell command (which are format-expanded first).
    shell_lines = [
        line
        for line in conf.splitlines()
        if not line.lstrip().startswith("#")
        and ("#(" in line or "run-shell" in line or "if-shell" in line)
    ]
    expect_truthy(".tmux.conf has shell-bound format lines to audit", shell_lines)
    for line in shell_lines:
        for field in TAINTED_FIELDS:
            expect(
                f"no #{{{field}}} on a shell command line: {line[:48]!r}",
                f"#{{{field}}}" in line,
                False,
            )

    # The label option must stay window-id-only; that is the whole fix,
    # and it is one careless edit away from regressing.
    win_label = next(
        (ln for ln in conf.splitlines() if ln.startswith("set -g @win_label ")), ""
    )
    expect_truthy(".tmux.conf defines @win_label", bool(win_label))
    expect(
        "@win_label interpolates only tmux-minted fields",
        sorted(set(re.findall(r"#\{([a-z_]+)\}", win_label))),
        ["window_id"],
    )

    _assert_hostile_title_renders_inertly()


def _assert_hostile_title_renders_inertly() -> None:
    """Render the real @win_label line against a hostile pane title.

    Harness note: a detached server never draws a status line, so nothing
    expands and the assertion would pass vacuously. The render needs a
    *client*. So: an inner server holding the config under test, and an
    outer server whose only pane runs ``tmux -L inner attach`` to give it
    one.
    """
    inner = f"{SOCKET}-inj-in"
    outer = f"{SOCKET}-inj-out"
    tmpdir = Path(tempfile.mkdtemp(prefix="tmux-injection-test-"))
    canary = tmpdir / "PWNED"
    payload = f'x"; touch {canary}; echo "y'

    win_label = next(
        ln
        for ln in TMUX_CONF.read_text(encoding="utf-8").splitlines()
        if ln.startswith("set -g @win_label ")
    )
    conf = tmpdir / "inner.conf"
    conf.write_text(
        "set -g status on\n"
        "set -g status-interval 1\n"
        "set -g status-right ''\n"
        f"{win_label}\n"
        "set -g window-status-format '[#{E:@win_label}]'\n"
        "set -g window-status-current-format '[#{E:@win_label}]'\n"
        # #{T:...} is a third expansion form over the same option; the
        # original report flagged it, so exercise it in the same render.
        "set -g set-titles on\n"
        'set -g set-titles-string "#S #{T:@win_label}"\n',
        encoding="utf-8",
    )

    def raw(socket: str, *args: str) -> str:
        return subprocess.run(
            ["tmux", "-L", socket, *args], capture_output=True, text=True
        ).stdout

    try:
        raw(inner, "kill-server")
        raw(outer, "kill-server")
        time.sleep(0.2)
        raw(
            inner,
            "-f",
            str(conf),
            "new-session",
            "-d",
            "-s",
            "i",
            "-n",
            "w1",
            "sleep 300",
        )
        raw(inner, "select-pane", "-t", "i:w1", "-T", payload)
        expect(
            "the hostile pane title was actually set",
            raw(inner, "display-message", "-p", "-t", "i:w1", "#{pane_title}").strip(),
            payload,
        )

        raw(
            outer,
            "-f",
            "/dev/null",
            "new-session",
            "-d",
            "-s",
            "o",
            "-x",
            "120",
            "-y",
            "30",
            f"tmux -L {inner} attach -t i",
        )

        # Let the attached client run several status redraws. Stop early
        # only on the bad outcome, so a pass always waits the full budget
        # rather than racing the first redraw.
        deadline = time.monotonic() + 6.0
        rendered = ""
        while time.monotonic() < deadline:
            rendered = raw(outer, "capture-pane", "-p", "-t", "o")
            if canary.exists():
                break
            time.sleep(0.25)

        expect_truthy(
            "the attached client rendered a window-status line",
            "[" in rendered and "]" in rendered,
        )
        expect(
            "a hostile pane title executes nothing during status expansion",
            canary.exists(),
            False,
        )
    finally:
        raw(outer, "kill-server")
        raw(inner, "kill-server")
        _unlink_socket(outer)
        _unlink_socket(inner)
        shutil.rmtree(tmpdir, ignore_errors=True)


def _import_script(path: Path, name: str):
    """Load an extensionless script as a module so its pure helpers are testable.

    These scripts have no ``.py`` extension, so we go through SourceFileLoader
    rather than the more usual ``spec_from_file_location`` shortcut. The module
    must be registered in ``sys.modules`` before exec: ``@dataclass`` resolves
    ``cls.__module__`` through that table and raises AttributeError if absent.
    """
    import importlib.machinery
    import importlib.util
    import sys

    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(name, loader)
    if spec is None:
        raise TestFailure(f"could not build module spec for {path}")
    mod = importlib.util.module_from_spec(spec)
    sys.modules[name] = mod
    sys.path.insert(0, str(SCRIPT_DIR))
    try:
        loader.exec_module(mod)
    finally:
        sys.path.remove(str(SCRIPT_DIR))
    return mod


def _import_cheatsheet():
    return _import_script(CHEATSHEET, "cheatsheet_mod")


def run_status_ai_injection_tests() -> None:
    """@ai_status must never carry upstream text.

    ``.tmux.conf`` reads the option through ``#{E:...}``, which re-expands the
    tmux format language, so a ``#(...)`` sequence in the value is executed as
    a shell command at every status refresh (verified on a live server: a value
    of ``pre-#(echo PWNED)-post`` rendered as ``pre-PWNED-post``). status-ai is
    the sole writer, so the guard belongs there: only STATE_GLYPH glyphs,
    digits and spaces may reach the option.
    """
    status_ai = _import_script(STATUS_AI, "status_ai_mod")
    glyph = status_ai.STATE_GLYPH
    style = status_ai.STATE_STYLE

    hostile = 'pre-#(touch /tmp/PWNED_STATUS_AI)-#{host}-#[fg=red]-"post"'

    with tempfile.TemporaryDirectory(prefix="status-ai-injection-") as tmp:
        stub = Path(tmp) / "agent-attention"
        stub.write_text(
            "#!/bin/sh\nprintf '%s'" + f" {shlex.quote(hostile)}\n",
            encoding="utf-8",
        )
        stub.chmod(0o755)

        recorded: dict[str, str] = {}

        def fake_tmux_cmd(*args: str, **kwargs: object) -> None:
            # set-option -gq <name> <value>
            recorded[args[2]] = args[3]

        original_script = status_ai.SCRIPT
        original_cmd = status_ai.tmux_cmd
        status_ai.SCRIPT = stub
        status_ai.tmux_cmd = fake_tmux_cmd
        try:
            status_ai.main()
        finally:
            status_ai.SCRIPT = original_script
            status_ai.tmux_cmd = original_cmd

    value = recorded.get("@ai_status", "<unset>")
    expect_truthy("status-ai wrote @ai_status", "@ai_status" in recorded)
    expect("hostile output does not reach @ai_status", hostile in value, False)
    expect("@ai_status is inert for hostile input", value, status_ai.INERT)
    expect(
        "the retired @ai_status_state is gone", "@ai_status_state" in recorded, False
    )

    # The value carries style tags now, so the closed-vocabulary check runs
    # against the *worst* render this script can produce with every state
    # populated and rolled up -- the widest vocabulary it can reach.  Rollup
    # emits digits, which were already in the vocabulary (the old "+N" tail
    # used them), so it must not widen the E: sink by a single character.
    widest = status_ai.render(
        "crashed\t2\nblocked\t5\ndone\t4\nworking\t99999999\nidle\t9"
    )
    for seq in ("#(", "#{"):
        expect(f"@ai_status contains no {seq!r}", seq in widest, False)
    # Strip only the style tags status-ai builds itself; whatever remains had
    # better be glyphs, digits, spaces, the icon and the overflow '+'.
    residue = re.sub(r"#\[(?:fg=\#[0-9a-f]{6}|bold|nobold)\]", "", widest)
    allowed = set(glyph.values()) | set("0123456789 +") | {status_ai.ICON}
    stray = sorted(set(residue) - allowed)
    expect(f"@ai_status stays in the closed vocabulary (stray={stray})", stray, [])
    expect("no '#' survives outside a style tag", "#" in residue, False)

    # The icon is the wide-escape robot, not U+F06A followed by '9'.
    expect("the icon is a single U+F06A9 codepoint", len(status_ai.ICON), 1)
    expect("the icon is nf-md-robot", ord(status_ai.ICON), 0xF06A9)

    # --- render_segment: the pure unit -------------------------------
    def seg(counts, threshold=status_ai.ROLLUP_THRESHOLD):
        return status_ai.render_segment(counts, threshold)

    expect(
        "one glyph per agent, grouped and colored per state",
        seg(
            {
                AgentState.crashed: 1,
                AgentState.blocked: 2,
                AgentState.working: 3,
                AgentState.idle: 2,
            }
        ),
        (
            f"{style[AgentState.crashed]}{glyph[AgentState.crashed]} "
            f"{style[AgentState.blocked]}{glyph[AgentState.blocked] * 2} "
            f"{style[AgentState.working]}{glyph[AgentState.working] * 3} "
            f"{style[AgentState.idle]}{glyph[AgentState.idle] * 2}"
        ),
    )
    expect(
        "no agents renders empty so the segment stays hidden",
        seg({}),
        "",
    )
    expect(
        "a zero count contributes no glyph and no run",
        seg({AgentState.working: 0, AgentState.idle: 1}),
        f"{style[AgentState.idle]}{glyph[AgentState.idle]}",
    )

    # --- per-state rollup --------------------------------------------
    #
    # The point of the rollup is a better failure mode for big fleets, not a
    # redesign of the common case: at or below the threshold the bytes are the
    # ones the glyph-per-agent scheme produced, column for column.
    for n in range(status_ai.ROLLUP_THRESHOLD + 1):
        expect(
            f"{n} working is still {n} literal glyphs, byte-identical to before",
            seg({AgentState.working: n}),
            f"{style[AgentState.working]}{glyph[AgentState.working] * n}" if n else "",
        )
    expect(
        "exactly at the threshold stays a shape",
        seg({AgentState.blocked: 3}),
        f"{style[AgentState.blocked]}{glyph[AgentState.blocked] * 3}",
    )
    expect(
        "one past the threshold rolls up to <N><glyph>, not four glyphs",
        seg({AgentState.blocked: 4}),
        f"{style[AgentState.blocked]}4{glyph[AgentState.blocked]}",
    )
    # Mutation guard for the boundary: an off-by-one in `count <= threshold`
    # is invisible in normal use, so pin both sides at a threshold the
    # constant does not supply.
    expect(
        "the threshold is a parameter: at t=5, five glyphs stay a shape",
        seg({AgentState.idle: 5}, threshold=5),
        f"{style[AgentState.idle]}{glyph[AgentState.idle] * 5}",
    )
    expect(
        "the threshold is a parameter: at t=5, six agents roll up",
        seg({AgentState.idle: 6}, threshold=5),
        f"{style[AgentState.idle]}6{glyph[AgentState.idle]}",
    )
    expect(
        "at t=0 even a single agent is a number",
        seg({AgentState.idle: 1}, threshold=0),
        f"{style[AgentState.idle]}1{glyph[AgentState.idle]}",
    )
    # The defect this replaced: a global "+N" tail made these two fleets look
    # the same. Per-state rollup keeps them distinguishable.
    nine_blocked = seg(
        {AgentState.crashed: 1, AgentState.blocked: 3, AgentState.working: 9}
    )
    nine_done = seg({AgentState.crashed: 1, AgentState.done: 3, AgentState.working: 9})
    expect("different fleets no longer render alike", nine_blocked == nine_done, False)
    expect(
        "mixed shapes and numbers coexist in one render, urgency-ordered",
        seg(
            {
                AgentState.crashed: 2,
                AgentState.blocked: 5,
                AgentState.done: 4,
                AgentState.working: 6,
                AgentState.idle: 3,
            }
        ),
        (
            f"{style[AgentState.crashed]}{glyph[AgentState.crashed] * 2} "
            f"{style[AgentState.blocked]}5{glyph[AgentState.blocked]} "
            f"{style[AgentState.done]}4{glyph[AgentState.done]} "
            f"{style[AgentState.working]}6{glyph[AgentState.working]} "
            f"{style[AgentState.idle]}{glyph[AgentState.idle] * 3}"
        ),
    )
    # No state can be swallowed by a rollup any more: every populated state
    # keeps its own glyph, however lopsided the fleet.
    lopsided = seg(dict.fromkeys(glyph, 40))
    for state in glyph:
        expect_truthy(
            f"{state.name} survives a fleet where every state rolls up",
            f"40{glyph[state]}" in lopsided,
        )
    expect(
        "a count past MAX_COUNT is clamped, so the option stays short",
        seg({AgentState.working: 10**12}),
        f"{style[AgentState.working]}{status_ai.MAX_COUNT}+{glyph[AgentState.working]}",
    )

    # --- render: parsing + the icon wrapper ---------------------------
    def body(runs: str) -> str:
        return f" {status_ai.ICON_STYLE}{status_ai.ICON} {runs} "

    expect(
        "a well-formed status still renders",
        status_ai.render("crashed\t2"),
        body(f"{style[AgentState.crashed]}{glyph[AgentState.crashed] * 2}"),
    )
    expect(
        "every state is shown at once, not just the worst",
        status_ai.render("blocked\t2\nworking\t3\nidle\t1"),
        body(
            f"{style[AgentState.blocked]}{glyph[AgentState.blocked] * 2} "
            f"{style[AgentState.working]}{glyph[AgentState.working] * 3} "
            f"{style[AgentState.idle]}{glyph[AgentState.idle]}"
        ),
    )
    expect(
        "line order does not decide run order; urgency does",
        status_ai.render("idle\t1\ncrashed\t1"),
        body(
            f"{style[AgentState.crashed]}{glyph[AgentState.crashed]} "
            f"{style[AgentState.idle]}{glyph[AgentState.idle]}"
        ),
    )
    expect(
        "a hostile line is dropped, the good one still renders",
        status_ai.render("#(touch /tmp/PWNED)\t1\nworking\t2"),
        body(f"{style[AgentState.working]}{glyph[AgentState.working] * 2}"),
    )
    expect(
        "a non-numeric count drops its line",
        status_ai.render("crashed\t#{host}\nidle\t2"),
        body(f"{style[AgentState.idle]}{glyph[AgentState.idle] * 2}"),
    )
    expect(
        "no output still hides the segment",
        status_ai.render(""),
        "",
    )
    expect(
        "all-garbage input renders an inert marker, not the garbage",
        status_ai.render("#(id)\ncleared\t1"),
        status_ai.INERT,
    )
    expect(
        "a huge upstream count renders as a clamped number, not a wall",
        status_ai.render("working\t99999999"),
        body(
            f"{style[AgentState.working]}"
            f"{status_ai.MAX_COUNT}+{glyph[AgentState.working]}"
        ),
    )
    # MAX_COUNT is what bounds the *length* of a value .tmux.conf re-expands
    # through #{E:...}; the old glyph cap is gone, so pin the guarantee here.
    absurd = re.sub(
        r"#\[(?:fg=\#[0-9a-f]{6}|bold|nobold)\]",
        "",
        status_ai.render("working\t" + "9" * 400),
    )
    expect_truthy(
        f"an absurd upstream count stays a short option ({len(absurd)} chars)",
        len(absurd) < 20,
    )


def run_tms_tests() -> None:
    """Guard the picker render path against palette drift.

    Regression: ``Entry.visible_text`` read ``CATPPUCCIN["red"]`` for crashed
    agents while the generated palette block defined no ``red`` key, so the
    whole picker died with KeyError exactly when a crashed agent existed.
    """
    tms = _import_script(TMS, "tms_mod")

    for state in AgentState:
        entry = tms.Entry(kind="tmux", name="w", session_name="s", worst_state=state)
        try:
            rendered = entry.visible_text()
        except KeyError as exc:
            raise TestFailure(
                f"visible_text() raised KeyError({exc}) for AgentState.{state.name}"
            ) from exc
        expect(
            f"visible_text renders for AgentState.{state.name}",
            bool(rendered),
            True,
        )

    # Every colour the render path can reach must exist in the palette.
    for key in ("red", "peach", "teal", "sky", "sapphire", "lavender", "subtext0"):
        expect(f"palette defines {key!r}", key in tms.CATPPUCCIN, True)

    # done is "finished but not yet seen": teal, and informational only. It
    # gets its own branch so it does not fall through to the kind colour,
    # but it must stay below the crashed/attention branches -- a blocked or
    # crashed agent in the same session still owns the row.
    # visible_text emits truecolor SGR, not hex, so compare against the
    # escape ansi_style() would produce for that palette entry.
    def fg_seq(key: str) -> str:
        hexcolor = tms.CATPPUCCIN[key]
        r, g, b = (int(hexcolor[i : i + 2], 16) for i in (1, 3, 5))
        return f"38;2;{r};{g};{b}"

    done = tms.Entry(
        kind="tmux", name="w", session_name="s", worst_state=AgentState.done
    )
    done_text = done.visible_text()
    expect_truthy("done rows render teal", fg_seq("teal") in done_text)
    expect_truthy(
        "done rows keep the done glyph", STATE_GLYPH[AgentState.done] in done_text
    )
    # Deliberately a state AgentStats cannot produce (a session with a done
    # and a blocked agent reports worst_state=blocked). It is the only way to
    # observe branch order, and order is the invariant: done is informational
    # and must never take the row away from an alarm.
    done_and_blocked = tms.Entry(
        kind="tmux",
        name="w",
        session_name="s",
        worst_state=AgentState.done,
        attention_count=1,
    )
    rendered = done_and_blocked.visible_text()
    expect_truthy("attention outranks done", fg_seq("peach") in rendered)
    expect("attention row is not teal", fg_seq("teal") in rendered, False)

    # The palette is generated; an unreferenced key means the template drifted.
    source = TMS.read_text(encoding="utf-8")
    for key in tms.CATPPUCCIN:
        uses = source.count(f'CATPPUCCIN["{key}"]') + source.count(
            f"CATPPUCCIN['{key}']"
        )
        expect(f"palette key {key!r} is referenced", uses > 0, True)

    # .tmux.conf cannot import STATE_GLYPH, so its format chain is a
    # generated region. Assert the glyphs actually reached it, and that the
    # two window-status lines go through the shared option rather than each
    # re-spelling the conditional (the drift this replaced).
    conf = TMUX_CONF.read_text(encoding="utf-8")
    chain = next(
        (ln for ln in conf.splitlines() if ln.startswith("set -g @agent_glyphs ")),
        "",
    )
    expect_truthy("tmux.conf defines @agent_glyphs", bool(chain))
    for state, glyph in STATE_GLYPH.items():
        expect(
            f"@agent_glyphs carries the {state.name} glyph",
            glyph in chain,
            True,
        )
    for fmt in ("window-status-format", "window-status-current-format"):
        line = next(
            (ln for ln in conf.splitlines() if ln.startswith(f"set -g {fmt} ")), ""
        )
        expect(f"{fmt} uses the shared chain", "#{E:@agent_glyphs}" in line, True)
        expect(f"{fmt} spells no glyph inline", "@agent_state},crashed" in line, False)

    # `cleared` is the absence of state, so it deliberately has no glyph.
    expect(
        "every displayable AgentState has a glyph",
        sorted(STATE_GLYPH)
        == sorted(s for s in AgentState if s is not AgentState.cleared),
        True,
    )

    run_tms_row_tests(tms)
    run_tms_path_tests(tms)
    run_tms_entry_tests(tms)


def run_tms_row_tests(tms) -> None:
    """The Entry <-> fzf row round trip.

    The picker serialises entries to tab-joined rows and parses the selected
    one back. Field order lives in FZF_ROW_FIELDS and is consumed by both
    halves, so a mismatch is silent until someone opens a session at the
    wrong path.
    """
    print()
    entry = tms.Entry(
        kind="default",
        name="proj",
        session_name="proj",
        path="/tmp/proj",
        startup="nvim",
        split="vertical",
    )
    payload = tms.EntryPayload.from_fzf_row(entry.to_fzf_row())
    expect("round trip keeps session_name", payload.session_name, "proj")
    expect("round trip keeps path", payload.path, "/tmp/proj")
    expect("round trip keeps startup", payload.startup, "nvim")
    expect("round trip keeps split", payload.split, "vertical")

    # Trailing empty fields are the fragile case: str.split keeps them, but
    # only if the producer emitted them. An entry with no startup/split ends
    # in two empty columns.
    bare = tms.Entry(kind="tmux", name="s", session_name="s", path="/tmp/s")
    row = bare.to_fzf_row()
    expect(
        "empty trailing fields survive serialisation",
        len(row.split("\t")),
        len(tms.FZF_ROW_FIELDS),
    )
    bare_payload = tms.EntryPayload.from_fzf_row(row)
    expect("empty path/startup become None", bare_payload.startup, None)
    expect(
        "empty split falls back to the default", bare_payload.split, tms.DEFAULT_SPLIT
    )

    # A row that lost a column must fail loudly rather than shift fields.
    try:
        tms.Entry.from_fzf_row("a\tb")
        expect("short picker row raises ConfigError", "no raise", "ConfigError")
    except tms.ConfigError:
        expect("short picker row raises ConfigError", "ConfigError", "ConfigError")


def run_tms_path_tests(tms) -> None:
    """Session-name normalisation and the path filter.

    `session_name_for_path` has to agree with tmux's own name mangling or
    create-then-attach targets different sessions; `is_useful_path` is what
    keeps the picker from listing every node_modules on the disk.
    """
    expect(
        "dots normalise to underscores",
        tms.sanitize_session_part("a.b"),
        "a_b",
    )
    expect(
        "runs of punctuation collapse to one dash",
        tms.sanitize_session_part("a  b//c"),
        "a-b-c",
    )
    expect(
        "leading/trailing separators are trimmed",
        tms.sanitize_session_part("--x--"),
        "x",
    )

    home = Path.home()
    expect(
        "a dotted dir under $HOME normalises",
        tms.session_name_for_path(str(home / "a.b" / "c")),
        "a_b/c",
    )
    expect(
        "a path that sanitises away still yields a name",
        tms.session_name_for_path("/"),
        "session",
    )

    config = tms.TmsConfig(
        sessions=(),
        blacklist=frozenset({".cache"}),
        noisy_basenames=frozenset({"node_modules"}),
        find_max_depth=2,
        preview_command="true",
    )
    cases = (
        (str(home / "code"), "find", True, "a plain project dir is useful"),
        (str(home / ".cache"), "find", False, "a blacklisted basename is not"),
        (
            str(home / "code" / "node_modules"),
            "find",
            False,
            "a noisy basename is not",
        ),
        (
            str(home / "code" / "node_modules" / "pkg"),
            "find",
            False,
            "a noisy path segment rejects its children",
        ),
        (str(home / ".ssh"), "find", False, "a dotdir is not useful"),
        (
            str(home / "dotfiles" / "tmux"),
            "find",
            False,
            "inside the dotfiles repo is not (the repo root itself is)",
        ),
        (
            str(home / "a" / "b" / "c"),
            "zoxide",
            False,
            "zoxide mode stops at two levels below $HOME",
        ),
        (str(home / "a" / "b"), "zoxide", True, "two levels is still fine"),
    )
    for path, mode, want, name in cases:
        expect(name, tms.is_useful_path(path, mode=mode, config=config), want)


def run_tms_entry_tests(tms) -> None:
    """build_entries: which sessions appear, in what order, merged with what.

    This is the function the picker is, and it had no coverage. Stub the two
    outside sources (live tmux sessions, agent state) so the merge logic is
    the only thing under test.
    """
    from _tmux_common import AgentStats

    configured = (
        tms.SessionConfig(name="dotfiles", path="/tmp/dotfiles", startup="yazi"),
        tms.SessionConfig(name="notes", path="/tmp/notes"),
    )
    config = tms.TmsConfig(
        sessions=configured,
        blacklist=frozenset(),
        noisy_basenames=frozenset(),
        find_max_depth=1,
        preview_command="true",
    )

    stats = AgentStats()
    stats._by_session = {
        "notes": AgentStats(blocked=1),
        "zed": AgentStats(crashed=1),
    }

    originals = (
        tms.load_config,
        tms.list_tmux_sessions,
        tms.scan_agent_states,
        tms.zoxide_paths,
    )
    tms.load_config = lambda: config
    # Deliberately unsorted, and overlapping the configured set.
    tms.list_tmux_sessions = lambda: ["zed", "notes", "alpha"]
    tms.scan_agent_states = lambda: stats
    # `all` mode also merges zoxide; silence it so only the session merge
    # is under test (build_path_entries has its own coverage above).
    tms.zoxide_paths = list
    try:
        entries = tms.build_entries("all")
        names = [e.name for e in entries]
        expect(
            "configured sessions come first, in config order",
            names[:2],
            ["dotfiles", "notes"],
        )
        expect(
            "a live session that is also configured is not listed twice",
            names.count("notes"),
            1,
        )
        expect(
            "remaining live sessions follow, sorted",
            names[2:],
            ["alpha", "zed"],
        )

        by_name = {e.name: e for e in entries}
        expect(
            "a configured session that is live is marked running",
            by_name["notes"].is_running,
            True,
        )
        expect(
            "a configured session that is not live is not",
            by_name["dotfiles"].is_running,
            False,
        )
        expect(
            "agent state attaches to the configured entry",
            by_name["notes"].worst_state,
            AgentState.blocked,
        )
        expect(
            "agent state attaches to a bare live session",
            by_name["zed"].worst_state,
            AgentState.crashed,
        )
        expect(
            "a session with no agent has no state",
            by_name["alpha"].worst_state,
            None,
        )
        expect(
            "configured metadata survives the merge",
            (by_name["dotfiles"].startup, by_name["dotfiles"].path),
            ("yazi", "/tmp/dotfiles"),
        )

        # `tmux` mode is the live-only view: configured-but-dead drops out.
        live_names = [e.name for e in tms.build_entries("tmux")]
        expect(
            "tmux mode lists only live sessions", live_names, ["alpha", "notes", "zed"]
        )

        # `default` mode is the pinned list, whether or not it is running.
        expect(
            "default mode lists only configured sessions",
            [e.name for e in tms.build_entries("default")],
            ["dotfiles", "notes"],
        )
    finally:
        (
            tms.load_config,
            tms.list_tmux_sessions,
            tms.scan_agent_states,
            tms.zoxide_paths,
        ) = originals


def run_cheatsheet_tests() -> None:
    cs = _import_cheatsheet()

    # parse_keys: skip blank lines, split on first whitespace, strip empty notes.
    sample = (
        "s       session picker (tms)\n"
        "v       clipboard history\n"
        "\n"
        "X       \n"  # empty note: must be skipped
        "M-Up    Resize the pane up by 5\n"
    )
    expect(
        "parse_keys handles blanks and empty-note lines",
        cs.parse_keys(sample),
        [
            ("s", "session picker (tms)"),
            ("v", "clipboard history"),
            ("M-Up", "Resize the pane up by 5"),
        ],
    )

    expect("classify(s) -> Sessions", cs.classify("s"), "Sessions")
    expect("classify(0) -> Windows", cs.classify("0"), "Windows")
    expect("classify(C-Up) -> Resize", cs.classify("C-Up"), "Resize")
    expect("classify(M-Up) -> Resize", cs.classify("M-Up"), "Resize")
    expect("classify(C-z) -> None", cs.classify("C-z"), None)
    # Curated sections must track the real bindings in .tmux.conf: `a` is the
    # agent picker (was missing, so it fell into "Other"), S-<arrow> are the
    # sway-style pane swaps, and `y` is copy-mode-vi only — never in the
    # prefix table, so it must not be advertised as a prefix key.
    expect("classify(a) -> Tools", cs.classify("a"), "Tools")
    expect("classify(S-Left) -> Panes", cs.classify("S-Left"), "Panes")
    expect("classify(y) -> None", cs.classify("y"), None)

    # format_sections: only categorised keys appear; section headers; blank between.
    entries = [
        ("s", "session picker"),
        ("r", "resize cycle"),
        ("v", "clipboard"),
        ("C-z", "suspend client"),  # uncategorised
    ]
    out = cs.format_sections(entries, show_all=False)
    expect_truthy("format_sections includes Sessions header", "── Sessions ──" in out)
    expect_truthy("format_sections includes Resize header", "── Resize ──" in out)
    expect_truthy(
        "format_sections excludes uncategorised by default",
        not any("suspend client" in line for line in out),
    )
    expect_truthy(
        "format_sections does not show Other without --all",
        "── Other ──" not in out,
    )

    # show_all=True surfaces uncategorised under "Other".
    out_all = cs.format_sections(entries, show_all=True)
    expect_truthy("format_sections show_all surfaces Other", "── Other ──" in out_all)
    expect_truthy(
        "format_sections show_all includes the uncategorised note",
        any("suspend client" in line for line in out_all),
    )

    # Section ordering must be deterministic and follow SECTION_ORDER.
    section_lines = [line for line in out_all if line.startswith("── ")]
    expect_truthy(
        "sections appear in declared order",
        section_lines
        == [f"── {s} ──" for s in ["Sessions", "Resize", "Copy & Pick", "Other"]],
    )

    # render_extras always includes the static plugin + no-prefix sections.
    extras = cs.render_extras()
    expect_truthy("render_extras includes Plugins block", "── Plugins ──" in extras)
    expect_truthy("render_extras includes No prefix block", "── No prefix ──" in extras)

    # Live integration: --no-picker must produce non-empty, well-formed output.
    proc = subprocess.run(
        [str(CHEATSHEET), "--no-picker"], capture_output=True, text=True
    )
    expect("cheatsheet --no-picker exits 0", proc.returncode, 0)
    expect_truthy("cheatsheet --no-picker has output", bool(proc.stdout.strip()))
    expect_truthy(
        "cheatsheet --no-picker contains Sessions header",
        "── Sessions ──" in proc.stdout,
    )


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--keep", action="store_true", help="Keep tmux server and tmp dir on exit"
    )
    parser.add_argument(
        "-v", "--verbose", action="store_true", help="Show all subprocess output"
    )
    args = parser.parse_args()

    if shutil.which("tmux") is None:
        print("tmux not installed; aborting.")
        return 1

    tmpdir = tempfile.mkdtemp(prefix="tmux-status-tools-test-")
    env: dict[str, str] = {
        **os.environ,
        "XDG_STATE_HOME": tmpdir,
        "TMUX_AGENT_ATTENTION_DISABLE_SYSTEM_NOTIFY": "1",
        # Pin the script to our isolated tmux server.
        "TMUX_SOCKET_NAME": SOCKET,
    }
    # Ensure the script never picks up a stray TMUX env from this shell.
    env.pop("TMUX_PANE", None)
    env.pop("TMUX", None)
    # The pi extension branches on this. When the suite runs *inside* a
    # managed agent pane the variable is already 1, which would silently
    # switch agent_end to the clear-only path and make the contract test
    # assert different behavior than it does on a developer box or in CI.
    env.pop("MU_MANAGED_AGENT", None)

    print(f"socket   : {SOCKET}")
    print(f"tmpdir   : {tmpdir}")
    print(f"agent-attention : {AGENT_ATTENTION}")
    print(f"status-window-label: {STATUS_WINDOW_LABEL}")

    try:
        panes = setup_server(env)
        if args.verbose:
            print("panes:", panes)
        run_tests(env, panes)
    finally:
        if not args.keep:
            teardown_server(env)
            shutil.rmtree(tmpdir, ignore_errors=True)
        else:
            print(f"\nKeeping server (tmux -L {SOCKET} attach) and {tmpdir}")

    return RESULTS.report()


if __name__ == "__main__":
    raise SystemExit(main())
