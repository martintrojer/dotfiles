#!/usr/bin/env python3
"""Regression tests for what .tmux.conf still owns of the status line.

Agent state is murmur's and the glyph/pill formats are mu-crew/dotfiles';
both are tested in their own repos. What is left here, each pinned by a bug
that failed silently:

- the window label picks a useful name (it showed the hostname for a node pane);
- no pane-writable format field reaches a shell command line (a pane title
  ran as code on every status redraw);
- a 0% CPU reading still renders (tmux reads "0" as false, so the segment
  vanished and the bar shifted);
- the mu-crew glyph overrides use docs/glyphs.toml and come after the
  source-file that sets mu-crew's defaults (otherwise the defaults win).

Runs against an isolated, per-process tmux server. Exits non-zero on failure.
"""

from __future__ import annotations

import contextlib
import os
import shutil
import subprocess
import time
import tomllib
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
# scripts/ -> tmux/ -> .config/ -> <package root>, where the linked dotfile lives.
TMUX_CONF = SCRIPT_DIR.parents[2] / ".tmux.conf"
GLYPHS_TOML = SCRIPT_DIR.parents[3] / "docs" / "glyphs.toml"
# Per-process socket so concurrent runs don't kill each other's server.
SOCKET = f"test-status-tools-{os.getpid()}"
CONF = TMUX_CONF.read_text(encoding="utf-8")
CONF_LINES = CONF.splitlines()

failures: list[str] = []


def expect(name: str, got: object, want: object = True) -> None:
    if got == want:
        print(f"  ok  {name}")
    else:
        failures.append(name)
        print(f"  FAIL {name}\n    want={want!r}\n    got ={got!r}")


def conf_line(prefix: str) -> str:
    return next((ln for ln in CONF_LINES if ln.startswith(prefix)), "")


def tmux(*args: str) -> str:
    env = {k: v for k, v in os.environ.items() if k not in ("TMUX", "TMUX_PANE")}
    return subprocess.run(
        ["tmux", "-L", SOCKET, *args], capture_output=True, text=True, env=env
    ).stdout.strip()


def start_server() -> str:
    """Start a server with one pane; return its pane id.

    kill-server returns before the socket is released, so a fresh start can
    briefly fail; retry rather than flake.
    """
    for attempt in range(20):
        pane = tmux(
            "-f",
            "/dev/null",
            "new-session",
            "-d",
            "-P",
            "-F",
            "#{pane_id}",
            "sleep 300",
        )
        if pane:
            return pane
        time.sleep(0.05 * (attempt + 1))
    raise SystemExit("could not start isolated tmux server")


def test_window_label(pane: str) -> None:
    print("\n[window label]")
    for line in CONF_LINES:
        if line.startswith("set -g @win_label"):
            _set, _g, option, value = line.split(" ", 3)
            tmux("set", "-g", option, value.strip("'\""))

    def label() -> str:
        return tmux("display", "-p", "-t", pane, "#{E:@win_label}")

    def info(fmt: str) -> str:
        return tmux("display", "-p", "-t", pane, fmt)

    command, host = info("#{pane_current_command}"), info("#{host}")
    path_base = info("#{b:pane_current_path}")

    tmux("set", "-p", "-t", pane, "@murmur_pane_label", "agent task")
    expect("murmur pane label wins", label(), "agent task")
    tmux("set", "-pu", "-t", pane, "@murmur_pane_label")

    tmux("set", "-g", "@win_label_shells", f"|{command}|")
    tmux("select-pane", "-t", pane, "-T", "Side Project")
    expect("shell uses a meaningful title", label(), "Side Project")
    for title in (host, "~/project"):
        tmux("select-pane", "-t", pane, "-T", title)
        expect(f"shell rejects title {title!r}", label(), path_base)

    tmux("set", "-g", "@win_label_shells", "not-this-command")
    for title in (host, "~/project"):
        tmux("select-pane", "-t", pane, "-T", title)
        expect(f"other command rejects title {title!r}", label(), command)


def test_format_injection() -> None:
    """tmux expands formats into one string and runs it with `sh -c`, so a
    pane-writable field on a shell-bound line is code execution. Quoting is
    no fix; the field must not be there at all."""
    print("\n[format injection]")
    tainted = ("pane_title", "window_name", "pane_current_path", "pane_current_command")
    shell_lines = [
        ln
        for ln in CONF_LINES
        if not ln.lstrip().startswith("#")
        and ("#(" in ln or "run-shell" in ln or "if-shell" in ln)
    ]
    expect("found shell-bound lines to audit", bool(shell_lines))
    leaks = [(f, ln) for ln in shell_lines for f in tainted if f"#{{{f}}}" in ln]
    expect("no pane-writable field on a shell-bound line", leaks, [])
    expect("@win_label runs no shell", "#(" in conf_line("set -g @win_label "), False)
    expect(
        "status-right runs no shell", "#(" in conf_line("set -g status-right "), False
    )


def test_probe_segments() -> None:
    print("\n[probe segments]")
    for line in CONF_LINES:
        if line.startswith(("set -g @seg_", "set -g @load_")):
            _set, _g, option, value = line.split(" ", 3)
            tmux("set", "-g", option, value.strip("'"))
    status_right = conf_line("set -g status-right ").split(" ", 3)[3].strip("'")
    tmux("set", "-g", "@probe_test", status_right)
    for option, value in (
        ("@mu_crew_cpu", "0"),
        ("@mu_crew_cpu_text", "0%"),
        ("@mu_crew_mem", "95"),
        ("@mu_crew_mem_text", "95%"),
    ):
        tmux("set", "-g", option, value)
    rendered = tmux("display", "-p", "#{E:@probe_test}")
    expect("a 0% cpu reading renders", " 0% " in rendered)
    expect("a 95% ram reading renders", " 95% " in rendered)
    tmux("set", "-gu", "@mu_crew_cpu")
    tmux("set", "-gu", "@mu_crew_cpu_text")
    expect(
        "an unpublished probe draws no segment",
        " 0% " in tmux("display", "-p", "#{E:@probe_test}"),
        False,
    )


def test_glyph_overrides() -> None:
    print("\n[glyph overrides]")
    with GLYPHS_TOML.open("rb") as fp:
        glyphs = tomllib.load(fp)["glyph"]
    overrides = [
        (state, f"agent_{state}")
        for state in (
            "crashed",
            "error",
            "blocked",
            "done",
            "working",
            "waiting",
            "idle",
        )
    ] + [("crew", "crew"), ("agent", "agent_robot")]
    missing = [
        key
        for option, key in overrides
        if f"set -g @mu_crew_g_{option} '{glyphs[key]}'" not in CONF
    ]
    expect("every mu-crew glyph override uses the vocabulary", missing, [])
    expect(
        "overrides follow mu-crew's source-file",
        CONF.index('source-file "$HOME/.local/share/mu-crew-dotfiles/')
        < CONF.index("set -g @mu_crew_g_crashed"),
    )


def main() -> int:
    if shutil.which("tmux") is None:
        print("tmux not installed; aborting.")
        return 1
    tmux("kill-server")
    try:
        pane = start_server()
        test_window_label(pane)
        test_probe_segments()
    finally:
        tmux("kill-server")
        socket_dir = os.environ.get("TMUX_TMPDIR") or f"/tmp/tmux-{os.getuid()}"
        with contextlib.suppress(OSError):
            os.unlink(os.path.join(socket_dir, SOCKET))
    test_format_injection()
    test_glyph_overrides()
    print(f"\n{len(failures)} failed")
    return 1 if failures else 0


if __name__ == "__main__":
    raise SystemExit(main())
