#!/usr/bin/env python3
"""murmur on-attention hook: one desktop notification per new attention event.

murmur runs this detached with MURMUR_* set; see murmur's docs/setup.md.

The icon carries two signals at a glance: its frame is the host's accent
(MURMUR_HOST_COLOR, the same hash as tmux's hostname pill) and its glyph is
the event kind (MURMUR_GLYPH in MURMUR_KIND_COLOR), all supplied by murmur.
Icons are rendered once per (host color, kind color, glyph) with ImageMagick
and cached; without `magick`, or with an older murmur that does not set the
colors, the notification goes out without one.
"""

from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

# THEME BEGIN: murmur-notify-theme
BASE = "#1e1e2e"  # the icon's inner fill
# THEME END: murmur-notify-theme
ICON_PX = 128
FONT = "JetBrainsMono Nerd Font"
CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "murmur"


def font_file() -> str | None:
    try:
        out = subprocess.run(
            ["fc-match", "-f", "%{file}", FONT],
            capture_output=True,
            text=True,
            check=True,
        ).stdout
    except (OSError, subprocess.CalledProcessError):
        return None
    return out or None


def icon_for(accent: str, color: str, glyph: str) -> Path | None:
    """A cached PNG: accent-colored rounded frame, glyph in its color."""
    if not (accent and color and glyph) or shutil.which("magick") is None:
        return None
    key = f"{accent[1:]}-{color[1:]}-{ord(glyph[0]):x}"
    path = CACHE / f"icon-{key}.png"
    if path.is_file():
        return path
    font = font_file()
    if font is None:
        return None
    path.parent.mkdir(parents=True, exist_ok=True)
    edge, ring, radius = ICON_PX - 1, ICON_PX // 10, ICON_PX // 4
    tmp = path.with_suffix(f".{os.getpid()}.png")
    try:
        subprocess.run(
            [
                "magick",
                "-size",
                f"{ICON_PX}x{ICON_PX}",
                "xc:none",
                "-fill",
                accent,
                "-draw",
                f"roundrectangle 0,0 {edge},{edge} {radius},{radius}",
                "-fill",
                BASE,
                "-draw",
                f"roundrectangle {ring},{ring} {edge - ring},{edge - ring} "
                f"{radius - ring // 2},{radius - ring // 2}",
                "-font",
                font,
                "-pointsize",
                str(ICON_PX * 55 // 100),
                "-fill",
                color,
                "-gravity",
                "center",
                "-annotate",
                "+0+0",
                glyph,
                str(tmp),
            ],
            check=True,
            capture_output=True,
        )
        tmp.replace(path)
    except (OSError, subprocess.CalledProcessError):
        tmp.unlink(missing_ok=True)
        return None
    return path


def crew_done(kind: str) -> bool:
    """A crew agent finishing is the orchestrator's business, not mine."""
    if kind != "done":
        return False
    try:
        event = json.loads(os.environ.get("MURMUR_EVENT", "{}"))
    except json.JSONDecodeError:
        return False
    return event.get("driver") == "orchestrated"


def notify_linux(
    title: str, host: str, message: str, kind: str, icon: Path | None
) -> None:
    accent = os.environ.get("MURMUR_HOST_COLOR", "")
    # mako renders Pango markup: the host in its accent, like the tmux pill.
    body = f"<b>{escape(host)}</b>"
    if accent:
        body = f'<span foreground="{accent}">{body}</span>'
    if message:
        body += f" — {escape(message)}"
    args = [
        "notify-send",
        "-a",
        "murmur",
        "-u",
        "normal" if kind == "done" else "critical",
    ]
    if icon is not None:
        args += ["-i", str(icon)]
    subprocess.run([*args, title, body], check=False)


def notify_darwin(
    title: str, host: str, message: str, kind: str, icon: Path | None
) -> None:
    del kind  # macOS notifications have no urgency levels
    body = host + (f" — {message}" if message else "")
    if icon is not None and shutil.which("terminal-notifier"):
        subprocess.run(
            [
                "terminal-notifier",
                "-title",
                "murmur",
                "-subtitle",
                title,
                "-message",
                body,
                "-contentImage",
                str(icon),
            ],
            check=False,
        )
        return
    # argv, not string interpolation, so quotes in the message cannot break out.
    subprocess.run(
        [
            "osascript",
            "-e",
            "on run argv",
            "-e",
            'display notification (item 2 of argv) with title "murmur" '
            "subtitle (item 1 of argv)",
            "-e",
            "end run",
            title,
            body,
        ],
        check=False,
    )


def escape(text: str) -> str:
    return text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def main() -> int:
    kind = os.environ.get("MURMUR_KIND", "")
    if crew_done(kind):
        return 0
    host = os.environ.get("MURMUR_HOST", "")
    title = f"{os.environ.get('MURMUR_AGENT', '')} {kind}"
    message = os.environ.get("MURMUR_MESSAGE", "")
    icon = icon_for(
        os.environ.get("MURMUR_HOST_COLOR", ""),
        os.environ.get("MURMUR_KIND_COLOR", ""),
        os.environ.get("MURMUR_GLYPH", ""),
    )
    send = notify_darwin if sys.platform == "darwin" else notify_linux
    send(title, host, message, kind, icon)
    return 0


if __name__ == "__main__":
    sys.exit(main())
