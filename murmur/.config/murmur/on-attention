#!/bin/sh
# murmur's on-attention hook: one sound per attention event, rising with
# severity (done < blocked < error < crashed). No desktop notification: the
# tmux pill and `murmur dash` already show who it was.
# murmur runs it detached with MURMUR_* set (see murmur's docs/setup.md).

# A crew agent finishing is the orchestrator's business, not mine.
case "$MURMUR_KIND:$MURMUR_EVENT" in
  done:*'"driver":"orchestrated"'*) exit 0 ;;
esac

if [ "$(uname)" = Darwin ]; then
  case "$MURMUR_KIND" in
    done) sound=Bottle ;;
    blocked) sound=Glass ;;
    error) sound=Basso ;;
    *) sound=Submarine ;;
  esac
  exec afplay "/System/Library/Sounds/$sound.aiff"
fi

# Fedora: sound-theme-freedesktop, played through PipeWire.
case "$MURMUR_KIND" in
  done) sound=complete ;;
  blocked) sound=window-attention ;;
  error) sound=dialog-error ;;
  *) sound=suspend-error ;;
esac
exec pw-play "/usr/share/sounds/freedesktop/stereo/$sound.oga"
