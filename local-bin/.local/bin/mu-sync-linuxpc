#!/usr/bin/env python3
"""Sync mu segments with linuxpc over SSH.

mu never runs rsync itself; each machine writes only its own
`$MU_SYNC_DIR/<machine_id>.{jsonl,manifest}`, and any mover that copies
the folder both ways is enough (see mu's docs/guide/sync.md).
"""

import os
import subprocess
import sys
from pathlib import Path

host = "linuxpc"
local_dir = Path(os.environ.get("MU_SYNC_DIR", ""))
if not os.environ.get("MU_SYNC_DIR") or not local_dir.is_dir():
    sys.exit("MU_SYNC_DIR is unset or missing")

remote = f"{host}:mu/"
# -a for directory recursion; the previous file-list form did not need it.
rsync = ["rsync", "-a", "--checksum", "--compress"]
subprocess.run([*rsync, f"{local_dir}/", remote], check=True)
subprocess.run([*rsync, remote, f"{local_dir}/"], check=True)
subprocess.run(["mu", "sync"], check=True)
