#!/usr/bin/env python3
"""Sync mu segments with linuxpc over SSH."""

import json
import os
import shlex
import subprocess
import sys
from pathlib import Path

host = "linuxpc"
local_dir = Path(os.environ.get("MU_SYNC_DIR", ""))
if not os.environ.get("MU_SYNC_DIR") or not local_dir.is_dir():
    sys.exit("MU_SYNC_DIR is unset or missing")

query = ["mu", "sql", "--json", "select machine_id from machine_identity"]
local_id = json.loads(subprocess.check_output(query, text=True))[0]["machine_id"]
remote_id = json.loads(
    subprocess.check_output(["ssh", host, shlex.join(query)], text=True)
)[0]["machine_id"]

rsync = ["rsync", "--checksum", "--times", "--compress"]
subprocess.run(
    [
        *rsync,
        local_dir / f"{local_id}.jsonl",
        local_dir / f"{local_id}.manifest",
        f"{host}:mu/",
    ],
    check=True,
)
subprocess.run(
    [
        *rsync,
        f"{host}:mu/{remote_id}.jsonl",
        f"{host}:mu/{remote_id}.manifest",
        local_dir,
    ],
    check=True,
)
subprocess.run(["mu", "sync"], check=True)
