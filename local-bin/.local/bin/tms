#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
import tomllib
from collections.abc import Iterable
from dataclasses import dataclass
from functools import cache
from pathlib import Path
from shlex import quote as sh_quote

# `_tmux_common` is not a sibling any more: tms is shared by the tmux and
# herdr packages and so lives in local-bin, while that module stays with the
# tmux scripts it serves. Both packages are common scope, so the tmux package
# is always synced and this import always resolves -- no fallback stub, which
# would mean a second copy of AgentState.
# TMS_TMUX_SCRIPTS_DIR lets test-status-tools point at its own checkout.
_TMUX_SCRIPTS_DIR = Path(
    os.environ.get("TMS_TMUX_SCRIPTS_DIR")
    or Path.home() / ".config" / "tmux" / "scripts"
)
if str(_TMUX_SCRIPTS_DIR) not in sys.path:
    sys.path.append(str(_TMUX_SCRIPTS_DIR))

from _tmux_common import (  # noqa: E402
    STATE_GLYPH,
    AgentState,
    AgentStats,
    scan_agent_states,
    tmux_cmd,
)

DISPLAY_NAME_WIDTH = 20
DEFAULT_SPLIT = ""
# Stays at ~/.config/tmux/tms.toml even though tms itself now lives in
# local-bin: it is the user's session recipe file, moving it would break
# every existing checkout for no gain. TMS_CONFIG overrides it for tests.
CONFIG_PATH = Path(
    os.environ.get("TMS_CONFIG") or Path.home() / ".config" / "tmux" / "tms.toml"
)
STATE_DIR = (
    Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local" / "state") / "tms"
)
LAST_FILE = STATE_DIR / "last"

# Picker-row source icons. Unrelated to STATE_GLYPH (which lives in
# _tmux_common and is imported above); these mark where an entry came from.
KIND_ICON = {
    "default": "★",
    "tmux": "●",
    "zoxide": "◦",
    "find": "·",
}

# THEME BEGIN: tms-palette
CATPPUCCIN = {
    "red": "#f38ba8",
    "peach": "#fab387",
    "teal": "#94e2d5",
    "sky": "#89dceb",
    "sapphire": "#74c7ec",
    "lavender": "#b4befe",
    "text": "#cdd6f4",
    "subtext0": "#a6adc8",
    "overlay0": "#6c7086",
    "surface0": "#313244",
    "base": "#1e1e2e",
}
# THEME END: tms-palette

FZF_BORDER_LABEL = " sessions "


class ConfigError(ValueError):
    pass


@dataclass(frozen=True)
class SessionConfig:
    name: str
    path: str
    startup: str = ""
    split: str = DEFAULT_SPLIT


@dataclass(frozen=True)
class TmsConfig:
    sessions: tuple[SessionConfig, ...]
    blacklist: frozenset[str]
    noisy_basenames: frozenset[str]
    find_max_depth: int
    preview_command: str
    # When the picker is launched in `all` mode and the number of live tmux
    # sessions is >= this threshold, the initial view auto-switches to `tmux`
    # (live sessions only). 0 disables the auto-switch. The fzf reload binds
    # (^a/^c/^t/^x/^f) are unaffected; the user can still pull up the merged
    # view with ^a after the picker is open.
    live_session_threshold: int = 0
    # Pass `--exact` to fzf so query tokens match as literal substrings
    # instead of fzf's default scattered-character fuzzy. Prefix a token
    # with `'` to escape back to fuzzy for that token. Default true keeps
    # the strict behavior; flip to false in `tms.toml` for classic fuzzy.
    fzf_exact: bool = True


# Picker-row schema. The first field is the rendered (ANSI-styled) display
# text fzf shows; the rest are payload fields parsed back out of the
# selected row. Reordering or adding to this list updates both `to_fzf_row`
# and `from_fzf_row` at once, so the producer and consumer can never drift.
FZF_ROW_FIELDS: tuple[str, ...] = (
    "display",  # synthetic: rendered text from visible_text()
    "kind",
    "session_name",
    "path",
    "startup",
    "split",
)


@dataclass(frozen=True)
class Entry:
    kind: str
    name: str
    session_name: str
    path: str = ""
    startup: str = ""
    split: str = ""
    attention_count: int = 0
    worst_state: AgentState | None = None
    is_running: bool = False

    @property
    def icon(self) -> str:
        return KIND_ICON[self.kind]

    @property
    def display_name(self) -> str:
        return truncate(self.name, DISPLAY_NAME_WIDTH)

    @property
    def display_path(self) -> str:
        if not self.path:
            return ""
        home = str(Path.home())
        return self.path.replace(home, "~", 1)

    def visible_text(self) -> str:
        name = self.display_name.ljust(DISPLAY_NAME_WIDTH)
        if self.display_path:
            text = f"{self.icon}  {name}  {self.display_path}"
        else:
            text = f"{self.icon}  {name}"
        ws = self.worst_state
        glyph = (" " + STATE_GLYPH[ws]) if ws else ""
        if glyph:
            text = f"{text}{glyph}"
        if self.worst_state is AgentState.crashed:
            return ansi_style(
                text,
                fg=CATPPUCCIN["red"],
                bg=CATPPUCCIN["surface0"],
                bold=True,
            )
        if self.attention_count > 0:
            return ansi_style(
                text,
                fg=CATPPUCCIN["peach"],
                bg=CATPPUCCIN["surface0"],
                bold=True,
            )
        # Below crashed/attention on purpose: done is informational, and a
        # blocked or crashed agent in the same session must still win.
        if self.worst_state is AgentState.done:
            return ansi_style(
                text,
                fg=CATPPUCCIN["teal"],
                bg=CATPPUCCIN["surface0"],
            )
        style_map: dict[str, str] = {
            "default": CATPPUCCIN["lavender"],
            "tmux": CATPPUCCIN["sky"],
            "zoxide": CATPPUCCIN["sapphire"],
            "find": CATPPUCCIN["subtext0"],
        }
        style_kind = "tmux" if self.kind == "default" and self.is_running else self.kind
        fg = style_map.get(style_kind)
        if fg is None:
            return text
        return ansi_style(text, fg=fg)

    def to_fzf_row(self) -> str:
        values = {
            "display": self.visible_text(),
            "kind": self.kind,
            "session_name": self.session_name,
            "path": self.path,
            "startup": self.startup,
            "split": self.split,
        }
        return "\t".join(values[name] for name in FZF_ROW_FIELDS)

    @classmethod
    def from_fzf_row(cls, row: str) -> dict[str, str]:
        """Parse a tab-joined picker row back into a ``{field: value}`` dict.

        Returns a dict rather than an ``Entry`` because the rendered display
        text is one-way (ANSI styled) and downstream consumers only need the
        payload fields. Raises ``ConfigError`` on field-count mismatch so
        schema drift fails loudly in one place.
        """
        parts = row.split("\t")
        if len(parts) != len(FZF_ROW_FIELDS):
            raise ConfigError(
                f"Invalid picker row: expected {len(FZF_ROW_FIELDS)} "
                f"tab-separated fields, got {len(parts)}"
            )
        return dict(zip(FZF_ROW_FIELDS, parts, strict=True))


@dataclass(frozen=True)
class EntryPayload:
    """Typed view of the fields that survive an Entry's fzf round-trip.

    ``Entry`` carries display-only fields (icon, attention_count, is_running,
    rendered text) that aren't worth re-deriving on selection. Anything the
    ``connect_*`` path actually needs lives here, so consumers don't have
    to reach into the dict-shaped output of :meth:`Entry.from_fzf_row`.
    """

    session_name: str
    path: str | None = None
    startup: str | None = None
    split: str = DEFAULT_SPLIT

    @classmethod
    def from_fzf_row(cls, row: str) -> EntryPayload:
        fields = Entry.from_fzf_row(row)
        return cls(
            session_name=fields["session_name"],
            path=fields["path"] or None,
            startup=fields["startup"] or None,
            split=fields["split"] or DEFAULT_SPLIT,
        )


def truncate(text: str, width: int) -> str:
    if len(text) <= width:
        return text
    return text[: width - 1] + "…"


def ansi_style(
    text: str, *, fg: str | None = None, bg: str | None = None, bold: bool = False
) -> str:
    parts: list[str] = []
    if bold:
        parts.append("1")
    if fg:
        parts.append(f"38;2;{int(fg[1:3], 16)};{int(fg[3:5], 16)};{int(fg[5:7], 16)}")
    if bg:
        parts.append(f"48;2;{int(bg[1:3], 16)};{int(bg[3:5], 16)};{int(bg[5:7], 16)}")
    if not parts:
        return text
    return f"\x1b[{';'.join(parts)}m{text}\x1b[0m"


def run(
    cmd: list[str], *, check: bool = True, capture: bool = True
) -> subprocess.CompletedProcess[str]:
    return subprocess.run(cmd, check=check, text=True, capture_output=capture)


# `tmux_cmd` comes from `_tmux_common`; imported above so the
# socket-env honoring used by `test-status-tools` works here too.


def herdr_text(*args: str) -> str:
    """Run a herdr subcommand that answers with raw text rather than JSON.

    ``pane read`` is the exception to the JSON rule: it streams the pane's
    screen straight to stdout. Parsing it as JSON silently yields ``{}``,
    so it gets its own helper instead of a special case inside herdr_cmd.
    """
    result = run(["herdr", *args], check=False)
    return result.stdout if result.returncode == 0 else ""


def herdr_cmd(*args: str, check: bool = False) -> dict:
    """Run a herdr CLI subcommand and return its parsed ``result`` object.

    Every mutating herdr command answers with one JSON line shaped
    ``{"id": ..., "result": {...}}`` on stdout, or a JSON error on stderr
    with exit 1. We only ever want the result body, and a failed call is a
    normal outcome here (no server, closed workspace), so the default is
    check=False returning ``{}``.
    """
    result = run(["herdr", *args], check=check)
    if result.returncode != 0:
        return {}
    try:
        return json.loads(result.stdout).get("result", {})
    except (json.JSONDecodeError, AttributeError):
        return {}


def exact_session_target(name: str) -> str:
    return f"={name}"


def exact_pane_target(name: str, pane: str) -> str:
    return f"={name}:{pane}"


def expand(path: str) -> str:
    return str(Path(path).expanduser())


def prompt_for_mode(mode: str) -> str:
    # "all" is a synthetic mode that doesn't appear in KIND_ICON; the rest
    # share their glyph with the per-entry kind icon for visual consistency.
    glyph = ">" if mode == "all" else KIND_ICON[mode]
    return f"{glyph}  "


def header_text() -> str:
    items = [
        ("^a all", CATPPUCCIN["subtext0"]),
        ("^c pinned", CATPPUCCIN["lavender"]),
        ("^t live", CATPPUCCIN["sky"]),
        ("^x zoxide", CATPPUCCIN["sapphire"]),
        ("^f find", CATPPUCCIN["subtext0"]),
    ]
    return "  " + " ".join(ansi_style(label, fg=color) for label, color in items)


def sanitize_session_part(part: str) -> str:
    # tmux normalizes dots in session names to underscores, and dotted target
    # names are parsed as window/pane separators. Generate the normalized form
    # ourselves so create and attach paths agree.
    cleaned = re.sub(r"[^A-Za-z0-9_-]+", "-", part.replace(".", "_"))
    return re.sub(r"-+", "-", cleaned).strip("-")


def session_name_for_path(path: str) -> str:
    resolved = Path(path).expanduser().resolve()
    home = Path.home().resolve()
    try:
        parts = resolved.relative_to(home).parts
    except ValueError:
        parts = tuple(
            part for part in resolved.parts if part not in {resolved.anchor, "/"}
        )
    sanitized = [sanitize_session_part(part) for part in parts]
    sanitized = [part for part in sanitized if part]
    return "/".join(sanitized) or "session"


def display_name_for_path(path: str) -> str:
    return Path(path).expanduser().name or session_name_for_path(path)


def list_tmux_sessions() -> list[str]:
    return backend().list_sessions()


def zoxide_paths() -> list[str]:
    result = run(["zoxide", "query", "--list"], check=False)
    if result.returncode != 0:
        return []
    return [line.strip() for line in result.stdout.splitlines() if line.strip()]


def find_paths(config: TmsConfig) -> list[str]:
    home = str(Path.home())
    cmd = ["fd", "-H", "-d", str(config.find_max_depth), "-t", "d"]
    for name in sorted(config.blacklist):
        cmd.extend(["-E", name])
    cmd.extend([".", home])
    result = run(cmd, check=False)
    if result.returncode != 0:
        return []
    return [line.strip() for line in result.stdout.splitlines() if line.strip()]


def is_useful_path(path: str, *, mode: str, config: TmsConfig) -> bool:
    p = Path(path).expanduser()
    parts = p.parts
    basename = p.name

    if basename.startswith(".") and basename not in {".dotfiles"}:
        return False
    # `parts` includes the basename, so a single pass against the union of
    # both deny-lists subsumes the per-basename and per-segment checks the
    # earlier version did separately.
    blocked = config.blacklist | config.noisy_basenames
    if any(part in blocked for part in parts):
        return False

    # Both sides must be resolved: on distros where /home symlinks to
    # /var/home, comparing a resolved path against a bare Path.home() makes
    # relative_to() raise for *every* path under $HOME, silently disabling
    # the dotdir / dotfiles / zoxide-depth filters below.
    home = Path.home().resolve()
    try:
        rel = p.resolve().relative_to(home)
        rel_parts = rel.parts
        if rel_parts and rel_parts[0] == "dotfiles" and len(rel_parts) > 1:
            return False
        if any(part.startswith(".") for part in rel_parts):
            return False
        if mode == "zoxide" and len(rel_parts) > 2:
            return False
    except OSError:
        # resolve() touches the filesystem: unreadable parent, deleted cwd
        # while resolving a relative path, ELOOP on platforms that still
        # report it. Treat an unresolvable path as "no extra filtering".
        pass
    except ValueError:
        # relative_to() when the resolved path is outside $HOME.
        pass

    return True


def require_str_list(value: object, key: str) -> list[str]:
    if not isinstance(value, list) or not all(isinstance(item, str) for item in value):
        raise ConfigError(f"{CONFIG_PATH}: {key} must be an array of strings")
    return [item for item in value if isinstance(item, str)]


@cache
def load_config() -> TmsConfig:
    if not CONFIG_PATH.exists():
        raise ConfigError(f"Missing config: {CONFIG_PATH}")
    try:
        with CONFIG_PATH.open("rb") as handle:
            data = tomllib.load(handle)
    except OSError as exc:
        raise ConfigError(f"Failed to read config: {CONFIG_PATH}: {exc}") from exc
    except tomllib.TOMLDecodeError as exc:
        raise ConfigError(f"Invalid TOML in {CONFIG_PATH}: {exc}") from exc

    required = ("find_max_depth", "preview_command")
    missing = [key for key in required if key not in data]
    if missing:
        raise ConfigError(
            f"Missing required keys in {CONFIG_PATH}: {', '.join(missing)}"
        )

    blacklist = require_str_list(data.get("blacklist", []), "blacklist")
    noisy_basenames = require_str_list(
        data.get("noisy_basenames", []), "noisy_basenames"
    )
    find_max_depth = data["find_max_depth"]
    preview_command = data["preview_command"]
    sessions = data.get("sessions", [])
    live_session_threshold = data.get("live_session_threshold", 0)
    fzf_exact = data.get("fzf_exact", True)
    if not isinstance(find_max_depth, int) or find_max_depth < 0:
        raise ConfigError(
            f"{CONFIG_PATH}: find_max_depth must be a non-negative integer"
        )
    if not isinstance(preview_command, str) or not preview_command:
        raise ConfigError(f"{CONFIG_PATH}: preview_command must be a non-empty string")
    if not isinstance(sessions, list):
        raise ConfigError(f"{CONFIG_PATH}: sessions must be an array")
    if (
        not isinstance(live_session_threshold, int)
        or isinstance(live_session_threshold, bool)
        or live_session_threshold < 0
    ):
        raise ConfigError(
            f"{CONFIG_PATH}: live_session_threshold must be a non-negative integer"
        )
    if not isinstance(fzf_exact, bool):
        raise ConfigError(f"{CONFIG_PATH}: fzf_exact must be a boolean")

    out: list[SessionConfig] = []
    for session in sessions:
        if not isinstance(session, dict):
            raise ConfigError(f"{CONFIG_PATH}: each session must be an object")
        name = session.get("name")
        path = session.get("path")
        if not isinstance(name, str) or not name:
            raise ConfigError(f"{CONFIG_PATH}: session.name must be a non-empty string")
        if not isinstance(path, str) or not path:
            raise ConfigError(f"{CONFIG_PATH}: session.path must be a non-empty string")
        startup = session.get("startup", "")
        if not isinstance(startup, str):
            raise ConfigError(f"{CONFIG_PATH}: session.startup must be a string")
        split = session.get("split", DEFAULT_SPLIT)
        if split not in {DEFAULT_SPLIT, "vertical", "horizontal"}:
            raise ConfigError(
                f"{CONFIG_PATH}: session.split must be '', 'vertical', or 'horizontal'"
            )
        out.append(SessionConfig(name=name, path=path, startup=startup, split=split))

    return TmsConfig(
        sessions=tuple(out),
        blacklist=frozenset(blacklist),
        noisy_basenames=frozenset(noisy_basenames),
        find_max_depth=find_max_depth,
        preview_command=preview_command,
        live_session_threshold=live_session_threshold,
        fzf_exact=fzf_exact,
    )


def effective_initial_mode(mode: str) -> str:
    """Resolve the picker's *opening* mode, applying the live-session threshold.

    Only `all` (the default landing view) is eligible for auto-switching; if
    the caller explicitly asked for a specific mode we honor it. The threshold
    is read from config and 0 disables the behavior. fzf's reload binds use
    the original mode strings, so `^a` still pulls up the merged view.
    """
    if mode != "all":
        return mode
    threshold = load_config().live_session_threshold
    if threshold <= 0:
        return mode
    if len(list_tmux_sessions()) >= threshold:
        return "tmux"
    return mode


def build_path_entries(
    *,
    kind: str,
    paths: list[str],
    configured_paths: set[str],
    mode: str,
    config: TmsConfig,
) -> list[Entry]:
    seen_paths: set[str] = set()
    entries: list[Entry] = []
    for path in paths:
        full = expand(path)
        if (
            full in configured_paths
            or full in seen_paths
            or not is_useful_path(full, mode=mode, config=config)
        ):
            continue
        seen_paths.add(full)
        entries.append(
            Entry(
                kind=kind,
                name=display_name_for_path(full),
                session_name=session_name_for_path(full),
                path=full,
            )
        )
    return entries


def build_entries(mode: str) -> list[Entry]:
    config = load_config()
    configured_sessions = config.sessions
    sessions_by_name = {session.name: session for session in configured_sessions}
    configured_paths = {expand(session.path) for session in configured_sessions}
    live_names = set(list_tmux_sessions())
    # Agent glyphs come from tmux window options (@agent_state), so they only
    # describe tmux sessions. Under the herdr backend the rows are workspaces
    # and a tmux scan would staple one multiplexer's agent states onto the
    # other's rows -- herdr's own sidebar owns that signal there.
    stats_by_session: dict[str, AgentStats] = {}
    if backend().has_agent_state:
        stats_by_session = scan_agent_states().per_session()

    entries: list[Entry] = []

    if mode in {"all", "default"}:
        entries.extend(
            Entry(
                kind="default",
                name=session.name,
                session_name=session.name,
                path=expand(session.path),
                startup=session.startup,
                split=session.split,
                attention_count=stats_by_session.get(
                    session.name, AgentStats()
                ).attention_count,
                worst_state=stats_by_session.get(
                    session.name, AgentStats()
                ).worst_state,
                is_running=session.name in live_names,
            )
            for session in configured_sessions
        )

    if mode in {"all", "tmux"}:
        configured_names = {session.name for session in configured_sessions}
        for session_name in sorted(live_names):
            if mode == "all" and session_name in configured_names:
                continue
            session = sessions_by_name.get(session_name)
            entries.append(
                Entry(
                    kind="tmux",
                    name=session_name,
                    session_name=session_name,
                    path=expand(session.path) if session else "",
                    startup=session.startup if session else "",
                    split=session.split if session else DEFAULT_SPLIT,
                    attention_count=stats_by_session.get(
                        session_name, AgentStats()
                    ).attention_count,
                    worst_state=stats_by_session.get(
                        session_name, AgentStats()
                    ).worst_state,
                    is_running=True,
                )
            )

    if mode in {"all", "zoxide"}:
        entries.extend(
            build_path_entries(
                kind="zoxide",
                paths=zoxide_paths(),
                configured_paths=configured_paths,
                mode="zoxide",
                config=config,
            )
        )

    if mode == "find":
        entries.extend(
            build_path_entries(
                kind="find",
                paths=find_paths(config),
                configured_paths=configured_paths,
                mode="find",
                config=config,
            )
        )

    return entries


def tmux_session_preview(name: str) -> int:
    session = tmux_cmd(
        "display-message",
        "-p",
        "-t",
        exact_session_target(name),
        "#{session_name}\t#{session_attached}",
        check=False,
    )
    if session.returncode != 0:
        return 1

    windows = tmux_cmd(
        "list-windows",
        "-t",
        exact_session_target(name),
        "-F",
        "#{window_index}\t#{window_active}\t#{window_name}\t#{window_panes}\t#{@agent_state}",
        check=False,
    )
    panes = tmux_cmd(
        "list-panes",
        "-t",
        exact_session_target(name),
        "-F",
        "#{window_index}\t#{pane_index}\t#{pane_active}\t#{window_active}\t#{pane_current_command}\t#{pane_current_path}",
        check=False,
    )
    if windows.returncode != 0 or panes.returncode != 0:
        print(session.stdout.strip())
        return 0

    session_name, _, attached = session.stdout.strip().partition("\t")
    attention_total = 0
    active_window_index = ""
    active_window_name = ""
    active_window_state = ""
    for line in windows.stdout.splitlines():
        parts = line.split("\t")
        if len(parts) != 5:
            continue
        window_index, window_active, window_name, _window_panes, window_state = parts
        if window_state in ("blocked", "crashed"):
            attention_total += 1
        if window_active == "1":
            active_window_index = window_index
            active_window_name = window_name
            active_window_state = window_state

    active_pane_index = ""
    active_command = ""
    active_path = ""
    for line in panes.stdout.splitlines():
        parts = line.split("\t")
        if len(parts) != 6:
            continue
        window_index, pane_index, pane_active, window_active, command, pane_path = parts
        if window_active == "1" and pane_active == "1":
            active_pane_index = pane_index
            active_command = command
            active_path = pane_path
            if not active_window_index:
                active_window_index = window_index
            break

    meta: list[str] = []
    if attached:
        meta.append(f"attached {attached}")
    if attention_total:
        meta.append(f"attention {attention_total}")
    suffix = f" ({', '.join(meta)})" if meta else ""
    print(f"{session_name}{suffix}")

    if active_window_index:
        _ws = AgentState.parse(active_window_state)
        state_marker = (" " + STATE_GLYPH[_ws]) if _ws else ""
        print(f"window: {active_window_index}{state_marker} {active_window_name}")
    if active_pane_index:
        short_path = active_path.replace(str(Path.home()), "~", 1)
        print(f"pane: {active_pane_index}  {active_command}  {short_path}")
    print()

    target = (
        exact_pane_target(name, f"{active_window_index}.{active_pane_index}")
        if active_window_index and active_pane_index
        else exact_pane_target(name, "1.1")
    )
    capture = tmux_cmd(
        "capture-pane", "-p", "-J", "-t", target, "-S", "-200", check=False
    )
    if capture.returncode != 0:
        print("(unable to capture active pane)")
        return 0
    print(capture.stdout.rstrip())
    return 0


def tildify(path: str) -> str:
    """Render a path with $HOME as ``~``.

    Not ``str.replace``: on this distro $HOME resolves under /var/home while
    panes report /var/home/... directly, so a substring swap produces
    ``/var~/hacking/mu``. Compare resolved paths instead.
    """
    if not path:
        return ""
    home = Path.home().resolve()
    try:
        return str(Path("~") / Path(path).resolve().relative_to(home))
    except ValueError:
        return path


def herdr_workspace_preview(name: str) -> int:
    """Preview a live herdr workspace: header, then the active pane's screen."""
    b = backend()
    workspace_id = b._id_for(name) if isinstance(b, HerdrBackend) else ""
    if not workspace_id:
        return 1
    info = herdr_cmd("workspace", "get", workspace_id).get("workspace", {})
    tabs = info.get("tab_count", 0)
    panes = info.get("pane_count", 0)
    status = info.get("agent_status", "")
    meta = [
        f"{tabs} tab{'s' if tabs != 1 else ''}",
        f"{panes} pane{'s' if panes != 1 else ''}",
    ]
    if status and status != "unknown":
        meta.append(status)
    print(f"{name} ({', '.join(meta)})")

    active_tab = info.get("active_tab_id", "")
    pane_list = herdr_cmd("pane", "list", "--workspace", workspace_id).get("panes", [])
    active = next(
        (p for p in pane_list if p.get("focused")),
        next((p for p in pane_list if p.get("tab_id") == active_tab), None),
    )
    if not active:
        return 0
    print(f"pane: {active.get('pane_id', '')}  {tildify(active.get('cwd') or '')}")
    print()
    # Text, not ansi: the preview is rendered inside fzf's preview window,
    # which owns the colors here. `pane read` streams raw text, not JSON.
    text = herdr_text(
        "pane",
        "read",
        active.get("pane_id", ""),
        "--source",
        "recent-unwrapped",
        "--lines",
        "200",
    )
    print(text.rstrip() if text.strip() else "(unable to read active pane)")
    return 0


def preview(path: str, session_name: str = "", kind: str = "", split: str = "") -> int:
    if (
        kind in {"tmux", "default"}
        and session_name
        and tmux_session_exists(session_name)
    ):
        if isinstance(backend(), HerdrBackend):
            return herdr_workspace_preview(session_name)
        return tmux_session_preview(session_name)

    target = expand(path)
    if not target:
        if split and kind == "default":
            print(f"session: {session_name or '(unknown)'}\nsplit: {split}", end="")
        else:
            print(f"session: {session_name or '(unknown)'}", end="")
        return 0
    if split:
        print(f"split: {split}\n")
    os.execvp(
        "sh", ["sh", "-lc", load_config().preview_command.format(path=sh_quote(target))]
    )
    return 0


def reload_cmd(mode: str) -> str:
    return f"{sh_quote(sys.argv[0])} list --mode {mode}"


def print_entries(mode: str) -> int:
    for entry in build_entries(mode):
        print(entry.to_fzf_row())
    return 0


def _fzf_command(mode: str, query: str = "") -> list[str]:
    cmd = [
        "fzf",
        "--layout=reverse",
        "--border=rounded",
        "--ansi",
        # Match only the visible display column (field 1), not the payload
        # fields tacked on for the consumer (kind/session/path/startup/split).
        # Otherwise typing `dotfiles` would also match every row whose path
        # happens to contain the word.
        "--nth",
        "1",
        # `begin` ranks earlier match positions higher: query `notes` puts
        # `notes` (pos 0) above `my-notes` (pos 3). `index` is the empty-query
        # fallback: with no scoring signal it preserves the input grouping
        # (pinned -> live -> zoxide -> find) we hand to fzf.
        "--tiebreak",
        "begin,index",
        "--color",
        f"bg:{CATPPUCCIN['base']},bg+:{CATPPUCCIN['surface0']},fg:{CATPPUCCIN['text']},fg+:{CATPPUCCIN['text']},hl:{CATPPUCCIN['sky']},hl+:{CATPPUCCIN['sky']},border:{CATPPUCCIN['overlay0']},gutter:{CATPPUCCIN['base']},header:{CATPPUCCIN['subtext0']},info:{CATPPUCCIN['overlay0']},prompt:{CATPPUCCIN['lavender']},pointer:{CATPPUCCIN['peach']},marker:{CATPPUCCIN['peach']},spinner:{CATPPUCCIN['sky']},label:{CATPPUCCIN['subtext0']},query:{CATPPUCCIN['text']},preview-bg:{CATPPUCCIN['base']},preview-border:{CATPPUCCIN['overlay0']}",
        "--delimiter",
        "\t",
        "--with-nth",
        "1",
        "--border-label",
        FZF_BORDER_LABEL,
        "--prompt",
        prompt_for_mode(mode),
        "--header",
        header_text(),
        "--bind",
        "tab:down,btab:up",
        "--bind",
        f"ctrl-a:change-prompt({prompt_for_mode('all')})+reload({reload_cmd('all')})",
        "--bind",
        f"ctrl-c:change-prompt({prompt_for_mode('default')})+reload({reload_cmd('default')})",
        "--bind",
        f"ctrl-t:change-prompt({prompt_for_mode('tmux')})+reload({reload_cmd('tmux')})",
        "--bind",
        f"ctrl-x:change-prompt({prompt_for_mode('zoxide')})+reload({reload_cmd('zoxide')})",
        "--bind",
        f"ctrl-f:change-prompt({prompt_for_mode('find')})+reload({reload_cmd('find')})",
        "--preview-window",
        "right:55%,border-left",
        "--preview",
        f"{sh_quote(sys.argv[0])} preview --kind {{2}} --session-name {{3}} --path {{4}} --split {{6}}",
    ]
    if load_config().fzf_exact:
        # Substring (literal) matching only. Prefix a token with `'` to opt
        # back into fuzzy for that token. Inserted right after the base flags
        # so the rest of the command (binds, preview) is unaffected by the
        # config toggle.
        cmd.insert(4, "--exact")
    if query:
        cmd.extend(["--query", query])
    return cmd


def fzf(mode: str = "all", query: str = "") -> int:
    mode = effective_initial_mode(mode)
    entries = "\n".join(entry.to_fzf_row() for entry in build_entries(mode))
    proc = subprocess.run(_fzf_command(mode, query=query), input=entries, text=True)
    return proc.returncode


def pick_and_connect(mode: str = "all", query: str = "") -> int:
    """Run the fzf picker and connect to the selection in one step.

    fzf writes its UI to /dev/tty when stdout is captured, so the picker
    still renders interactively while we keep the selection in-process.
    """
    mode = effective_initial_mode(mode)
    entries = "\n".join(entry.to_fzf_row() for entry in build_entries(mode))
    proc = subprocess.run(
        _fzf_command(mode, query=query), input=entries, text=True, capture_output=True
    )
    if proc.returncode != 0:
        return proc.returncode
    # Strip only the trailing newline fzf appends, not surrounding whitespace.
    # Picker rows can end in empty tab-separated fields (e.g. blank `startup`
    # and `split`); using bare `.strip()` would eat those trailing `\t`s and
    # leave the row short of `len(FZF_ROW_FIELDS)`.
    choice = proc.stdout.rstrip("\n")
    if not choice:
        return 1
    payload = EntryPayload.from_fzf_row(choice)
    return connect_resolved(
        payload.session_name, payload.path, payload.startup, payload.split
    )


def update_last(name: str) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    LAST_FILE.write_text(name + "\n")


class TmuxBackend:
    """tmux sessions. The original tms behavior, unchanged."""

    name = "tmux"
    # Picker rows can carry agent glyphs: they come from this backend's own
    # @agent_state window options, so they describe exactly these rows.
    has_agent_state = True

    def list_sessions(self) -> list[str]:
        result = tmux_cmd("list-sessions", "-F", "#{session_name}", check=False)
        if result.returncode != 0:
            return []
        return [line.strip() for line in result.stdout.splitlines() if line.strip()]

    def exists(self, name: str) -> bool:
        return (
            tmux_cmd(
                "has-session",
                "-t",
                exact_session_target(name),
                check=False,
                capture=True,
            ).returncode
            == 0
        )

    def switch(self, name: str) -> None:
        if os.environ.get("TMUX"):
            tmux_cmd("switch-client", "-t", exact_session_target(name), capture=False)
        else:
            subprocess.run(
                ["tmux", "attach-session", "-t", exact_session_target(name)],
                check=True,
            )
        update_last(name)

    def create(
        self, name: str, path: str, startup: str | None, split: str = ""
    ) -> None:
        tmux_cmd("new-session", "-d", "-s", name, "-c", path, capture=False)
        if startup:
            tmux_cmd(
                "send-keys",
                "-t",
                exact_pane_target(name, "1.1"),
                startup,
                "C-m",
                capture=False,
            )
        if split in ("vertical", "horizontal"):
            tmux_cmd(
                "split-window",
                "-h" if split == "vertical" else "-v",
                "-t",
                exact_pane_target(name, "1.1"),
                "-c",
                path,
                capture=False,
            )

    def last_candidates(self) -> list[str]:
        result = tmux_cmd(
            "display-message", "-p", "#{client_last_session}", check=False
        )
        if result.returncode != 0:
            return []
        name = result.stdout.strip()
        return [name] if name else []

    def current_cwd(self, ref: str) -> str:
        return pane_cwd(ref)


class HerdrBackend:
    """herdr workspaces, mapped onto the same session vocabulary.

    A tms "session" is a herdr *workspace*: it is the unit that owns a cwd
    and a set of tabs/panes, which is what a tmux session is. Workspace
    labels are not required to be unique, so we address by workspace_id
    internally and match on label at the edges, first match wins.

    Split naming is deliberately translated, not passed through: tms's
    `vertical` means "a vertical divider" (new pane to the right, tmux
    `split-window -h`), which is herdr's `--direction right`. herdr's own
    `split_vertical` keybinding uses the same convention.
    """

    name = "herdr"
    # No agent glyphs on herdr rows: the only source tms has is tmux's
    # @agent_state, which says nothing about a herdr workspace. herdr's
    # sidebar owns that signal here.
    has_agent_state = False

    def _workspaces(self) -> list[dict]:
        return herdr_cmd("workspace", "list").get("workspaces", [])

    def _id_for(self, name: str) -> str:
        for ws in self._workspaces():
            if ws.get("label") == name:
                return ws.get("workspace_id", "")
        return ""

    def list_sessions(self) -> list[str]:
        return [ws.get("label", "") for ws in self._workspaces() if ws.get("label")]

    def exists(self, name: str) -> bool:
        return bool(self._id_for(name))

    def switch(self, name: str) -> None:
        workspace_id = self._id_for(name)
        if workspace_id:
            herdr_cmd("workspace", "focus", workspace_id)
            update_last(name)

    def create(
        self, name: str, path: str, startup: str | None, split: str = ""
    ) -> None:
        created = herdr_cmd(
            "workspace", "create", "--cwd", path, "--label", name, "--no-focus"
        )
        root_pane = created.get("root_pane", {}).get("pane_id", "")
        if not root_pane:
            return
        if startup:
            herdr_cmd("pane", "run", root_pane, startup)
        if split in ("vertical", "horizontal"):
            herdr_cmd(
                "pane",
                "split",
                root_pane,
                "--direction",
                "right" if split == "vertical" else "down",
                "--cwd",
                path,
                "--no-focus",
            )

    def last_candidates(self) -> list[str]:
        # herdr exposes no "previously focused workspace" pointer, so the
        # LAST_FILE written by switch() is the only source. connect_resolved
        # appends it; nothing to add here.
        return []

    def current_cwd(self, ref: str) -> str:
        pane = herdr_cmd("pane", "get", ref) if ref else herdr_cmd("pane", "current")
        info = pane.get("pane", {})
        return info.get("foreground_cwd") or info.get("cwd") or ""


@cache
def backend() -> TmuxBackend | HerdrBackend:
    """Pick a backend from the environment.

    $TMUX is checked first: inside a tmux pane the user means tmux, even if
    that tmux happens to be running inside a herdr pane (which would also
    export HERDR_ENV). The override exists for the picker's preview
    subprocess and for tests.
    """
    forced = os.environ.get("TMS_BACKEND", "")
    if forced == "herdr":
        return HerdrBackend()
    if forced == "tmux":
        return TmuxBackend()
    if os.environ.get("TMUX"):
        return TmuxBackend()
    if os.environ.get("HERDR_ENV") == "1":
        return HerdrBackend()
    return TmuxBackend()


def tmux_session_exists(name: str) -> bool:
    return backend().exists(name)


def switch_or_attach(name: str) -> None:
    backend().switch(name)


def create_session(name: str, path: str, startup: str | None, split: str = "") -> None:
    backend().create(name, path, startup, split)


def connect_resolved(
    session_name: str,
    path: str | None,
    startup: str | None,
    split: str = DEFAULT_SPLIT,
) -> int:
    if tmux_session_exists(session_name):
        switch_or_attach(session_name)
        return 0

    if path is None:
        print(f"No such session or path: {session_name}", file=sys.stderr)
        return 1

    create_session(session_name, path, startup, split)
    switch_or_attach(session_name)
    return 0


def pane_cwd(pane_id: str) -> str:
    """Read a pane's cwd from tmux instead of taking it on a command line.

    SECURITY: the key binding that reaches here runs under ``run-shell``,
    which format-expands its argument and hands the result to ``sh -c``.
    Interpolating ``#{pane_current_path}`` there is command injection --
    a directory whose name contains a newline splits the shell line and
    the second line runs as a command. ``#{pane_id}`` is minted by tmux
    (``%[0-9]+``) and is the only value safe to interpolate, so the
    binding passes that and we fetch the path over a pipe.
    """
    result = tmux_cmd(
        "display-message", "-p", "-t", pane_id, "#{pane_current_path}", check=False
    )
    if result.returncode != 0:
        return ""
    return result.stdout.removesuffix("\n")


def connect(target: str) -> int:
    target = expand(target)
    sessions_by_name = {session.name: session for session in load_config().sessions}
    session = sessions_by_name.get(target)
    if session:
        return connect_resolved(
            session.name,
            expand(session.path),
            session.startup,
            session.split,
        )
    # If `target` already names a live tmux session, attach to it directly.
    # Without this, a bare session name that also happens to be a directory
    # in the current pane's CWD (e.g. `foot` while sitting in
    # ~/dotfiles, where stow packages mirror live session names) gets mangled
    # into `dotfiles/foot` by session_name_for_path below, and a new
    # session is spawned instead of switching to the running one.
    if tmux_session_exists(target):
        return connect_resolved(target, None, None, DEFAULT_SPLIT)
    # Either a real path (create/attach a session rooted there) or a bare
    # session name (attach if it exists, error otherwise — connect_resolved
    # handles both via its `path is None` branch).
    path = target if Path(target).exists() else None
    name = session_name_for_path(target) if path else target
    return connect_resolved(name, path, None, DEFAULT_SPLIT)


def last() -> int:
    # `tms last` is typically bound to a hotkey (prefix-L). When the
    # last-known session has been killed, the right behavior is a silent
    # no-op — not respawning a configured session from scratch (which is
    # what `connect()` would do for a configured name) and not erroring
    # with "No such session or path" for an unconfigured one.
    #
    # We collect both pointers (the backend's own notion of "last", then our
    # LAST_FILE) and switch to the first that's still live. If none are,
    # exit 0 without output.
    candidates: list[str] = list(backend().last_candidates())
    if LAST_FILE.exists():
        name = LAST_FILE.read_text().strip()
        if name and name not in candidates:
            candidates.append(name)
    for name in candidates:
        if tmux_session_exists(name):
            switch_or_attach(name)
            return 0
    return 0


def main(argv: Iterable[str] | None = None) -> int:
    try:
        parser = argparse.ArgumentParser()
        sub = parser.add_subparsers(dest="cmd", required=True)

        p_list = sub.add_parser("list")
        p_list.add_argument(
            "--mode",
            choices=["all", "default", "tmux", "zoxide", "find"],
            default="all",
        )

        p_pick = sub.add_parser("picker")
        p_pick.add_argument(
            "--mode",
            choices=["all", "default", "tmux", "zoxide", "find"],
            default="all",
        )
        p_pick.add_argument("--query", default="")

        p_pick_connect = sub.add_parser("pick-and-connect")
        p_pick_connect.add_argument(
            "--mode",
            choices=["all", "default", "tmux", "zoxide", "find"],
            default="all",
        )
        p_pick_connect.add_argument("--query", default="")

        p_connect = sub.add_parser("connect")
        p_connect.add_argument("target", nargs="?", default="")
        p_connect.add_argument(
            "--pane",
            default="",
            help="resolve the target from this pane's cwd (see pane_cwd)",
        )

        p_preview = sub.add_parser("preview")
        p_preview.add_argument("--kind", default="")
        p_preview.add_argument("--session-name", default="")
        p_preview.add_argument("--path", default="")
        p_preview.add_argument("--split", default=DEFAULT_SPLIT)

        sub.add_parser("last")

        args = parser.parse_args(list(argv) if argv is not None else None)

        if args.cmd == "list":
            return print_entries(args.mode)
        if args.cmd == "picker":
            return fzf(args.mode, query=args.query)
        if args.cmd == "pick-and-connect":
            return pick_and_connect(args.mode, query=args.query)
        if args.cmd == "connect":
            target = backend().current_cwd(args.pane) if args.pane else args.target
            if not target:
                print("connect: no target", file=sys.stderr)
                return 1
            return connect(target)
        if args.cmd == "preview":
            return preview(args.path, args.session_name, args.kind, args.split)
        if args.cmd == "last":
            return last()
        return 1
    except ConfigError as exc:
        print(exc, file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
