    colors {
        state "input" inside="{{mocha.crust}}70" ring="{{mocha.lavender}}ff" line="#00000000" text="{{mocha.text}}ff"
        state "clear" inside="{{mocha.crust}}70" ring="{{mocha.yellow}}ff" line="#00000000" text="{{mocha.text}}ff"
        state "verifying" inside="{{mocha.crust}}70" ring="{{mocha.sapphire}}ff" line="#00000000" text="{{mocha.text}}ff"
        state "wrong" inside="{{mocha.crust}}70" ring="{{mocha.red}}ff" line="#00000000" text="{{mocha.text}}ff"
        state "caps-lock" inside="{{mocha.crust}}70" ring="{{mocha.peach}}ff" line="#00000000" text="{{mocha.peach}}ff"
        key-highlight "{{mocha.green}}ff"
        bs-highlight "{{mocha.red}}ff"
        separator "#00000000"
    }
